  total = total + ect_p03.show(T(v: seed))
  total = total + ect_p04.f12(seed, 5)
  total = total + ect_p04.show(T(v: seed))
  total = total + ect_p05.f15(seed, 6)
  total = total + ect_p05.show(T(v: seed))
  total = total + ect_p06.f18(seed, 7)
  total = total + ect_p06.show(T(v: seed))
  total = total + ect_p07.f21(seed, 8)
  total = total + ect_p07.show(T(v: seed))
  total = total + ect_p08.f24(seed, 9)
  total = total + ect_p08.show(T(v: seed))
  total = total + ect_p09.f27(seed, 10)
  total = total + ect_p09.show(T(v: seed))
  total = total + ect_p10.f30(seed, 11)
  total = total + ect_p10.show(T(v: seed))
