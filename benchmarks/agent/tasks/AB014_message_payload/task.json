{
  "schema_version": 1,
  "id": "AB014",
  "name": "message-payload",
  "category": "ownership-effects",
  "task_type": "write",
  "prompt": "Create a Payload record and Worker domain. Send a Payload with value 41 to a read-only handler that replies with its value, then mutate the caller's original payload to 42 and print both values.",
  "starter": "starter",
  "expected": "expected",
  "starter_files": [],
  "allowed_paths": [
    "main.moss"
  ],
  "success_criteria": [
    "The message payload is read-only in the handler.",
    "The original remains available after the synchronous value boundary.",
    "The program prints 41 42."
  ],
  "validation": [
    {
      "command": [
        "$MOSS",
        "check",
        "main.moss",
        "--json"
      ],
      "expect": {
        "json_equals": {
          "ok": true
        }
      }
    },
    {
      "command": [
        "$MOSS",
        "run",
        "--interp",
        "main.moss"
      ],
      "expect": {
        "stdout": "41 42\n"
      }
    }
  ],
  "assertions": [
    {
      "path": "main.moss",
      "matches": "(?m)^type\\s+Payload\\s*:"
    },
    {
      "path": "main.moss",
      "matches": "(?m)^domain\\s+Worker\\s*:"
    },
    {
      "path": "main.moss",
      "matches": "(?m)^\\s+fn\\s+\\w+\\s*\\([^\\n]*:\\s*Payload"
    },
    {
      "path": "main.moss",
      "matches": "\\bmessage\\s+\\w+\\.\\w+\\s*\\([^)]*\\)"
    },
    {
      "path": "main.moss",
      "matches": "(?m)^\\s+\\w+\\.value\\s*=\\s*42\\s*$"
    }
  ],
  "notes": "Exercises message payload snapshot/value semantics and post-message caller use."
}
