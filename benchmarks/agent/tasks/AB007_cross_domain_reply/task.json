{
  "schema_version": 1,
  "id": "AB007",
  "name": "cross-domain-reply",
  "category": "domains-messages",
  "task_type": "write",
  "prompt": "Create a Source domain whose Read handler replies 21 and a Doubler domain routed to Source whose Run handler messages Source and replies with twice the result. Compose both in main and print 42.",
  "starter": "starter",
  "expected": "expected",
  "starter_files": [],
  "allowed_paths": [
    "main.moss"
  ],
  "success_criteria": [
    "The route is declared and bound statically.",
    "The cross-domain reply is used to print 42."
  ],
  "validation": [
    {
      "command": [
        "$MOSS",
        "check",
        "main.moss",
        "--json"
      ],
      "expect": {
        "json_equals": {
          "ok": true
        }
      }
    },
    {
      "command": [
        "$MOSS",
        "run",
        "--interp",
        "main.moss"
      ],
      "expect": {
        "stdout": "42\n"
      }
    }
  ],
  "assertions": [
    {
      "path": "main.moss",
      "matches": "(?m)^domain\\s+Source\\s*:"
    },
    {
      "path": "main.moss",
      "matches": "(?m)^domain\\s+Doubler\\s*:"
    },
    {
      "path": "main.moss",
      "matches": "(?s)domainroutes\\s*\\([^)]*\\bsource\\s*:\\s*Source"
    },
    {
      "path": "main.moss",
      "matches": "\\bmessage\\s+\\w+\\.Read\\s*\\("
    },
    {
      "path": "main.moss",
      "matches": "\\bmessage\\s+\\w+\\.Run\\s*\\("
    }
  ],
  "notes": "Exercises a value-returning cross-domain message through domainroutes."
}
