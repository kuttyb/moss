{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moss.invalid/schemas/phase22-3-ab-task-1.json",
  "title": "Phase 22.3 semantic-query A/B task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "category", "prompt", "starter",
    "expected", "starter_files", "allowed_paths", "validation",
    "semantic_heavy", "relevant_capability", "requested_facts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^P223[0-9]{3}$"},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "category": {"enum": ["resolution", "type-ownership", "effects-calls", "domain-synchronization", "control"]},
    "prompt": {"type": "string", "minLength": 1},
    "starter": {"const": "starter"},
    "expected": {"const": "expected"},
    "starter_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "validation": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["command"],
        "properties": {
          "command": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "expect": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "exit_code": {"type": "integer"},
              "stdout": {"type": "string"},
              "stdout_contains": {"type": "string"},
              "stderr_contains": {"type": "string"}
            }
          }
        }
      }
    },
    "semantic_heavy": {"type": "boolean"},
    "relevant_capability": {"type": "string", "minLength": 1},
    "requested_facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "string"}
  }
}
