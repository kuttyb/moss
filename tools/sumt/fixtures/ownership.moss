enum Outcome:
  Ready
  Number(value: Int)

type Bag:
  items: Vector[Int]

type Point:
  v: Int

  fn score() -> Int:
    return v

type Gauge:
  v: Float

  fn score() -> Float:
    return v

fn fwd_caller(x):
  return fwd_callee(x)

fn fwd_callee(x):
  return x

fn dup(x):
  a = x
  return x

fn pair(x, y):
  a = x
  b = y
  return x

fn branch(x, flag: Bool):
  if flag:
    a = x
  return x

fn loopy(x, n: Int):
  var i = 0
  while i < n:
    a = x
    i = i + 1
  return 0

fn alias(x):
  a = x
  b = x
  return 0

fn safe(x):
  a = x
  return a

fn wrapv(x):
  xs = [x]
  ys = xs
  return xs

fn both(x, y):
  a = x
  b = y
  return 0

fn twice_call(v):
  return both(v, v)

fn split_call(v, w):
  return both(v, w)

fn put(x, y):
  var v = [x]
  v.push(y)
  return x

fn wrap(x):
  y = x
  z = y
  return z

fn choose(x, y, flag: Bool):
  if flag:
    return x
  return y

fn reassign(x):
  var r = x
  r = x
  return r

fn inner(x):
  return x.score()

fn outer(x):
  return inner(x) + 1

fn twice(x):
  s = x.score()
  return s + s

fn m(v, x):
  match v:
    case Ready:
      a = x
    case Number(value):
      b = value
  return x

type Holder:
  item

fn reads(x):
  return 0

fn read_call(v):
  r = reads(v)
  return v

fn call_dup(v):
  return dup(v)

fn branch_call(v, flag: Bool):
  if flag:
    r = both(v, 1)
  return v

fn loop_call(v, n: Int):
  var i = 0
  while i < n:
    r = both(v, 1)
    i = i + 1
  return 0

fn alias_call(v):
  w = v
  r = both(w, 1)
  return v

fn hold(x):
  h = Holder(item: x)
  return x

fn main():
  echo dup(3)
