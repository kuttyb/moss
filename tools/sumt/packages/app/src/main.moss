module app

import core

type Counter:
  n: Int
  fn bump():
    n = n + 1
    return n

type Sq:
  side: Int
  fn bump():
    return side

fn double(x: Int) -> Int:
  return x * 2

fn shout(s: String) -> String:
  return s + "!"

fn is_even(x: Int) -> Bool:
  return x % 2 == 0

fn main():
  echo core.root(3)
  echo core.root(1.5)
  k = Counter(n = 1)
  echo core.poke(k)
  echo core.poke(Sq(side = 4))
  echo core.transform([1, 2, 3], double)
  echo core.transform(["a"], shout)
  echo core.count_matching([1, 2, 3, 4], is_even)
