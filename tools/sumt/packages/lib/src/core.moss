module core

fn leaf(x):
  return x + x

fn middle(x):
  return leaf(x)

export fn root(x):
  return middle(x)

export fn poke(c):
  return c.bump()

export fn transform(xs, f):
  return xs |> map(f)

export fn count_matching(items: Vector[Int], pred) -> Int:
  return items |> filter(pred) |> count

export fn bump_first(v):
  return v[0].bump()
