import model
import graph
import algorithms

fn index_of(vec: Vector[Int], count: Int, target: Int) -> Int:
  var i = 0
  while i < count:
    if vec[i] == target:
      return i
    i = i + 1
  return 0 - 1

test "empty graph":
  g = graph.make_graph()
  assertEqual(graph.graph_task_count(g), 0)
  assertEqual(graph.graph_dependency_count(g), 0)
  assertEqual(graph.graph_total_cost(g), 0)
  assertEqual(algorithms.ready_task_count(g), 0)
  assert(not algorithms.has_cycle(g))
  summary = algorithms.calculate_plan_summary(g)
  assertEqual(model.summary_task_count(summary), 0)
  assertEqual(model.summary_dependency_count(summary), 0)
  assertEqual(model.summary_total_cost(summary), 0)
  assertEqual(model.summary_ready_count(summary), 0)
  assert(not model.summary_has_cycle(summary))

test "one task":
  g0 = graph.make_graph()
  t1 = model.make_task(101, 1, 50)
  g = graph.graph_add_task(g0, t1)
  assertEqual(graph.graph_task_count(g), 1)
  assert(graph.graph_contains_task(g, 101))
  assert(not graph.graph_contains_task(g, 999))
  assertEqual(graph.graph_total_cost(g), 50)
  assertEqual(graph.graph_category_cost(g, 1), 50)
  assertEqual(graph.graph_category_cost(g, 2), 0)
  assertEqual(algorithms.ready_task_count(g), 1)
  ready = algorithms.ready_tasks(g)
  assertEqual(ready[0], 101)
  assert(not algorithms.has_cycle(g))
  assertEqual(algorithms.build_order_count(g), 1)
  order = algorithms.build_order(g)
  assertEqual(order[0], 101)

test "duplicate task":
  g0 = graph.make_graph()
  t1 = model.make_task(101, 1, 50)
  g1 = graph.graph_add_task(g0, t1)
  t1_dup = model.make_task(101, 2, 100)
  g2 = graph.graph_add_task(g1, t1_dup)
  assertEqual(graph.graph_task_count(g2), 1)
  assertEqual(graph.graph_total_cost(g2), 50)

test "several independent tasks":
  g0 = graph.make_graph()
  g1 = graph.graph_add_task(g0, model.make_task(1, 1, 10))
  g2 = graph.graph_add_task(g1, model.make_task(2, 2, 20))
  g3 = graph.graph_add_task(g2, model.make_task(3, 1, 30))
  assertEqual(graph.graph_task_count(g3), 3)
  assertEqual(graph.graph_dependency_count(g3), 0)
  assertEqual(graph.graph_total_cost(g3), 60)
  assertEqual(algorithms.ready_task_count(g3), 3)
  assert(not algorithms.has_cycle(g3))
  assertEqual(algorithms.build_order_count(g3), 3)

test "linear dependency chain":
  g0 = graph.make_graph()
  g1 = graph.graph_add_task(g0, model.make_task(1, 1, 10))
  g2 = graph.graph_add_task(g1, model.make_task(2, 1, 20))
  g3 = graph.graph_add_task(g2, model.make_task(3, 1, 30))
  g4 = graph.graph_add_dependency(g3, 1, 2)
  g5 = graph.graph_add_dependency(g4, 2, 3)
  assertEqual(graph.graph_task_count(g5), 3)
  assertEqual(graph.graph_dependency_count(g5), 2)
  assertEqual(algorithms.ready_task_count(g5), 1)
  ready = algorithms.ready_tasks(g5)
  assertEqual(ready[0], 1)
  assert(not algorithms.has_cycle(g5))
  cnt = algorithms.build_order_count(g5)
  assertEqual(cnt, 3)
  order = algorithms.build_order(g5)
  idx1 = index_of(order, cnt, 1)
  idx2 = index_of(order, cnt, 2)
  idx3 = index_of(order, cnt, 3)
  assert(idx1 < idx2)
  assert(idx2 < idx3)

test "diamond dependency graph":
  g0 = graph.make_graph()
  g1 = graph.graph_add_task(g0, model.make_task(1, 1, 10))
  g2 = graph.graph_add_task(g1, model.make_task(2, 1, 20))
  g3 = graph.graph_add_task(g2, model.make_task(3, 1, 30))
  g4 = graph.graph_add_task(g3, model.make_task(4, 1, 40))
  d1 = graph.graph_add_dependency(g4, 1, 2)
  d2 = graph.graph_add_dependency(d1, 1, 3)
  d3 = graph.graph_add_dependency(d2, 2, 4)
  d4 = graph.graph_add_dependency(d3, 3, 4)
  assertEqual(graph.graph_task_count(d4), 4)
  assertEqual(graph.graph_dependency_count(d4), 4)
  assertEqual(algorithms.ready_task_count(d4), 1)
  ready = algorithms.ready_tasks(d4)
  assertEqual(ready[0], 1)
  assert(not algorithms.has_cycle(d4))
  cnt = algorithms.build_order_count(d4)
  assertEqual(cnt, 4)
  order = algorithms.build_order(d4)
  idx1 = index_of(order, cnt, 1)
  idx2 = index_of(order, cnt, 2)
  idx3 = index_of(order, cnt, 3)
  idx4 = index_of(order, cnt, 4)
  assert(idx1 < idx2)
  assert(idx1 < idx3)
  assert(idx2 < idx4)
  assert(idx3 < idx4)

test "disconnected components":
  g0 = graph.make_graph()
  g1 = graph.graph_add_task(g0, model.make_task(1, 1, 10))
  g2 = graph.graph_add_task(g1, model.make_task(2, 1, 20))
  g3 = graph.graph_add_task(g2, model.make_task(3, 2, 30))
  g4 = graph.graph_add_task(g3, model.make_task(4, 2, 40))
  d1 = graph.graph_add_dependency(g4, 1, 2)
  d2 = graph.graph_add_dependency(d1, 3, 4)
  assertEqual(graph.graph_task_count(d2), 4)
  assertEqual(graph.graph_dependency_count(d2), 2)
  assertEqual(algorithms.ready_task_count(d2), 2)
  assert(not algorithms.has_cycle(d2))
  cnt = algorithms.build_order_count(d2)
  assertEqual(cnt, 4)
  order = algorithms.build_order(d2)
  idx1 = index_of(order, cnt, 1)
  idx2 = index_of(order, cnt, 2)
  idx3 = index_of(order, cnt, 3)
  idx4 = index_of(order, cnt, 4)
  assert(idx1 < idx2)
  assert(idx3 < idx4)

test "missing dependency endpoint":
  g0 = graph.make_graph()
  g1 = graph.graph_add_task(g0, model.make_task(1, 1, 10))
  g2 = graph.graph_add_dependency(g1, 1, 999)
  g3 = graph.graph_add_dependency(g2, 888, 1)
  assertEqual(graph.graph_task_count(g3), 1)
  assertEqual(graph.graph_dependency_count(g3), 0)
  assertEqual(graph.graph_missing_dependency_count(g3), 2)
  assertEqual(algorithms.ready_task_count(g3), 1)
  assert(not algorithms.has_cycle(g3))

test "total and category cost":
  g0 = graph.make_graph()
  g1 = graph.graph_add_task(g0, model.make_task(1, 10, 15))
  g2 = graph.graph_add_task(g1, model.make_task(2, 20, 25))
  g3 = graph.graph_add_task(g2, model.make_task(3, 10, 35))
  assertEqual(graph.graph_total_cost(g3), 75)
  assertEqual(graph.graph_category_cost(g3, 10), 50)
  assertEqual(graph.graph_category_cost(g3, 20), 25)
  assertEqual(graph.graph_category_cost(g3, 99), 0)

test "multiple ready tasks":
  g0 = graph.make_graph()
  g1 = graph.graph_add_task(g0, model.make_task(1, 1, 10))
  g2 = graph.graph_add_task(g1, model.make_task(2, 1, 20))
  g3 = graph.graph_add_task(g2, model.make_task(3, 1, 30))
  d1 = graph.graph_add_dependency(g3, 1, 3)
  d2 = graph.graph_add_dependency(d1, 2, 3)
  assertEqual(algorithms.ready_task_count(d2), 2)
  ready = algorithms.ready_tasks(d2)
  r0 = ready[0]
  r1 = ready[1]
  assert(r0 == 1 or r0 == 2)
  assert(r1 == 1 or r1 == 2)
  assert(r0 != r1)

test "cycle detection simple":
  g0 = graph.make_graph()
  g1 = graph.graph_add_task(g0, model.make_task(1, 1, 10))
  g2 = graph.graph_add_task(g1, model.make_task(2, 1, 20))
  d1 = graph.graph_add_dependency(g2, 1, 2)
  d2 = graph.graph_add_dependency(d1, 2, 1)
  assertEqual(graph.graph_task_count(d2), 2)
  assertEqual(graph.graph_dependency_count(d2), 2)
  assert(algorithms.has_cycle(d2))
  assertEqual(algorithms.ready_task_count(d2), 0)

test "cycle detection three node":
  g0 = graph.make_graph()
  g1 = graph.graph_add_task(g0, model.make_task(1, 1, 10))
  g2 = graph.graph_add_task(g1, model.make_task(2, 1, 20))
  g3 = graph.graph_add_task(g2, model.make_task(3, 1, 30))
  d1 = graph.graph_add_dependency(g3, 1, 2)
  d2 = graph.graph_add_dependency(d1, 2, 3)
  d3 = graph.graph_add_dependency(d2, 3, 1)
  assert(algorithms.has_cycle(d3))
