module statistics

import math

# ============================================================================
# Moss Phase 24 — Package C: moss.statistics
# Descriptive statistics, Kahan compensated summation, two-pass variance,
# Method 7 quantiles, and Welford / Chan-Golub-LeVeque streaming accumulators.
# ============================================================================

# --- Types & Error Contracts ---

export enum StatsError:
  EmptyInput
  InsufficientData
  DimensionMismatch
  InvalidQuantile
  InvalidWeight
  ZeroVariance
  InvalidValue

export type StatsSummary:
  count: Int
  min_val: Float
  max_val: Float
  mean_val: Float
  var_val: Float
  std_dev_val: Float

export type RunningStats:
  count: Int
  mean_val: Float
  m2: Float
  min_val: Float
  max_val: Float

# --- Compensated Summation & Descriptive Statistics ---

export fn kahan_sum(v: Vector[Float]) -> Float:
  let n = v |> count
  var sum = 0.0
  var c = 0.0
  var i = 0
  while i < n:
    let x = v[i]
    if math.is_nan(x):
      return math.nan()
    let t = sum + x
    if math.abs(sum) >= math.abs(x):
      c = c + ((sum - t) + x)
    else:
      c = c + ((x - t) + sum)
    sum = t
    i = i + 1
  return sum + c

export fn sum(v: Vector[Float]) -> Float:
  return kahan_sum(v)

export fn mean(v: Vector[Float]) -> Float:
  let n = v |> count
  if n == 0:
    raise StatsError.EmptyInput
  return kahan_sum(v) / (n * 1.0)

export fn weighted_mean(v: Vector[Float], w: Vector[Float]) -> Float:
  let n = v |> count
  let nw = w |> count
  if n != nw:
    raise StatsError.DimensionMismatch
  if n == 0:
    raise StatsError.EmptyInput

  var sum_w = 0.0
  var cw = 0.0
  var sum_prod = 0.0
  var cp = 0.0
  var i = 0
  while i < n:
    let weight = w[i]
    if math.is_nan(weight) or weight < 0.0:
      raise StatsError.InvalidWeight
    let val = v[i]

    let yw = weight - cw
    let tw = sum_w + yw
    cw = (tw - sum_w) - yw
    sum_w = tw

    let prod = val * weight
    let yp = prod - cp
    let tp = sum_prod + yp
    cp = (tp - sum_prod) - yp
    sum_prod = tp

    i = i + 1

  if sum_w <= 0.0:
    raise StatsError.InvalidWeight

  return sum_prod / sum_w

export fn min_value(v: Vector[Float]) -> Float:
  let n = v |> count
  if n == 0:
    raise StatsError.EmptyInput
  var min_val = v[0]
  if math.is_nan(min_val):
    return min_val
  var i = 1
  while i < n:
    let x = v[i]
    if math.is_nan(x):
      return x
    if x < min_val:
      min_val = x
    i = i + 1
  return min_val

export fn max_value(v: Vector[Float]) -> Float:
  let n = v |> count
  if n == 0:
    raise StatsError.EmptyInput
  var max_val = v[0]
  if math.is_nan(max_val):
    return max_val
  var i = 1
  while i < n:
    let x = v[i]
    if math.is_nan(x):
      return x
    if x > max_val:
      max_val = x
    i = i + 1
  return max_val

export fn data_range(v: Vector[Float]) -> Float:
  return max_value(v) - min_value(v)

export fn variance(v: Vector[Float], sample: Bool) -> Float:
  let n = v |> count
  if n == 0:
    raise StatsError.EmptyInput
  if sample and n < 2:
    raise StatsError.InsufficientData

  let m = mean(v)

  # Two-pass mean-centered algorithm with Kahan compensation
  var sum_sq = 0.0
  var c = 0.0
  var i = 0
  while i < n:
    let diff = v[i] - m
    let term = diff * diff
    let y = term - c
    let t = sum_sq + y
    c = (t - sum_sq) - y
    sum_sq = t
    i = i + 1

  if sample:
    return sum_sq / ((n - 1) * 1.0)
  return sum_sq / (n * 1.0)

export fn std_dev(v: Vector[Float], sample: Bool) -> Float:
  let var_val = variance(v, sample)
  return math.sqrt_val(var_val)

export fn summary(v: Vector[Float]) -> StatsSummary:
  let n = v |> count
  if n == 0:
    raise StatsError.EmptyInput
  let mn = min_value(v)
  let mx = max_value(v)
  let avg = mean(v)
  var var_val = 0.0
  var sd_val = 0.0
  if n >= 2:
    var_val = variance(v, true)
    sd_val = std_dev(v, true)
  else:
    var_val = variance(v, false)
    sd_val = std_dev(v, false)
  return StatsSummary(count: n, min_val: mn, max_val: mx, mean_val: avg, var_val: var_val, std_dev_val: sd_val)

# --- Bivariate Analysis ---

export fn covariance(x: Vector[Float], y: Vector[Float], sample: Bool) -> Float:
  let nx = x |> count
  let ny = y |> count
  if nx != ny:
    raise StatsError.DimensionMismatch
  if nx == 0:
    raise StatsError.EmptyInput
  if sample and nx < 2:
    raise StatsError.InsufficientData

  let mx = mean(x)
  let my = mean(y)

  var sum_prod = 0.0
  var c = 0.0
  var i = 0
  while i < nx:
    let dx = x[i] - mx
    let dy = y[i] - my
    let term = dx * dy
    let yr = term - c
    let t = sum_prod + yr
    c = (t - sum_prod) - yr
    sum_prod = t
    i = i + 1

  if sample:
    return sum_prod / ((nx - 1) * 1.0)
  return sum_prod / (nx * 1.0)

export fn correlation(x: Vector[Float], y: Vector[Float]) -> Float:
  let nx = x |> count
  let ny = y |> count
  if nx != ny:
    raise StatsError.DimensionMismatch
  if nx < 2:
    raise StatsError.InsufficientData

  let sx = std_dev(x, true)
  let sy = std_dev(y, true)

  if sx == 0.0 or sy == 0.0:
    raise StatsError.ZeroVariance

  let cov = covariance(x, y, true)
  let r = cov / (sx * sy)

  # Architect mandate: clamp strictly to [-1.0, 1.0] to guard against roundoff
  return math.clamp(r, 0.0 - 1.0, 1.0)

# --- Float Heapsort & Order Statistics ---

fn sift_down_floats(v: Vector[Float], start: Int, end_idx: Int):
  var root = start
  while (root * 2 + 1) <= end_idx:
    var child = root * 2 + 1
    let right = child + 1
    if right <= end_idx and v[child] < v[right]:
      child = right
    if v[root] < v[child]:
      let tmp = v[root]
      v[root] = v[child]
      v[child] = tmp
      root = child
    else:
      return

export fn sort_floats(v: Vector[Float]) -> Vector[Float]:
  let n = v |> count
  if n <= 1:
    var cloned = Vector[Float]()
    if n == 1:
      if math.is_nan(v[0]):
        raise StatsError.InvalidValue
      cloned.push(v[0])
    return cloned

  # Pre-scan for IEEE NaN vulnerability
  var i = 0
  while i < n:
    if math.is_nan(v[i]):
      raise StatsError.InvalidValue
    i = i + 1

  var res = Vector[Float]()
  i = 0
  while i < n:
    res.push(v[i])
    i = i + 1

  var start = (n - 2) / 2
  while start >= 0:
    sift_down_floats(res, start, n - 1)
    start = start - 1

  var end_idx = n - 1
  while end_idx > 0:
    let tmp = res[0]
    res[0] = res[end_idx]
    res[end_idx] = tmp
    end_idx = end_idx - 1
    sift_down_floats(res, 0, end_idx)

  return res

fn float_to_int_nonneg(x: Float) -> Int:
  var low = 0
  var high = 9223372036854775807
  var ans = 0
  while low <= high:
    let mid = (low + high) / 2
    let mf = mid * 1.0
    if mf <= x:
      ans = mid
      low = mid + 1
    else:
      high = mid - 1
  return ans

export fn quantile(v: Vector[Float], q: Float) -> Float:
  let n = v |> count
  if n == 0:
    raise StatsError.EmptyInput
  if math.is_nan(q) or q < 0.0 or q > 1.0:
    raise StatsError.InvalidQuantile

  let sorted = sort_floats(v)
  if n == 1:
    return sorted[0]

  # Hyndman & Fan (1996) Method 7 (R / NumPy default)
  let h = (n - 1) * 1.0 * q
  let i = float_to_int_nonneg(h)
  let f = h - (i * 1.0)

  if i >= (n - 1):
    return sorted[n - 1]

  let val_i = sorted[i]
  let val_next = sorted[i + 1]
  return val_i + f * (val_next - val_i)

export fn median(v: Vector[Float]) -> Float:
  return quantile(v, 0.5)

export fn percentile(v: Vector[Float], p: Float) -> Float:
  if math.is_nan(p) or p < 0.0 or p > 100.0:
    raise StatsError.InvalidQuantile
  return quantile(v, p / 100.0)

export fn iqr(v: Vector[Float]) -> Float:
  let q75 = quantile(v, 0.75)
  let q25 = quantile(v, 0.25)
  return q75 - q25

# --- Online / Streaming Statistics (Welford & Chan-Golub-LeVeque) ---

export fn new_running_stats() -> RunningStats:
  return RunningStats(count: 0, mean_val: 0.0, m2: 0.0, min_val: math.infinity(), max_val: math.neg_infinity())

export fn running_update(s: RunningStats, x: Float):
  if math.is_nan(x):
    return
  s.count = s.count + 1
  let delta = x - s.mean_val
  s.mean_val = s.mean_val + delta / (s.count * 1.0)
  let delta2 = x - s.mean_val
  s.m2 = s.m2 + delta * delta2
  if x < s.min_val:
    s.min_val = x
  if x > s.max_val:
    s.max_val = x

export fn running_count(s: RunningStats) -> Int:
  return s.count

export fn running_mean(s: RunningStats) -> Float:
  if s.count == 0:
    raise StatsError.EmptyInput
  return s.mean_val

export fn running_variance(s: RunningStats, sample: Bool) -> Float:
  if s.count == 0:
    raise StatsError.EmptyInput
  if sample and s.count < 2:
    raise StatsError.InsufficientData
  if sample:
    return s.m2 / ((s.count - 1) * 1.0)
  return s.m2 / (s.count * 1.0)

export fn running_std_dev(s: RunningStats, sample: Bool) -> Float:
  let var_val = running_variance(s, sample)
  return math.sqrt_val(var_val)

export fn running_combine(a: RunningStats, b: RunningStats) -> RunningStats:
  if a.count == 0:
    return RunningStats(count: b.count, mean_val: b.mean_val, m2: b.m2, min_val: b.min_val, max_val: b.max_val)
  if b.count == 0:
    return RunningStats(count: a.count, mean_val: a.mean_val, m2: a.m2, min_val: a.min_val, max_val: a.max_val)

  let na = a.count * 1.0
  let nb = b.count * 1.0
  let n_total = na + nb
  let delta = b.mean_val - a.mean_val
  let new_mean = a.mean_val + delta * (nb / n_total)

  # Architect mandate: float scaling (na / n_total) * nb protects against 64-bit int overflow
  let new_m2 = a.m2 + b.m2 + delta * delta * ((na / n_total) * nb)
  let new_min = math.min(a.min_val, b.min_val)
  let new_max = math.max(a.max_val, b.max_val)

  return RunningStats(count: a.count + b.count, mean_val: new_mean, m2: new_m2, min_val: new_min, max_val: new_max)
