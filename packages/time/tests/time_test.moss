# ============================================================================
# Moss Phase 24 — Tests for moss.time
# ============================================================================

import time

test "duration conversions and arithmetic":
  d_zero = time.duration_zero()
  assertEqual(time.duration_is_zero(d_zero), true)
  assertEqual(time.duration_nanos(d_zero), 0)

  d_sec = time.duration_from_seconds(5)
  assertEqual(time.duration_seconds(d_sec), 5)
  assertEqual(time.duration_millis(d_sec), 5000)
  assertEqual(time.duration_micros(d_sec), 5000000)
  assertEqual(time.duration_nanos(d_sec), 5000000000)

  d_min = time.duration_from_minutes(2)
  assertEqual(time.duration_seconds(d_min), 120)

  d_hr = time.duration_from_hours(1)
  assertEqual(time.duration_minutes(d_hr), 60)

  # Arithmetic
  d_sum = time.duration_add(d_sec, d_min)
  assertEqual(time.duration_seconds(d_sum), 125)

  d_diff = time.duration_sub(d_min, d_sec)
  assertEqual(time.duration_seconds(d_diff), 115)

  d_scaled = time.duration_scale(d_sec, 3)
  assertEqual(time.duration_seconds(d_scaled), 15)

  d_div = time.duration_div(d_sec, 2)
  assertEqual(time.duration_millis(d_div), 2500)

  # Negatives and abs
  d_neg = time.duration_sub(d_sec, d_min)
  assertEqual(time.duration_is_negative(d_neg), true)
  d_pos = time.duration_abs(d_neg)
  assertEqual(time.duration_is_negative(d_pos), false)
  assertEqual(time.duration_seconds(d_pos), 115)

  # Predicates
  assertEqual(time.duration_lt(d_sec, d_min), true)
  assertEqual(time.duration_gt(d_min, d_sec), true)
  assertEqual(time.duration_eq(d_sec, time.duration_from_seconds(5)), true)

test "instant monotonic points":
  t0 = time.make_instant(1000000000)
  t1 = time.make_instant(2500000000)

  diff = time.instant_diff(t1, t0)
  assertEqual(time.duration_millis(diff), 1500)

  elapsed = time.instant_elapsed(t0, t1)
  assertEqual(time.duration_millis(elapsed), 1500)

  assertEqual(time.instant_lt(t0, t1), true)
  assertEqual(time.instant_gt(t1, t0), true)
  assertEqual(time.instant_eq(t0, time.make_instant(1000000000)), true)

  t2 = time.instant_add_duration(t0, time.duration_from_seconds(1))
  assertEqual(time.instant_nanos(t2), 2000000000)

  t3 = time.instant_sub_duration(t1, time.duration_from_millis(500))
  assertEqual(time.instant_nanos(t3), 2000000000)

test "timestamp and epoch arithmetic":
  ts0 = time.timestamp_from_unix_seconds(0)
  assertEqual(time.timestamp_unix_millis(ts0), 0)
  assertEqual(time.timestamp_unix_seconds(ts0), 0)

  ts1 = time.timestamp_from_unix_millis(1609459200000) # 2021-01-01 00:00:00 UTC
  assertEqual(time.timestamp_unix_seconds(ts1), 1609459200)

  dur = time.duration_from_seconds(3600)
  ts2 = time.timestamp_add_duration(ts1, dur)
  assertEqual(time.timestamp_unix_seconds(ts2), 1609462800)

  ts3 = time.timestamp_sub_duration(ts2, dur)
  assertEqual(time.timestamp_eq(ts3, ts1), true)

  diff = time.timestamp_diff(ts2, ts1)
  assertEqual(time.duration_seconds(diff), 3600)

test "calendar conversion and leap years":
  # 1970-01-01 00:00:00 UTC
  ts_epoch = time.timestamp_from_unix_millis(0)
  dt_epoch = time.timestamp_to_datetime(ts_epoch)
  assertEqual(dt_epoch.year, 1970)
  assertEqual(dt_epoch.month, 1)
  assertEqual(dt_epoch.day, 1)
  assertEqual(dt_epoch.hour, 0)
  assertEqual(dt_epoch.minute, 0)
  assertEqual(dt_epoch.second, 0)
  assertEqual(dt_epoch.millisecond, 0)

  # Roundtrip
  ts_epoch_roundtrip = time.datetime_to_timestamp(dt_epoch)
  assertEqual(time.timestamp_unix_millis(ts_epoch_roundtrip), 0)

  # Leap day: 2000-02-29 12:30:45.500 UTC
  # Days to 2000-01-01 is 10957. Days to 2000-02-29 is 10957 + 31 + 28 = 11016 days.
  # ms = 11016 * 86400000 + 12 * 3600000 + 30 * 60000 + 45 * 1000 + 500
  dt_leap = time.make_datetime(2000, 2, 29, 12, 30, 45, 500)
  ts_leap = time.datetime_to_timestamp(dt_leap)
  dt_leap_back = time.timestamp_to_datetime(ts_leap)
  assertEqual(dt_leap_back.year, 2000)
  assertEqual(dt_leap_back.month, 2)
  assertEqual(dt_leap_back.day, 29)
  assertEqual(dt_leap_back.hour, 12)
  assertEqual(dt_leap_back.minute, 30)
  assertEqual(dt_leap_back.second, 45)
  assertEqual(dt_leap_back.millisecond, 500)

test "iso 8601 formatting":
  dt = time.make_datetime(2026, 10, 12, 5, 45, 30, 25)
  iso = time.datetime_to_iso8601(dt)
  assertEqual(iso, "2026-10-12T05:45:30.025Z")

  ts_epoch = time.timestamp_from_unix_millis(0)
  iso_epoch = time.timestamp_to_iso8601(ts_epoch)
  assertEqual(iso_epoch, "1970-01-01T00:00:00.000Z")
