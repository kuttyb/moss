# ============================================================================
# Moss Phase 24 — Tests for moss.math
# ============================================================================

import math

test "constants":
  assertEqual(math.pi() > 3.14159 and math.pi() < 3.14160, true)
  assertEqual(math.e() > 2.71828 and math.e() < 2.71829, true)
  assertEqual(math.tau() > 6.28318 and math.tau() < 6.28319, true)
  assertEqual(math.is_infinite(math.infinity()), true)
  assertEqual(math.is_infinite(math.neg_infinity()), true)
  assertEqual(math.is_nan_val(math.nan()), true)

test "abs and signed zero clearing":
  assertEqual(math.abs(5.5), 5.5)
  assertEqual(math.abs(-5.5), 5.5)
  # abs(-0.0) must clear the negative sign: 1.0 / abs(-0.0) must be +inf
  abs_neg_zero = math.abs(-0.0)
  assertEqual(abs_neg_zero, 0.0)
  assertEqual(1.0 / abs_neg_zero > 0.0, true)

test "abs_int and int min wrapping":
  assertEqual(math.abs_int(42), 42)
  assertEqual(math.abs_int(-42), 42)
  # INT64_MIN wraps to INT64_MIN
  int_min = -9223372036854775808
  assertEqual(math.abs_int(int_min), int_min)

test "min and max signed zero and nan contract":
  # Signed zero: min(-0.0, +0.0) == -0.0
  m_zero = math.min(-0.0, 0.0)
  assertEqual(m_zero, 0.0)
  assertEqual(1.0 / m_zero < 0.0, true)

  # Signed zero: max(-0.0, +0.0) == +0.0
  mx_zero = math.max(-0.0, 0.0)
  assertEqual(mx_zero, 0.0)
  assertEqual(1.0 / mx_zero > 0.0, true)

  # NaN handling: non-NaN preferred
  assertEqual(math.min(math.nan(), 5.0), 5.0)
  assertEqual(math.min(5.0, math.nan()), 5.0)
  assertEqual(math.max(math.nan(), 5.0), 5.0)
  assertEqual(math.max(5.0, math.nan()), 5.0)

test "pow ieee edge cases":
  # pow(NaN, 0.0) == 1.0
  assertEqual(math.pow(math.nan(), 0.0), 1.0)
  assertEqual(math.pow(1.0, math.nan()), 1.0)
  assertEqual(math.pow(2.0, 3.0), 8.0)
  assertEqual(math.pow(-2.0, 3.0), -8.0)
  assertEqual(math.pow(-2.0, 4.0), 16.0)

test "atan1 range reduction accuracy":
  # atan(1.0) must be pi/4 approx 0.7853982
  a1 = math.atan(1.0)
  expected_pi_over_4 = 0.7853981633974483
  diff = math.abs(a1 - expected_pi_over_4)
  assertEqual(diff < 0.000001, true)

test "hyperbolics large magnitude protection":
  assertEqual(math.tanh(1000.0), 1.0)
  assertEqual(math.tanh(-1000.0), -1.0)
  assertEqual(math.is_infinite(math.sinh(800.0)), true)
  assertEqual(math.is_infinite(math.cosh(800.0)), true)

test "hypot intermediate scaling":
  # Must not overflow on 1e200
  h = math.hypot(3e200, 4e200)
  assertEqual(math.is_finite(h), true)
  ratio = h / 5e200
  assertEqual(math.abs(ratio - 1.0) < 0.00001, true)

test "round ties to even":
  assertEqual(math.round(2.5), 2.0)
  assertEqual(math.round(3.5), 4.0)
  assertEqual(math.round(-2.5), -2.0)
  assertEqual(math.round(-3.5), -4.0)
