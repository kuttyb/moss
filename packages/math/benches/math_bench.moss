import math

bench "math scalar abs and clamp":
  x = math.abs(-123.456)
  c = math.clamp(x, 0.0, 100.0)

bench "math float round ties to even":
  r1 = math.round(2.5)
  r2 = math.round(3.5)

bench "math sin and cos polynomial":
  s = math.sin(0.785398)
  c = math.cos(0.785398)

bench "math exp and ln":
  e = math.exp(1.5)
  l = math.ln(e)

bench "math hypot scaled":
  h = math.hypot(3000.0, 4000.0)
