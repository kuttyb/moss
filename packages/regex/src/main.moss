module regex

# Closed Phase 21 error enum
export enum RegexError:
  UnexpectedToken(index: Int)
  UnclosedParenthesis(index: Int)
  UnclosedBracket(index: Int)
  DanglingRepetition(index: Int)
  InvalidRange(index: Int)
  InvalidEscape(index: Int)
  PatternTooComplex(state_count: Int)
  UnsupportedFeature(index: Int)

export type MatchSpan:
  start: Int
  end: Int
  text: String

export enum MatchResult:
  NoMatch
  Matched(start: Int, end: Int)

# State constants
fn KIND_MATCH() -> Int = 0
fn KIND_CHAR() -> Int = 1
fn KIND_ANY() -> Int = 2
fn KIND_CLASS() -> Int = 3
fn KIND_SPLIT() -> Int = 4
fn KIND_ANCHOR_START() -> Int = 5
fn KIND_ANCHOR_END() -> Int = 6

# Token constants
fn TOK_CHAR() -> Int = 1
fn TOK_ANY() -> Int = 2
fn TOK_CLASS() -> Int = 3
fn TOK_ANCHOR_START() -> Int = 4
fn TOK_ANCHOR_END() -> Int = 5
fn TOK_CONCAT() -> Int = 10
fn TOK_ALT() -> Int = 11
fn TOK_STAR() -> Int = 12
fn TOK_PLUS() -> Int = 13
fn TOK_QMARK() -> Int = 14
fn TOK_LPAREN() -> Int = 15
fn TOK_RPAREN() -> Int = 16

export type Regex:
  pattern: String
  start_state: Int
  match_state: Int
  num_states: Int
  kinds: Vector[Int]
  chars: Vector[String]
  classes: Vector[String]
  negs: Vector[Bool]
  outs: Vector[Int]
  out1s: Vector[Int]

fn push_int(vec: Vector[Int], val: Int):
  vec.push(val)

fn push_str(vec: Vector[String], val: String):
  vec.push(val)

fn push_bool(vec: Vector[Bool], val: Bool):
  vec.push(val)

fn add_tok(kinds: Vector[Int], chars: Vector[String], classes: Vector[String], negs: Vector[Bool], k: Int, c: String, cl: String, neg: Bool):
  kinds.push(k)
  chars.push(c)
  classes.push(cl)
  negs.push(neg)



# Expand character range 'a-z'
fn expand_range(start_ch: String, end_ch: String) -> String:
  let printable = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
  let p_start = printable.find(start_ch)
  let p_end = printable.find(end_ch)
  if p_start < 0 or p_end < 0:
    return start_ch + end_ch
  if p_start > p_end:
    return ""
  let len_range = p_end - p_start + 1
  return printable.slice(p_start, len_range)

fn is_repeatable_atom(tok_kind: Int) -> Bool:
  if tok_kind == 1 or tok_kind == 2 or tok_kind == 3 or tok_kind == 16:
    return true
  return false

# =========================================================================
# 1. Tokenizer & Shunting-Yard Parser (Infix to Postfix)
# =========================================================================

fn is_atom_start(tok_kind: Int) -> Bool:
  if tok_kind == 1 or tok_kind == 2 or tok_kind == 3 or tok_kind == 4 or tok_kind == 5 or tok_kind == 15:
    return true
  return false

fn is_atom_end(tok_kind: Int) -> Bool:
  if tok_kind == 1 or tok_kind == 2 or tok_kind == 3 or tok_kind == 4 or tok_kind == 5 or tok_kind == 12 or tok_kind == 13 or tok_kind == 14 or tok_kind == 16:
    return true
  return false

fn op_precedence(tok_kind: Int) -> Int:
  if tok_kind == 11:
    return 1
  if tok_kind == 10:
    return 2
  if tok_kind == 12 or tok_kind == 13 or tok_kind == 14:
    return 3
  return 0


# =========================================================================
# 2. Thompson NFA Compiler
# =========================================================================

export fn compile(pattern: String) -> Regex:
  let chars_vec = pattern.chars()
  let n = chars_vec |> count
  if n > 2048:
    raise RegexError.PatternTooComplex(state_count: n)

  # Raw tokens
  var raw_kinds = Vector[Int]()
  var raw_chars = Vector[String]()
  var raw_classes = Vector[String]()
  var raw_negs = Vector[Bool]()

  var i = 0
  while i < n:
    let c = chars_vec[i]
    if c == "(":
      add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 15, "(", "", false)
    else:
      if c == ")":
        let num_r = raw_kinds |> count
        if num_r > 0:
          let prev_k = raw_kinds[num_r - 1]
          if prev_k == 11:
            raise RegexError.UnexpectedToken(index: i)
        add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 16, ")", "", false)
      else:
        if c == "|":
          let num_r = raw_kinds |> count
          if num_r == 0:
            raise RegexError.UnexpectedToken(index: i)
          let prev_k = raw_kinds[num_r - 1]
          if prev_k == 11 or prev_k == 15:
            raise RegexError.UnexpectedToken(index: i)
          add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 11, "|", "", false)
        else:
          if c == "*":
            let num_r = raw_kinds |> count
            if num_r == 0:
              raise RegexError.DanglingRepetition(index: i)
            let prev_k = raw_kinds[num_r - 1]
            if not is_repeatable_atom(prev_k):
              raise RegexError.DanglingRepetition(index: i)
            add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 12, "*", "", false)
          else:
            if c == "+":
              let num_r = raw_kinds |> count
              if num_r == 0:
                raise RegexError.DanglingRepetition(index: i)
              let prev_k = raw_kinds[num_r - 1]
              if not is_repeatable_atom(prev_k):
                raise RegexError.DanglingRepetition(index: i)
              add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 13, "+", "", false)
            else:
              if c == "?":
                let num_r = raw_kinds |> count
                if num_r == 0:
                  raise RegexError.DanglingRepetition(index: i)
                let prev_k = raw_kinds[num_r - 1]
                if not is_repeatable_atom(prev_k):
                  raise RegexError.DanglingRepetition(index: i)
                add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 14, "?", "", false)
              else:
                if c == "^":
                  add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 4, "^", "", false)
                else:
                  if c == "$":
                    add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 5, "$", "", false)
                  else:
                    if c == ".":
                      add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 2, ".", "", false)
                    else:
                      if c == "\\":
                        i = i + 1
                        if i >= n:
                          raise RegexError.InvalidEscape(index: i - 1)
                        let esc_ch = chars_vec[i]
                        if esc_ch == "d":
                          add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 3, "", "0123456789", false)
                        else:
                          if esc_ch == "D":
                            add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 3, "", "0123456789", true)
                          else:
                            if esc_ch == "w":
                              add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 3, "", "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", false)
                            else:
                              if esc_ch == "W":
                                add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 3, "", "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", true)
                              else:
                                if esc_ch == "s":
                                  add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 3, "", " \t\r\n", false)
                                else:
                                  if esc_ch == "S":
                                    add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 3, "", " \t\r\n", true)
                                  else:
                                    add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 1, esc_ch, "", false)
                      else:
                        if c == "[":
                          let start_class_idx = i
                          i = i + 1
                          var is_neg_class = false
                          if i < n and chars_vec[i] == "^":
                            is_neg_class = true
                            i = i + 1
                          var class_builder = ""
                          var in_class = true
                          while in_class:
                            if i >= n:
                              raise RegexError.UnclosedBracket(index: start_class_idx)
                            let cur_c = chars_vec[i]
                            if cur_c == "]":
                              in_class = false
                            else:
                              if cur_c == "\\" and (i + 1) < n:
                                i = i + 1
                                class_builder = class_builder + chars_vec[i]
                              else:
                                if (i + 2) < n and chars_vec[i + 1] == "-" and chars_vec[i + 2] != "]":
                                  let printable_ref = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
                                  let p_start = printable_ref.find(chars_vec[i])
                                  let p_end = printable_ref.find(chars_vec[i + 2])
                                  if p_start >= 0 and p_end >= 0 and p_start > p_end:
                                    raise RegexError.InvalidRange(index: i)
                                  let rng = expand_range(chars_vec[i], chars_vec[i + 2])
                                  class_builder = class_builder + rng
                                  i = i + 2
                                else:
                                  class_builder = class_builder + cur_c
                            i = i + 1
                          i = i - 1 # compensate outer loop increment
                          add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 3, "", class_builder, is_neg_class)
                        else:
                          add_tok(raw_kinds, raw_chars, raw_classes, raw_negs, 1, c, "", false)
    i = i + 1

  let total_raw = raw_kinds |> count
  if total_raw > 0:
    let last_k = raw_kinds[total_raw - 1]
    if last_k == 11:
      raise RegexError.UnexpectedToken(index: n - 1)


  # Insert explicit concatenation
  var kinds = Vector[Int]()
  var chars_list = Vector[String]()
  var classes_list = Vector[String]()
  var negs_list = Vector[Bool]()

  let num_raw = raw_kinds |> count
  var r_idx = 0
  while r_idx < num_raw:
    if r_idx > 0:
      let prev_k = raw_kinds[r_idx - 1]
      let cur_k = raw_kinds[r_idx]
      if is_atom_end(prev_k) and is_atom_start(cur_k):
        add_tok(kinds, chars_list, classes_list, negs_list, 10, "&", "", false)
    push_int(kinds, raw_kinds[r_idx])
    push_str(chars_list, raw_chars[r_idx])
    push_str(classes_list, raw_classes[r_idx])
    push_bool(negs_list, raw_negs[r_idx])
    r_idx = r_idx + 1

  # Shunting-Yard to Postfix
  var post_kinds = Vector[Int]()
  var post_chars = Vector[String]()
  var post_classes = Vector[String]()
  var post_negs = Vector[Bool]()

  var op_kinds = Vector[Int]()
  var op_chars = Vector[String]()
  var op_classes = Vector[String]()
  var op_negs = Vector[Bool]()

  let total_toks = kinds |> count
  var t_idx = 0
  while t_idx < total_toks:
    let tk = kinds[t_idx]
    let tc = chars_list[t_idx]
    let tclass = classes_list[t_idx]
    let tneg = negs_list[t_idx]

    if tk == 1 or tk == 2 or tk == 3 or tk == 4 or tk == 5:
      add_tok(post_kinds, post_chars, post_classes, post_negs, tk, tc, tclass, tneg)
    else:
      if tk == 12 or tk == 13 or tk == 14:
        add_tok(post_kinds, post_chars, post_classes, post_negs, tk, tc, tclass, tneg)
      else:
        if tk == 15: # (
          add_tok(op_kinds, op_chars, op_classes, op_negs, tk, tc, tclass, tneg)
        else:
          if tk == 16: # )
            var popping = true
            while popping:
              let top_op_count = op_kinds |> count
              if top_op_count == 0:
                raise RegexError.UnclosedParenthesis(index: t_idx)
              let last_op_k = op_kinds[top_op_count - 1]
              if last_op_k == 15:
                # Pop the (
                var dummy_pop = op_kinds.pop()
                var dummy_c = op_chars.pop()
                var dummy_cl = op_classes.pop()
                var dummy_n = op_negs.pop()
                popping = false
              else:
                let pk = op_kinds.pop()
                let pc = op_chars.pop()
                let pcl = op_classes.pop()
                let pn = op_negs.pop()
                add_tok(post_kinds, post_chars, post_classes, post_negs, pk, pc, pcl, pn)
          else:
            # Binary operator (10: concat, 11: alt)
            var checking_prec = true
            while checking_prec:
              let cur_ops_len = op_kinds |> count
              if cur_ops_len > 0:
                let top_k = op_kinds[cur_ops_len - 1]
                if top_k != 15 and op_precedence(top_k) >= op_precedence(tk):
                  let pk = op_kinds.pop()
                  let pc = op_chars.pop()
                  let pcl = op_classes.pop()
                  let pn = op_negs.pop()
                  add_tok(post_kinds, post_chars, post_classes, post_negs, pk, pc, pcl, pn)
                else:
                  checking_prec = false
              else:
                checking_prec = false
            add_tok(op_kinds, op_chars, op_classes, op_negs, tk, tc, tclass, tneg)
    t_idx = t_idx + 1

  while (op_kinds |> count) > 0:
    let top_k = op_kinds[ (op_kinds |> count) - 1 ]
    if top_k == 15:
      raise RegexError.UnclosedParenthesis(index: total_toks)
    let pk = op_kinds.pop()
    let pc = op_chars.pop()
    let pcl = op_classes.pop()
    let pn = op_negs.pop()
    add_tok(post_kinds, post_chars, post_classes, post_negs, pk, pc, pcl, pn)


  # Thompson Fragment Assembly
  var st_kinds = Vector[Int]()
  var st_chars = Vector[String]()
  var st_classes = Vector[String]()
  var st_negs = Vector[Bool]()
  var st_outs = Vector[Int]()
  var st_out1s = Vector[Int]()

  # Fragment stack:
  # Frag starts: Vector[Int]
  # Patch lists: parallel vectors frag_patch_state, frag_patch_slot, and frag_patch_offsets
  var frag_starts = Vector[Int]()
  var frag_patch_states = Vector[Vector[Int]]()
  var frag_patch_slots = Vector[Vector[Int]]()

  let post_len = post_kinds |> count
  var p_idx = 0
  while p_idx < post_len:
    let pk = post_kinds[p_idx]
    let pc = post_chars[p_idx]
    let pcl = post_classes[p_idx]
    let pn = post_negs[p_idx]

    if pk == 1 or pk == 2 or pk == 3 or pk == 4 or pk == 5:
      let s_id = st_kinds |> count
      var node_kind = KIND_CHAR()
      if pk == 2:
        node_kind = KIND_ANY()
      if pk == 3:
        node_kind = KIND_CLASS()
      if pk == 4:
        node_kind = KIND_ANCHOR_START()
      if pk == 5:
        node_kind = KIND_ANCHOR_END()


      push_int(st_kinds, node_kind)
      push_str(st_chars, pc)
      push_str(st_classes, pcl)
      push_bool(st_negs, pn)
      push_int(st_outs, 0 - 1)
      push_int(st_out1s, 0 - 1)

      frag_starts.push(s_id)
      var p_states = Vector[Int]()
      p_states.push(s_id)
      frag_patch_states.push(p_states)
      var p_slots = Vector[Int]()
      p_slots.push(0)
      frag_patch_slots.push(p_slots)
    else:
      if pk == 10: # CONCAT
        let f2_start = frag_starts.pop()
        let f2_states = frag_patch_states.pop()
        let f2_slots = frag_patch_slots.pop()

        let f1_start = frag_starts.pop()
        let f1_states = frag_patch_states.pop()
        let f1_slots = frag_patch_slots.pop()

        # Patch f1's dangling outs to f2_start
        let n_patch1 = f1_states |> count
        var pi = 0
        while pi < n_patch1:
          let ps = f1_states[pi]
          let pslot = f1_slots[pi]
          if pslot == 0:
            st_outs[ps] = f2_start
          else:
            st_out1s[ps] = f2_start
          pi = pi + 1

        frag_starts.push(f1_start)
        frag_patch_states.push(f2_states)
        frag_patch_slots.push(f2_slots)
      else:
        if pk == 11: # ALT (|)
          let f2_start = frag_starts.pop()
          let f2_states = frag_patch_states.pop()
          let f2_slots = frag_patch_slots.pop()

          let f1_start = frag_starts.pop()
          let f1_states = frag_patch_states.pop()
          let f1_slots = frag_patch_slots.pop()

          let s_id = st_kinds |> count
          push_int(st_kinds, KIND_SPLIT())
          push_str(st_chars, "")
          push_str(st_classes, "")
          push_bool(st_negs, false)
          push_int(st_outs, f1_start)
          push_int(st_out1s, f2_start)

          # Combine patch lists
          var merged_states = Vector[Int]()
          var merged_slots = Vector[Int]()
          var pi1 = 0
          while pi1 < (f1_states |> count):
            merged_states.push(f1_states[pi1])
            merged_slots.push(f1_slots[pi1])
            pi1 = pi1 + 1
          var pi2 = 0
          while pi2 < (f2_states |> count):
            merged_states.push(f2_states[pi2])
            merged_slots.push(f2_slots[pi2])
            pi2 = pi2 + 1

          frag_starts.push(s_id)
          frag_patch_states.push(merged_states)
          frag_patch_slots.push(merged_slots)
        else:
          if pk == 12: # STAR (*)
            let f_start = frag_starts.pop()
            let f_states = frag_patch_states.pop()
            let f_slots = frag_patch_slots.pop()

            let s_id = st_kinds |> count
            push_int(st_kinds, KIND_SPLIT())
            push_str(st_chars, "")
            push_str(st_classes, "")
            push_bool(st_negs, false)
            push_int(st_outs, f_start)
            push_int(st_out1s, 0 - 1)

            # Patch f dangling to s_id
            var pi = 0
            while pi < (f_states |> count):
              let ps = f_states[pi]
              let pslot = f_slots[pi]
              if pslot == 0:
                st_outs[ps] = s_id
              else:
                st_out1s[ps] = s_id
              pi = pi + 1

            frag_starts.push(s_id)
            var new_states = Vector[Int]()
            new_states.push(s_id)
            frag_patch_states.push(new_states)
            var new_slots = Vector[Int]()
            new_slots.push(1) # slot 1 is out1
            frag_patch_slots.push(new_slots)
          else:
            if pk == 13: # PLUS (+)
              let f_start = frag_starts.pop()
              let f_states = frag_patch_states.pop()
              let f_slots = frag_patch_slots.pop()

              let s_id = st_kinds |> count
              push_int(st_kinds, KIND_SPLIT())
              push_str(st_chars, "")
              push_str(st_classes, "")
              push_bool(st_negs, false)
              push_int(st_outs, f_start)
              push_int(st_out1s, 0 - 1)

              # Patch f dangling to s_id
              var pi = 0
              while pi < (f_states |> count):
                let ps = f_states[pi]
                let pslot = f_slots[pi]
                if pslot == 0:
                  st_outs[ps] = s_id
                else:
                  st_out1s[ps] = s_id
                pi = pi + 1

              frag_starts.push(f_start)
              var new_states = Vector[Int]()
              new_states.push(s_id)
              frag_patch_states.push(new_states)
              var new_slots = Vector[Int]()
              new_slots.push(1)
              frag_patch_slots.push(new_slots)
            else:
              if pk == 14: # QMARK (?)
                let f_start = frag_starts.pop()
                let f_states = frag_patch_states.pop()
                let f_slots = frag_patch_slots.pop()

                let s_id = st_kinds |> count
                push_int(st_kinds, KIND_SPLIT())
                push_str(st_chars, "")
                push_str(st_classes, "")
                push_bool(st_negs, false)
                push_int(st_outs, f_start)
                push_int(st_out1s, 0 - 1)

                var merged_states = Vector[Int]()
                var merged_slots = Vector[Int]()
                var pi = 0
                while pi < (f_states |> count):
                  merged_states.push(f_states[pi])
                  merged_slots.push(f_slots[pi])
                  pi = pi + 1
                merged_states.push(s_id)
                merged_slots.push(1)

                frag_starts.push(s_id)
                frag_patch_states.push(merged_states)
                frag_patch_slots.push(merged_slots)
    p_idx = p_idx + 1

  # Final match state
  let match_id = st_kinds |> count
  push_int(st_kinds, KIND_MATCH())
  push_str(st_chars, "")
  push_str(st_classes, "")
  push_bool(st_negs, false)
  push_int(st_outs, 0 - 1)
  push_int(st_out1s, 0 - 1)

  var start_state = match_id
  if (frag_starts |> count) > 0:
    start_state = frag_starts.pop()
    let fin_states = frag_patch_states.pop()
    let fin_slots = frag_patch_slots.pop()
    var pi = 0
    while pi < (fin_states |> count):
      let ps = fin_states[pi]
      let pslot = fin_slots[pi]
      if pslot == 0:
        st_outs[ps] = match_id
      else:
        st_out1s[ps] = match_id
      pi = pi + 1

  let total_states_count = st_kinds |> count
  if total_states_count > 512:
    raise RegexError.PatternTooComplex(state_count: total_states_count)
  return Regex(pattern: pattern, start_state: start_state, match_state: match_id, num_states: total_states_count, kinds: st_kinds, chars: st_chars, classes: st_classes, negs: st_negs, outs: st_outs, out1s: st_out1s)


# =========================================================================
# 3. Non-backtracking Thompson NFA Evaluator
# =========================================================================

fn compute_epsilon_closure(re: Regex, initial_states: Vector[Int], pos: Int, text_len: Int) -> Vector[Int]:
  var result = Vector[Int]()
  var visited = Vector[Bool]()
  var v_i = 0
  while v_i < re.num_states:
    visited.push(false)
    v_i = v_i + 1

  var worklist = Vector[Int]()
  var init_i = 0
  while init_i < (initial_states |> count):
    worklist.push(initial_states[init_i])
    init_i = init_i + 1

  while (worklist |> count) > 0:
    let st_id = worklist.pop()
    if st_id >= 0 and st_id < re.num_states:
      if not visited[st_id]:
        visited[st_id] = true
        result.push(st_id)
        let k = re.kinds[st_id]
        if k == 4: # SPLIT
          let o1 = re.outs[st_id]
          let o2 = re.out1s[st_id]
          if o1 >= 0:
            worklist.push(o1)
          if o2 >= 0:
            worklist.push(o2)
        else:
          if k == 5: # ANCHOR_START
            if pos == 0:
              let o = re.outs[st_id]
              if o >= 0:
                worklist.push(o)
          else:
            if k == 6: # ANCHOR_END
              if pos == text_len:
                let o = re.outs[st_id]
                if o >= 0:
                  worklist.push(o)


  return result

fn char_in_class(cls: String, ch: String) -> Bool:
  return cls.find(ch) >= 0

fn char_matches(ch1: String, ch2: String) -> Bool:
  return ch1 == ch2

# Match from start_idx up to end of text, returns longest matched end index (or -1 if no match)
fn run_nfa_from(re: Regex, chars_vec: Vector[String], start_idx: Int) -> Int:
  let text_len = chars_vec |> count
  var init_vec = Vector[Int]()
  init_vec.push(re.start_state)

  var current_states = compute_epsilon_closure(re, init_vec, start_idx, text_len)
  var best_end = 0 - 1

  # Check if empty match reaches match_state
  var cs_i = 0
  while cs_i < (current_states |> count):
    if current_states[cs_i] == re.match_state:
      best_end = start_idx
    cs_i = cs_i + 1

  var pos = start_idx
  while pos < text_len:
    var step_states = Vector[Int]()

    var s_idx = 0
    while s_idx < (current_states |> count):
      let st_id = current_states[s_idx]
      let k = re.kinds[st_id]
      var matched = false
      if k == 1:
        if char_matches(re.chars[st_id], chars_vec[pos]):
          matched = true
      else:
        if k == 2:
          if not (chars_vec[pos] == "\n"):
            matched = true
        else:
          if k == 3:
            let in_cls = char_in_class(re.classes[st_id], chars_vec[pos])
            if re.negs[st_id]:
              matched = not in_cls
            else:
              matched = in_cls


      if matched:
        let out_id = re.outs[st_id]
        if out_id >= 0:
          step_states.push(out_id)
      s_idx = s_idx + 1


    if (step_states |> count) == 0:
      return best_end

    current_states = compute_epsilon_closure(re, step_states, pos + 1, text_len)

    # Check if match reached
    var chk_i = 0
    while chk_i < (current_states |> count):
      if current_states[chk_i] == re.match_state:
        best_end = pos + 1
      chk_i = chk_i + 1

    pos = pos + 1

  return best_end

fn make_origins_vec(num_states: Int) -> Vector[Int]:
  var v = Vector[Int]()
  var i = 0
  while i < num_states:
    v.push(0 - 1)
    i = i + 1
  return v

# Single-pass unanchored Thompson NFA search with origin tracking
# Enforces leftmost-longest semantics without repeated NFA restarts
fn run_nfa_search_from(re: Regex, chars_vec: Vector[String], start_scan: Int) -> MatchResult:
  let text_len = chars_vec |> count
  var best_match_origin = 0 - 1
  var best_match_end = 0 - 1

  var active_states = Vector[Int]()
  var state_origins = make_origins_vec(re.num_states)

  var pos = start_scan
  while pos <= text_len:
    # 1. Inject start_state at pos if no match found yet
    # Leftmost rule: once best_match_origin is established, any new thread at pos >= best_match_origin cannot win
    if best_match_origin < 0:
      if state_origins[re.start_state] < 0:
        state_origins[re.start_state] = pos
        active_states.push(re.start_state)
      else:
        if pos < state_origins[re.start_state]:
          state_origins[re.start_state] = pos

    # 2. Epsilon closure on active_states
    var worklist = Vector[Int]()
    var ai = 0
    while ai < (active_states |> count):
      worklist.push(active_states[ai])
      ai = ai + 1

    while (worklist |> count) > 0:
      let st_id = worklist.pop()
      let s_orig = state_origins[st_id]
      let k = re.kinds[st_id]

      if k == 4: # SPLIT
        let o1 = re.outs[st_id]
        let o2 = re.out1s[st_id]
        if o1 >= 0:
          if state_origins[o1] < 0:
            state_origins[o1] = s_orig
            active_states.push(o1)
            worklist.push(o1)
          else:
            if s_orig < state_origins[o1]:
              state_origins[o1] = s_orig
              worklist.push(o1)
        if o2 >= 0:
          if state_origins[o2] < 0:
            state_origins[o2] = s_orig
            active_states.push(o2)
            worklist.push(o2)
          else:
            if s_orig < state_origins[o2]:
              state_origins[o2] = s_orig
              worklist.push(o2)
      else:
        if k == 5: # ANCHOR_START
          if pos == 0:
            let o = re.outs[st_id]
            if o >= 0:
              if state_origins[o] < 0:
                state_origins[o] = s_orig
                active_states.push(o)
                worklist.push(o)
              else:
                if s_orig < state_origins[o]:
                  state_origins[o] = s_orig
                  worklist.push(o)
        else:
          if k == 6: # ANCHOR_END
            if pos == text_len:
              let o = re.outs[st_id]
              if o >= 0:
                if state_origins[o] < 0:
                  state_origins[o] = s_orig
                  active_states.push(o)
                  worklist.push(o)
                else:
                  if s_orig < state_origins[o]:
                    state_origins[o] = s_orig
                    worklist.push(o)

    # 3. Check if match_state reached
    let m_orig = state_origins[re.match_state]
    if m_orig >= 0:
      if best_match_origin < 0:
        best_match_origin = m_orig
        best_match_end = pos
      else:
        if m_orig < best_match_origin:
          best_match_origin = m_orig
          best_match_end = pos
        else:
          if m_orig == best_match_origin:
            best_match_end = pos
      state_origins[re.match_state] = 0 - 1

    # 4. If we reached end of text, break
    if pos == text_len:
      pos = pos + 1
    else:
      # 5. Character transition on chars_vec[pos]
      var next_active_states = Vector[Int]()
      var next_state_origins = make_origins_vec(re.num_states)

      var si = 0
      while si < (active_states |> count):
        let st_id = active_states[si]
        let s_orig = state_origins[st_id]

        var should_advance = false
        if s_orig >= 0 and st_id != re.match_state:
          if best_match_origin < 0 or s_orig <= best_match_origin:
            should_advance = true

        if should_advance:
          let k = re.kinds[st_id]
          var matched = false
          if k == 1:
            if char_matches(re.chars[st_id], chars_vec[pos]):
              matched = true
          else:
            if k == 2:
              if not (chars_vec[pos] == "\n"):
                matched = true
            else:
              if k == 3:
                let in_cls = char_in_class(re.classes[st_id], chars_vec[pos])
                if re.negs[st_id]:
                  matched = not in_cls
                else:
                  matched = in_cls

          if matched:
            let out_id = re.outs[st_id]
            if out_id >= 0:
              if next_state_origins[out_id] < 0:
                next_state_origins[out_id] = s_orig
                next_active_states.push(out_id)
              else:
                if s_orig < next_state_origins[out_id]:
                  next_state_origins[out_id] = s_orig

        si = si + 1

      if best_match_origin >= 0 and (next_active_states |> count) == 0:
        return MatchResult.Matched(start: best_match_origin, end: best_match_end)

      active_states = next_active_states
      state_origins = next_state_origins
      pos = pos + 1

  if best_match_origin >= 0:
    return MatchResult.Matched(start: best_match_origin, end: best_match_end)
  return MatchResult.NoMatch

# =========================================================================
# 4. Public High-Level Matching API
# =========================================================================

export fn regex_search(re: Regex, text: String) -> MatchResult:
  let chars_vec = text.chars()
  return run_nfa_search_from(re, chars_vec, 0)

export fn is_match(pattern: String, text: String) -> Bool:
  let re = compile(pattern)
  return regex_is_match(re, text)

export fn regex_is_match(re: Regex, text: String) -> Bool:
  let res = regex_search(re, text)
  match res:
    case NoMatch:
      return false
    case Matched(start, end):
      return true

export fn regex_full_match(re: Regex, text: String) -> MatchResult:
  let chars_vec = text.chars()
  let n = chars_vec |> count
  let end_idx = run_nfa_from(re, chars_vec, 0)
  if end_idx == n:
    return MatchResult.Matched(start: 0, end: n)
  return MatchResult.NoMatch

export fn full_match(pattern: String, text: String) -> MatchResult:
  let re = compile(pattern)
  return regex_full_match(re, text)

export fn search(pattern: String, text: String) -> MatchResult:
  let re = compile(pattern)
  return regex_search(re, text)

export fn regex_find_all(re: Regex, text: String) -> Vector[MatchSpan]:
  var result = Vector[MatchSpan]()
  let chars_vec = text.chars()
  let n = chars_vec |> count
  var pos = 0
  while pos <= n:
    let match_res = run_nfa_search_from(re, chars_vec, pos)
    match match_res:
      case NoMatch:
        return result
      case Matched(start, end):
        let len_match = end - start
        let sub = text.slice(start, len_match)
        result.push(MatchSpan(start: start, end: end, text: sub))
        if end > start:
          pos = end
        else:
          pos = start + 1
  return result

export fn find_all(pattern: String, text: String) -> Vector[MatchSpan]:
  let re = compile(pattern)
  return regex_find_all(re, text)

export fn regex_replace_all(re: Regex, replacement: String, text: String) -> String:
  let spans = regex_find_all(re, text)
  let num_spans = spans |> count
  if num_spans == 0:
    return text

  var res = ""
  var cur_pos = 0
  var s_i = 0
  while s_i < num_spans:
    let span = spans[s_i]
    if span.start > cur_pos:
      res = res + text.slice(cur_pos, span.start - cur_pos)
    res = res + replacement
    cur_pos = span.end
    s_i = s_i + 1

  let total_len = text.length()
  if cur_pos < total_len:
    res = res + text.slice(cur_pos, total_len - cur_pos)
  return res

export fn replace_all(pattern: String, replacement: String, text: String) -> String:
  let re = compile(pattern)
  return regex_replace_all(re, replacement, text)

export fn regex_replace(re: Regex, replacement: String, text: String) -> String:
  let res = regex_search(re, text)
  match res:
    case NoMatch:
      return text
    case Matched(start, end):
      let prefix = text.slice(0, start)
      let suffix = text.slice(end, text.length() - end)
      return prefix + replacement + suffix


export fn replace(pattern: String, replacement: String, text: String) -> String:
  let re = compile(pattern)
  return regex_replace(re, replacement, text)

export fn regex_split(re: Regex, text: String) -> Vector[String]:
  var result = Vector[String]()
  let spans = regex_find_all(re, text)
  let num_spans = spans |> count
  if num_spans == 0:
    result.push(text)
    return result

  var cur_pos = 0
  var s_i = 0
  while s_i < num_spans:
    let span = spans[s_i]
    let part = text.slice(cur_pos, span.start - cur_pos)
    result.push(part)
    cur_pos = span.end
    s_i = s_i + 1

  let total_len = text.length()
  if cur_pos <= total_len:
    result.push(text.slice(cur_pos, total_len - cur_pos))
  return result

export fn split(pattern: String, text: String) -> Vector[String]:
  let re = compile(pattern)
  return regex_split(re, text)
