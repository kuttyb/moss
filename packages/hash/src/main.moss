module hash
import bytes

# Closed Phase 21 error enum
export enum HashError:
  InvalidByte(index: Int, value: Int)
  EmptyInput
  CorruptedState(message: String)

# Stateful Accumulators
export type Adler32:
  a: Int
  b: Int

export type Crc32:
  crc: Int

export type Fnv1a:
  hash: Int

export type Sha256:
  h0: Int
  h1: Int
  h2: Int
  h3: Int
  h4: Int
  h5: Int
  h6: Int
  h7: Int
  total_len: Int
  buffer: Vector[Int]

# Constants
fn MASK32() -> Int:
  return 4294967295

fn MOD_ADLER() -> Int:
  return 65521

fn FNV_OFFSET_BASIS() -> Int:
  return 2166136261

fn FNV_PRIME() -> Int:
  return 16777619

fn push_int(vec: Vector[Int], val: Int):
  vec.push(val)

fn clone_int_vec(v: Vector[Int]) -> Vector[Int]:
  var res = Vector[Int]()
  let n = v |> count
  var i = 0
  while i < n:
    res.push(v[i])
    i = i + 1
  return res

# Validate input bytes
fn validate_bytes(src: Vector[Int]):


  n = src |> count
  var i = 0
  while i < n:
    b = src[i]
    if not bytes.is_byte(b):
      raise HashError.InvalidByte(index: i, value: b)
    i = i + 1

# =========================================================================
# 1. Adler-32 (RFC 1950)
# =========================================================================

export fn new_adler32() -> Adler32:
  return Adler32(a: 1, b: 0)

export fn adler32_update(acc: Adler32, chunk: Vector[Int]):
  validate_bytes(chunk)
  n = chunk |> count
  var a = acc.a
  var b = acc.b
  var i = 0
  while i < n:
    a = (a + chunk[i]) % 65521
    b = (b + a) % 65521
    i = i + 1
  acc.a = a
  acc.b = b

export fn adler32_digest(acc: Adler32) -> Int:
  return ((acc.b << 16) | acc.a) & 4294967295

export fn adler32(src: Vector[Int]) -> Int:
  var acc = new_adler32()
  adler32_update(acc, src)
  return adler32_digest(acc)

# =========================================================================
# 2. CRC-32 (IEEE 802.3)
# =========================================================================

fn make_crc_table() -> Vector[Int]:
  var table = Vector[Int]()
  var byte_val = 0
  while byte_val < 256:
    var c = byte_val
    var bit = 0
    while bit < 8:
      if (c & 1) != 0:
        c = 3988292384 ^ ((c >> 1) & 2147483647)
      else:
        c = (c >> 1) & 2147483647
      bit = bit + 1
    table.push(c)
    byte_val = byte_val + 1
  return table

export fn new_crc32() -> Crc32:
  return Crc32(crc: 4294967295)

export fn crc32_update(acc: Crc32, chunk: Vector[Int]):
  validate_bytes(chunk)
  var table = make_crc_table()
  var crc = acc.crc
  n = chunk |> count
  var i = 0
  while i < n:
    idx = (crc ^ chunk[i]) & 255
    crc = table[idx] ^ ((crc >> 8) & 16777215)
    i = i + 1
  acc.crc = crc

export fn crc32_digest(acc: Crc32) -> Int:
  return (acc.crc ^ 4294967295) & 4294967295

export fn crc32(src: Vector[Int]) -> Int:
  var acc = new_crc32()
  crc32_update(acc, src)
  return crc32_digest(acc)

# =========================================================================
# 3. FNV-1a 32-bit
# =========================================================================

export fn new_fnv1a() -> Fnv1a:
  return Fnv1a(hash: 2166136261)

export fn fnv1a_update(acc: Fnv1a, chunk: Vector[Int]):
  validate_bytes(chunk)
  n = chunk |> count
  var h = acc.hash
  var i = 0
  while i < n:
    h = h ^ chunk[i]
    h = (h * 16777619) & 4294967295
    i = i + 1
  acc.hash = h

export fn fnv1a_digest(acc: Fnv1a) -> Int:
  return acc.hash & 4294967295

export fn fnv1a(src: Vector[Int]) -> Int:
  var acc = new_fnv1a()
  fnv1a_update(acc, src)
  return fnv1a_digest(acc)

# Helper to convert String to ASCII Vector[Int]
export fn string_to_bytes(s: String) -> Vector[Int]:
  var result = Vector[Int]()
  let chars_list = s.chars()
  let n = chars_list |> count
  let printable = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
  var i = 0
  while i < n:
    var b = 0
    let pos = printable.find(chars_list[i])
    if pos >= 0:
      b = pos + 32
    else:
      let ch = chars_list[i]
      if ch == "\n":
        b = 10
      if ch == "\r":
        b = 13
      if ch == "\t":
        b = 9
    result.push(b)
    i = i + 1

  return result


# =========================================================================
# 4. SHA-256 (NIST FIPS 180-4)
# =========================================================================

fn rotr(x: Int, n: Int) -> Int:
  return (((x >> n) & 4294967295) | ((x << (32 - n)) & 4294967295)) & 4294967295

fn ch_op(x: Int, y: Int, z: Int) -> Int:
  return ((x & y) ^ ((~x) & z)) & 4294967295

fn maj_op(x: Int, y: Int, z: Int) -> Int:
  return ((x & y) ^ (x & z) ^ (y & z)) & 4294967295

fn sigma0(x: Int) -> Int:
  return (rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22)) & 4294967295

fn sigma1(x: Int) -> Int:
  return (rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25)) & 4294967295

fn gamma0(x: Int) -> Int:
  return (rotr(x, 7) ^ rotr(x, 18) ^ ((x >> 3) & 536870911)) & 4294967295

fn gamma1(x: Int) -> Int:
  return (rotr(x, 17) ^ rotr(x, 19) ^ ((x >> 10) & 4194303)) & 4294967295

