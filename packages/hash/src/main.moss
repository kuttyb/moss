export fn new_sha256() -> Sha256:
  return Sha256(h0: 1779033703, h1: 3144134277, h2: 1013904242, h3: 2773480762, h4: 1359893119, h5: 2600822924, h6: 528734635, h7: 1541459225, total_len: 0, buffer: Vector[Int]())


fn sha256_process_block(acc: Sha256, block: Vector[Int]):
  var w = Vector[Int]()
  var t = 0
  while t < 16:
    j = t * 4
    word = ((block[j] << 24) | (block[j + 1] << 16) | (block[j + 2] << 8) | block[j + 3]) & 4294967295
    w.push(word)
    t = t + 1
  while t < 64:
    w15 = w[t - 15]
    w2 = w[t - 2]
    w16 = w[t - 16]
    w7 = w[t - 7]
    word = (gamma1(w2) + w7 + gamma0(w15) + w16) & 4294967295
    w.push(word)
    t = t + 1

  var a = acc.h0
  var b = acc.h1
  var c = acc.h2
  var d = acc.h3
  var e = acc.h4
  var f = acc.h5
  var g = acc.h6
  var h = acc.h7
  var k = sha256_k_constants()

  var i = 0
  while i < 64:
    t1 = (h + sigma1(e) + ch_op(e, f, g) + k[i] + w[i]) & 4294967295
    t2 = (sigma0(a) + maj_op(a, b, c)) & 4294967295
    h = g
    g = f
    f = e
    e = (d + t1) & 4294967295
    d = c
    c = b
    b = a
    a = (t1 + t2) & 4294967295
    i = i + 1

  acc.h0 = (acc.h0 + a) & 4294967295
  acc.h1 = (acc.h1 + b) & 4294967295
  acc.h2 = (acc.h2 + c) & 4294967295
  acc.h3 = (acc.h3 + d) & 4294967295
  acc.h4 = (acc.h4 + e) & 4294967295
  acc.h5 = (acc.h5 + f) & 4294967295
  acc.h6 = (acc.h6 + g) & 4294967295
  acc.h7 = (acc.h7 + h) & 4294967295

export fn sha256_update(acc: Sha256, chunk: Vector[Int]):
  validate_bytes(chunk)
  n = chunk |> count
  acc.total_len = acc.total_len + n
  var i = 0
  while i < n:
    push_int(acc.buffer, chunk[i])
    if (acc.buffer |> count) == 64:
      var blk = clone_int_vec(acc.buffer)
      acc.buffer = Vector[Int]()
      sha256_process_block(acc, blk)
    i = i + 1



export fn sha256_digest(acc: Sha256) -> Vector[Int]:
  # Finalize padding into temporary buffer
  var final_buf = Vector[Int]()
  buf_len = acc.buffer |> count
  var i = 0
  while i < buf_len:
    final_buf.push(acc.buffer[i])
    i = i + 1
  # append 0x80
  final_buf.push(128)
  while ((final_buf |> count) % 64) != 56:
    final_buf.push(0)
  # append 64-bit length in bits (big-endian)
  total_bits = acc.total_len * 8
  final_buf.push(((total_bits >> 56) & 255))
  final_buf.push(((total_bits >> 48) & 255))
  final_buf.push(((total_bits >> 40) & 255))
  final_buf.push(((total_bits >> 32) & 255))
  final_buf.push(((total_bits >> 24) & 255))
  final_buf.push(((total_bits >> 16) & 255))
  final_buf.push(((total_bits >> 8) & 255))
  final_buf.push((total_bits & 255))

  total_final = final_buf |> count
  var b_idx = 0
  while b_idx < total_final:
    var blk = Vector[Int]()
    var j = 0
    while j < 64:
      blk.push(final_buf[b_idx + j])
      j = j + 1
    sha256_process_block(acc, blk)
    b_idx = b_idx + 64

  var digest = Vector[Int]()
  var h_vals = Vector[Int]()
  h_vals.push(acc.h0)
  h_vals.push(acc.h1)
  h_vals.push(acc.h2)
  h_vals.push(acc.h3)
  h_vals.push(acc.h4)
  h_vals.push(acc.h5)
  h_vals.push(acc.h6)
  h_vals.push(acc.h7)
  var w_idx = 0
  while w_idx < 8:
    word = h_vals[w_idx]
    digest.push(((word >> 24) & 255))
    digest.push(((word >> 16) & 255))
    digest.push(((word >> 8) & 255))
    digest.push((word & 255))
    w_idx = w_idx + 1
  return digest

fn byte_to_hex(b: Int) -> String:
  var hex_chars = Vector[String]()
  hex_chars.push("0")
  hex_chars.push("1")
  hex_chars.push("2")
  hex_chars.push("3")
  hex_chars.push("4")
  hex_chars.push("5")
  hex_chars.push("6")
  hex_chars.push("7")
  hex_chars.push("8")
  hex_chars.push("9")
  hex_chars.push("a")
  hex_chars.push("b")
  hex_chars.push("c")
  hex_chars.push("d")
  hex_chars.push("e")
  hex_chars.push("f")

  hi = (b >> 4) & 15
  lo = b & 15
  return hex_chars[hi] + hex_chars[lo]

export fn sha256_hexdigest(acc: Sha256) -> String:
  digest_bytes = sha256_digest(acc)
  var result = ""
  n = digest_bytes |> count
  var i = 0
  while i < n:
    result = result + byte_to_hex(digest_bytes[i])
    i = i + 1
  return result

export fn sha256(src: Vector[Int]) -> Vector[Int]:
  var acc = new_sha256()
  sha256_update(acc, src)
  return sha256_digest(acc)

export fn sha256_hex(src: Vector[Int]) -> String:
  var acc = new_sha256()
  sha256_update(acc, src)
  return sha256_hexdigest(acc)
