# ============================================================================
# Moss Phase 24 — Tests for moss.random (MRG32k3a)
# ============================================================================

import random

test "mrg32k3a determinism and repeatability":
  var rng1 = random.new_rng(42)
  var rng2 = random.new_rng(42)

  v1 = random.rng_next_int(rng1)
  v2 = random.rng_next_int(rng2)
  assertEqual(v1, v2)

  f1 = random.rng_next_float(rng1)
  f2 = random.rng_next_float(rng2)
  assertEqual(f1, f2)

  b1 = random.rng_randbool(rng1)
  b2 = random.rng_randbool(rng2)
  assertEqual(b1, b2)

test "boundary seed initialization safety":
  # Must not overflow on INT64_MAX, INT64_MIN, or 0
  var rng_max = random.new_rng(9223372036854775807)
  val_max = random.rng_next_float(rng_max)
  assertEqual(val_max > 0.0 and val_max < 1.0, true)

  var rng_min = random.new_rng(-9223372036854775808)
  val_min = random.rng_next_float(rng_min)
  assertEqual(val_min > 0.0 and val_min < 1.0, true)

  var rng_zero = random.new_rng(0)
  val_zero = random.rng_next_float(rng_zero)
  assertEqual(val_zero > 0.0 and val_zero < 1.0, true)

test "randint large range and exact boundary test":
  var rng = random.new_rng(12345)
  # Test the exact boundary that previously caused an infinite rejection loop:
  val_boundary = random.rng_randint(rng, 0, 4294967086)
  assertEqual(val_boundary >= 0, true)
  assertEqual(val_boundary <= 4294967086, true)

  # Test multi-draw range larger than one draw:
  val_large = random.rng_randint(rng, 0, 10000000000)
  assertEqual(val_large >= 0, true)
  assertEqual(val_large <= 10000000000, true)

test "empty collection safe fallback":
  var rng = random.new_rng(999)
  empty_vec = Vector[Int]()
  c = random.choice(empty_vec, rng)
  assertEqual(c, 0)

  shuffled_empty = random.shuffle(empty_vec, rng)
  assertEqual(shuffled_empty |> count, 0)

test "long deterministic sequence consistency":
  var rng = random.new_rng(314159)
  var sum = 0.0
  var i = 0
  while i < 1000:
    sum = sum + random.rng_next_float(rng)
    i = i + 1
  # Average of 1000 uniform (0, 1) floats should be between 450 and 550
  assertEqual(sum > 450.0 and sum < 550.0, true)
