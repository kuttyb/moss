module random

# ============================================================================
# Moss Phase 24 — Package B: moss.random
# High-quality deterministic pseudorandom number generator SDK (MRG32k3a).
#
# Algorithm: MRG32k3a (Pierre L'Ecuyer, 1999)
# Combines two 3rd-order multiple recursive generators using pure integer
# modulo arithmetic. Period: ~ 2^191 (~ 3.1 x 10^57).
#
# SECURITY NOTICE:
# moss.random is an algorithmic pseudo-random number generator designed for
# simulations, randomized algorithms, and testing. It is NOT cryptographically
# secure and MUST NOT be used for keys, tokens, or security credentials.
# ============================================================================

export type Rng:
  x1: Int
  x2: Int
  x3: Int
  y1: Int
  y2: Int
  y3: Int

  fn next_step() -> Int:
    # Recurrence 1: x_n = (1403580 * x_{n-2} - 810728 * x_{n-3}) mod 4294967087
    var p1 = (1403580 * x2 - 810728 * x3) % 4294967087
    if p1 < 0:
      p1 = p1 + 4294967087

    # Recurrence 2: y_n = (527612 * y_{n-1} - 1370589 * y_{n-3}) mod 4294944443
    var p2 = (527612 * y1 - 1370589 * y3) % 4294944443
    if p2 < 0:
      p2 = p2 + 4294944443

    # Shift state
    x3 = x2
    x2 = x1
    x1 = p1

    y3 = y2
    y2 = y1
    y1 = p2

    # Combination: z_n = (p1 - p2) mod 4294967087
    # Yields z in [1, 4294967086]
    var z = (p1 - p2) % 4294967087
    if z <= 0:
      z = z + 4294967087
    return z

  fn next_float() -> Float:
    z = next_step()
    return (z * 1.0) / 4294967088.0

  fn next_int() -> Int:
    return next_step()

  # Bounded integer generation with unbiased rejection sampling.
  # Handles small ranges (<= 4294967086) via single draw and large ranges
  # (> 4294967086) via combined multiple draws without 64-bit integer overflow.
  fn randint(min: Int, max: Int) -> Int:
    if min >= max:
      return min
    range_size = max - min + 1
    let m = 4294967086

    if range_size <= m:
      # Single draw rejection sampling
      limit = m - (m % range_size)
      var u = next_step() - 1
      while u >= limit:
        u = next_step() - 1
      return min + (u % range_size)
    else:
      # Multiple draw for large ranges up to 9.22e18 without Int64 overflow
      # u1 in [0, 2147483543], u2 in [0, 4294967085]
      let m_half = 2147483543
      let total_outcomes = (m_half + 1) * m
      limit = total_outcomes - (total_outcomes % range_size)
      var v = ((next_step() - 1) / 2) * m + (next_step() - 1)
      while v >= limit:
        v = ((next_step() - 1) / 2) * m + (next_step() - 1)
      return min + (v % range_size)

  fn randbool() -> Bool:
    return next_float() < 0.5

# ----------------------------------------------------------------------------
# Factory constructor
# Safe against arbitrary 64-bit seeds (INT64_MIN, INT64_MAX, negative, 0).
# ----------------------------------------------------------------------------

export fn new_rng(seed: Int) -> Rng:
  let m1 = 4294967086
  let m2 = 4294944442
  var s = seed % m1
  if s < 0:
    s = s + m1
  if s == 0:
    s = 123456789

  var rx1 = (s * 10007) % m1 + 1
  var rx2 = (s * 20011) % m1 + 1
  var rx3 = (s * 30013) % m1 + 1
  var ry1 = (s * 40009) % m2 + 1
  var ry2 = (s * 50021) % m2 + 1
  var ry3 = (s * 60017) % m2 + 1
  return Rng(x1 = rx1, x2 = rx2, x3 = rx3, y1 = ry1, y2 = ry2, y3 = ry3)

# ----------------------------------------------------------------------------
# Exported helper functions for module callers
# ----------------------------------------------------------------------------

export fn rng_next_int(rng: Rng) -> Int:
  return rng.next_int()

export fn rng_next_float(rng: Rng) -> Float:
  return rng.next_float()

export fn rng_randint(rng: Rng, min: Int, max: Int) -> Int:
  return rng.randint(min, max)

export fn rng_randbool(rng: Rng) -> Bool:
  return rng.randbool()

export fn uniform(rng: Rng, low: Float, high: Float) -> Float:
  if low >= high:
    return low
  f = rng.next_float()
  return low + (high - low) * f

# Safe choice with empty-collection fallback
export fn choice(items: Vector[Int], rng: Rng) -> Int:
  cnt = items |> count
  if cnt == 0:
    return 0
  idx = rng.randint(0, cnt - 1)
  return items[idx]

# Fisher-Yates shuffle with empty/single-element safety
export fn shuffle(items: Vector[Int], rng: Rng) -> Vector[Int]:
  var result = Vector[Int]()
  for item in items:
    result.push(item)
  n = result |> count
  if n <= 1:
    return result
  var i = n - 1
  while i > 0:
    j = rng.randint(0, i)
    temp = result[i]
    result[i] = result[j]
    result[j] = temp
    i = i - 1
  return result
