# Exact cardinality lets -O replace count with len. The pure map is dead when
# only its count is requested. Pure any/all terminals may also short-circuit.
fn double(value: Int) -> Int:
  return value * 2

proc main():
  values = [1, 2, 3, 4]
  direct_count = values |> count
  mapped_count = values |> map(double) |> count
  has_one = values |> any(_ == 1)
  all_positive = values |> all(_ > 0)
  echo "terminal plans:", direct_count, mapped_count, has_one, all_positive
