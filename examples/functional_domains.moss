# Functional callbacks obey the same explicit domain rules as ordinary code.
# A message through a declared route is an eager fusion barrier.
domain Source:
  value = 7

  fn Read(unused: Int) -> Int:
    reply value

domain Sink:
  stored = 0

  fn Store(value: Int):
    stored = value

  fn Stored() -> Int:
    reply stored

domain Batch:
  domainroutes(source: Source)

  fn Total() -> Int:
    values = [0, 0]
    total = values |> map(message source.Read(_)) |> sum
    reply total

proc main():
  first = Source()
  batch = Batch(source: first)
  sink = Sink()
  total = message batch.Total()

  # A terminal is a concrete scalar and can cross a message boundary normally.
  message sink.Store(total)
  observed = message sink.Stored()
  echo "domain-backed total:", observed
