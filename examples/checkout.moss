domain Inventory:
  available = 10

  fn Reserve(quantity: int) -> bool:
    if available >= quantity:
      available = available - quantity
      reply true
    reply false

domain Payments:
  collected: Int = 0

  fn Charge(amount: int) -> bool:
    collected = collected + amount
    echo "charged:", amount
    reply true

domain Checkout:
  fn PlaceOrder(inventory: Inventory, payments: Payments, quantity: int, price: int):
    let reserved = await inventory.Reserve(quantity)
    if not reserved:
      echo "order rejected: insufficient inventory"
      return

    let paid = await payments.Charge(quantity * price)
    if paid:
      echo "order completed"
    else:
      echo "payment failed"

fn main():
  let inventory = spawn Inventory()
  let payments = spawn Payments()
  let checkout = spawn Checkout()
  message checkout.PlaceOrder(inventory, payments, 3, 25)
  message checkout.PlaceOrder(inventory, payments, 8, 25)
