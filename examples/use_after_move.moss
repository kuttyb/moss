# This is an intentional negative example for a provisional compiler behavior.
# Moss assignment semantics are not settled; see .codex/MOSS_DESIGN.md.

type Payload = object
  text: string

domain OwnershipDemo
  on Trigger()
    let original = Payload(text: "owned value")
    let moved = original
    echo "moved:", moved.text
    echo "original:", original.text

proc main()
  let demo = spawn OwnershipDemo()
  demo.Trigger()
