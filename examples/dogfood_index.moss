# A tiny in-memory index summary: counts and totals can evolve independently.
# Try extending it with a richer record type during Phase 15 dogfooding.
domain Index:
  count: Int
  total: Int
  fn Insert(value: Int):
    count = count + 1
    total = total + value
  fn Count() -> Int:
    reply count
  fn Total() -> Int:
    reply total

fn main():
  index = Index(count: 0, total: 0)
  i = 0
  while i < 40:
    message index.Insert(i)
    i = i + 1
  echo message index.Count(), message index.Total()
