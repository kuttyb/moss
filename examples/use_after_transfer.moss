# This is an intentional negative example for the approved transfer rule.
# A direct assignment transfers the owned value; the later source use is invalid.

type Payload:
  text: string

domain OwnershipDemo:
  fn Trigger():
    let original = Payload(text: "owned value")
    let destination = original
    echo "destination:", destination.text
    echo "original:", original.text

fn main():
  let demo = spawn OwnershipDemo()
  message demo.Trigger()
