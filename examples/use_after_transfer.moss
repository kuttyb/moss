type Payload:
  text: string

fn consume_payload(p: Payload) -> Payload:
  return p

domain OwnershipDemo:
  fn Trigger():
    let original = Payload(text: "owned value")
    let destination = original
    consume_payload(destination)
    echo "original:", original.text

fn main():
  let demo = OwnershipDemo()
  message demo.Trigger()
