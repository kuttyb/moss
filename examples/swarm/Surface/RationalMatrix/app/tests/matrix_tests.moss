module app_matrix_tests
import rational
import matrix

test "identity is neutral for mul":
  b = matrix.from_ints(3, [2, 0, 1, 1, 3, 2, 1, 1, 2])
  i3 = matrix.identity(3)
  assert(matrix.equal(matrix.mul(b, i3), b))
  assert(matrix.equal(matrix.mul(i3, b), b))

test "transpose of transpose is original":
  b = matrix.from_ints(3, [1, 2, 3, 4, 5, 6, 7, 8, 10])
  assert(matrix.equal(matrix.transpose(matrix.transpose(b)), b))
  t = matrix.transpose(b)
  assert(rational.eq(matrix.get(t, 0, 1), rational.from_int(4)))

test "det2 matches general determinant":
  a = matrix.mat2(rational.make(1, 2), rational.make(2, 3), rational.make(3, 4), rational.make(4, 5))
  assert(rational.eq(matrix.det2(a), rational.make(0 - 1, 10)))
  assert(rational.eq(matrix.determinant(a), matrix.det2(a)))

test "determinant is multiplicative":
  b = matrix.from_ints(3, [2, 0, 1, 1, 3, 2, 1, 1, 2])
  c = matrix.from_ints(3, [1, 1, 0, 0, 1, 1, 1, 0, 1])
  lhs = matrix.determinant(matrix.mul(b, c))
  rhs = rational.mul(matrix.determinant(b), matrix.determinant(c))
  assert(rational.eq(lhs, rhs))
  assert(rational.eq(matrix.determinant(b), rational.from_int(6)))

test "determinant needs pivot swap and detects singular":
  p = matrix.from_ints(3, [0, 1, 2, 1, 0, 3, 4, 5, 6])
  assert(rational.eq(matrix.determinant(p), rational.from_int(16)))
  s = matrix.from_ints(3, [1, 2, 3, 2, 4, 6, 7, 8, 9])
  assert(rational.eq(matrix.determinant(s), rational.from_int(0)))

test "identity determinant is one":
  assert(rational.eq(matrix.determinant(matrix.identity(4)), rational.from_int(1)))
