# ExprEval: tokenize, shunting-yard to RPN, evaluate RPN.
#
# Input is a Vector[String] of single-character strings because Moss v0.1
# exposes no way to index, iterate, or measure a String (see README).

type Num:
  is_float: Bool
  i: Int
  f: Float

type Token:
  kind: String
  op: String
  value: Num

type Lexed:
  ok: Bool
  tokens: Vector[Token]
  error: String

type Rpn:
  ok: Bool
  tokens: Vector[Token]
  error: String

type Outcome:
  ok: Bool
  value: Num
  error: String

# `if (v |> count) == 0:` breaks moss fmt (see README), so wrap count.
fn size(v) -> Int:
  return v |> count

fn int_num(v: Int) -> Num:
  return Num(is_float: false, i: v, f: 0.0)

fn float_num(v: Float) -> Num:
  return Num(is_float: true, i: 0, f: v)

fn fail(message: String) -> Outcome:
  return Outcome(ok: false, value: int_num(0), error: message)

fn succeed(n: Num) -> Outcome:
  return Outcome(ok: true, value: n, error: "")

fn digit_value(c: String) -> Int:
  if c == "0":
    return 0
  if c == "1":
    return 1
  if c == "2":
    return 2
  if c == "3":
    return 3
  if c == "4":
    return 4
  if c == "5":
    return 5
  if c == "6":
    return 6
  if c == "7":
    return 7
  if c == "8":
    return 8
  if c == "9":
    return 9
  # `return -1` breaks moss fmt (see README)
  return 0 - 1

fn digit_float(d: Int) -> Float:
  if d == 1:
    return 1.0
  if d == 2:
    return 2.0
  if d == 3:
    return 3.0
  if d == 4:
    return 4.0
  if d == 5:
    return 5.0
  if d == 6:
    return 6.0
  if d == 7:
    return 7.0
  if d == 8:
    return 8.0
  if d == 9:
    return 9.0
  return 0.0

# Int -> Float without a conversion builtin: accumulate decimal digits.
fn int_to_float(n: Int) -> Float:
  var m = n
  negative = n < 0
  if negative:
    m = 0 - n
  var acc = 0.0
  var place = 1.0
  while m > 0:
    acc = acc + digit_float(m % 10) * place
    place = place * 10.0
    m = m / 10
  if negative:
    return 0.0 - acc
  return acc

# Field-wise copy: binding an element of a Vector[Token] would consume the vector.
fn copy_num(n: Num) -> Num:
  return Num(is_float: n.is_float, i: n.i, f: n.f)

fn as_float(n: Num) -> Float:
  if n.is_float:
    return n.f
  return int_to_float(n.i)

# `and`/`or` are not usable here (see README), so boolean chains are ifs.
fn is_operator_char(c: String) -> Bool:
  if c == "+":
    return true
  if c == "-":
    return true
  if c == "*":
    return true
  if c == "/":
    return true
  if c == "%":
    return true
  return false

fn starts_number(c: String) -> Bool:
  if c == ".":
    return true
  return digit_value(c) >= 0

fn op_token(op: String) -> Token:
  return Token(kind: "op", op: op, value: int_num(0))

fn paren_token(kind: String) -> Token:
  return Token(kind: kind, op: "", value: int_num(0))

fn lex_fail(message: String) -> Lexed:
  return Lexed(ok: false, tokens: Vector[Token](), error: message)

fn tokenize(chars: Vector[String]) -> Lexed:
  var tokens = Vector[Token]()
  n = chars |> count
  var i = 0
  # true when the next token must be an operand (start, after op or "(")
  var expect_operand = true
  while i < n:
    if chars[i] == " ":
      i = i + 1
    else:
      if starts_number(chars[i]):
        var int_part = 0
        var frac = 0.0
        var scale = 1.0
        var seen_dot = false
        var digits = 0
        var scanning = true
        while scanning:
          if i >= n:
            scanning = false
          else:
            d = digit_value(chars[i])
            if d >= 0:
              digits = digits + 1
              if seen_dot:
                scale = scale / 10.0
                frac = frac + digit_float(d) * scale
              else:
                int_part = int_part * 10 + d
              i = i + 1
            else:
              if chars[i] != ".":
                scanning = false
              else:
                if seen_dot:
                  return lex_fail("malformed number")
                seen_dot = true
                i = i + 1
        if digits == 0:
          return lex_fail("malformed number")
        if seen_dot:
          tokens.push(Token(kind: "num", op: "", value: float_num(int_to_float(int_part) + frac)))
        else:
          tokens.push(Token(kind: "num", op: "", value: int_num(int_part)))
        expect_operand = false
      else:
        if is_operator_char(chars[i]):
          if expect_operand:
            if chars[i] == "-":
              tokens.push(op_token("neg"))
            else:
              return lex_fail("unexpected operator")
          else:
            tokens.push(op_token(chars[i]))
            expect_operand = true
          i = i + 1
        else:
          if chars[i] == "(":
            tokens.push(paren_token("lparen"))
            expect_operand = true
            i = i + 1
          else:
            if chars[i] == ")":
              tokens.push(paren_token("rparen"))
              expect_operand = false
              i = i + 1
            else:
              return lex_fail("unexpected character")
  return Lexed(ok: true, tokens: tokens, error: "")

fn precedence(op: String) -> Int:
  if op == "neg":
    return 3
  if op == "+":
    return 1
  if op == "-":
    return 1
  # "*", "/", "%"
  return 2

fn rpn_fail(message: String) -> Rpn:
  return Rpn(ok: false, tokens: Vector[Token](), error: message)

# Shunting-yard. Also validates operand/operator alternation and parens.
# Indexing a Vector[Token] (`tokens[k].kind`) fails native lowering and binding
# `tokens[k]` consumes the vector, so tokens are consumed as a stream: reverse
# once, then pop() owned tokens in source order (see README).
fn reversed(v: Vector[Token]) -> Vector[Token]:
  var src = v
  var out = Vector[Token]()
  while size(src) > 0:
    out.push(src.pop())
  return out

fn to_rpn(tokens: Vector[Token]) -> Rpn:
  var output = Vector[Token]()
  var ops = Vector[String]()
  if size(tokens) == 0:
    return rpn_fail("empty expression")
  var stream = reversed(tokens)
  var expect_operand = true
  while size(stream) > 0:
    t = stream.pop()
    if t.kind == "num":
      if not expect_operand:
        return rpn_fail("missing operator")
      output.push(Token(kind: "num", op: "", value: t.value))
      expect_operand = false
    else:
      if t.kind == "lparen":
        if not expect_operand:
          return rpn_fail("missing operator before (")
        ops.push("(")
      else:
        if t.kind == "rparen":
          if expect_operand:
            return rpn_fail("missing operand before )")
          var matched = false
          while not matched:
            if size(ops) == 0:
              return rpn_fail("unbalanced parentheses")
            top = ops.pop()
            if top == "(":
              matched = true
            else:
              output.push(op_token(top))
        else:
          if t.op == "neg":
            # prefix unary: never pops anything
            ops.push(t.op)
          else:
            if expect_operand:
              return rpn_fail("missing operand")
            p = precedence(t.op)
            var popping = true
            while popping:
              if size(ops) == 0:
                popping = false
              else:
                top = ops.pop()
                if top == "(":
                  ops.push(top)
                  popping = false
                else:
                  if precedence(top) >= p:
                    output.push(op_token(top))
                  else:
                    ops.push(top)
                    popping = false
            ops.push(t.op)
            expect_operand = true
  if expect_operand:
    return rpn_fail("trailing operator")
  while size(ops) > 0:
    top = ops.pop()
    if top == "(":
      return rpn_fail("unbalanced parentheses")
    output.push(op_token(top))
  return Rpn(ok: true, tokens: output, error: "")

fn either_float(a: Num, b: Num) -> Bool:
  if a.is_float:
    return true
  return b.is_float

fn apply_binary(op: String, a: Num, b: Num) -> Outcome:
  if not either_float(a, b):
    x = a.i
    y = b.i
    if op == "+":
      return succeed(int_num(x + y))
    if op == "-":
      return succeed(int_num(x - y))
    if op == "*":
      return succeed(int_num(x * y))
    if y == 0:
      return fail("division by zero")
    if op == "/":
      return succeed(int_num(x / y))
    return succeed(int_num(x % y))
  if op == "%":
    return fail("% requires Int operands")
  x = as_float(a)
  y = as_float(b)
  if op == "+":
    return succeed(float_num(x + y))
  if op == "-":
    return succeed(float_num(x - y))
  if op == "*":
    return succeed(float_num(x * y))
  if y == 0.0:
    return fail("division by zero")
  return succeed(float_num(x / y))

fn negated(a: Num) -> Num:
  if a.is_float:
    return float_num(0.0 - a.f)
  return int_num(0 - a.i)

fn eval_rpn(rpn: Vector[Token]) -> Outcome:
  var stack = Vector[Num]()
  var stream = reversed(rpn)
  while size(stream) > 0:
    t = stream.pop()
    if t.kind == "num":
      stack.push(t.value)
    else:
      op = t.op
      if op == "neg":
        if size(stack) < 1:
          return fail("stack underflow")
        a = stack.pop()
        stack.push(negated(a))
      else:
        if size(stack) < 2:
          return fail("stack underflow")
        b = stack.pop()
        a = stack.pop()
        r = apply_binary(op, a, b)
        # if/else, not an early-return guard: see TENSION "guard return consume"
        if not r.ok:
          return r
        else:
          stack.push(r.value)
  if size(stack) != 1:
    return fail("malformed expression")
  return succeed(stack.pop())

fn evaluate(chars: Vector[String]) -> Outcome:
  lexed = tokenize(chars)
  if not lexed.ok:
    return fail(lexed.error)
  else:
    rpn = to_rpn(lexed.tokens)
    if not rpn.ok:
      return fail(rpn.error)
    else:
      return eval_rpn(rpn.tokens)

fn show(label: String, chars: Vector[String]):
  r = evaluate(chars)
  if not r.ok:
    echo label, "=> error:", r.error
  else:
    if r.value.is_float:
      echo label, "=>", r.value.f
    else:
      echo label, "=>", r.value.i

fn main():
  show("3 + 4 * (2 - 1)", ["3", " ", "+", " ", "4", " ", "*", " ", "(", "2", " ", "-", " ", "1", ")"])
  show("-(5 - 8) / 2", ["-", "(", "5", " ", "-", " ", "8", ")", " ", "/", " ", "2"])
  show("-(5.0 - 8) / 2", ["-", "(", "5", ".", "0", " ", "-", " ", "8", ")", " ", "/", " ", "2"])
  show("17 % 5 * 2", ["1", "7", " ", "%", " ", "5", " ", "*", " ", "2"])
  show("(1 + 2", ["(", "1", " ", "+", " ", "2"])
  show("1 +", ["1", " ", "+"])
  show("", Vector[String]())

test "precedence and parentheses":
  r = evaluate(["3", "+", "4", "*", "(", "2", "-", "1", ")"])
  assert(r.ok)
  assertEqual(r.value.i, 7)

test "unary minus with int division":
  r = evaluate(["-", "(", "5", "-", "8", ")", "/", "2"])
  assert(r.ok)
  assert(not r.value.is_float)
  assertEqual(r.value.i, 1)

test "float literal promotes arithmetic":
  r = evaluate(["-", "(", "5", ".", "0", "-", "8", ")", "/", "2"])
  assert(r.ok)
  assert(r.value.is_float)
  assertEqual(r.value.f, 1.5)

test "remainder and left associativity":
  r = evaluate(["1", "7", "%", "5", "*", "2"])
  assertEqual(r.value.i, 4)
  s = evaluate(["1", "0", "-", "3", "-", "2"])
  assertEqual(s.value.i, 5)

test "double unary minus":
  r = evaluate(["-", "-", "4", "*", "2"])
  assert(r.ok)
  assertEqual(r.value.i, 8)

test "rejects unbalanced parentheses":
  a = evaluate(["(", "1", "+", "2"])
  assert(not a.ok)
  assertEqual(a.error, "unbalanced parentheses")
  b = evaluate(["1", "+", "2", ")"])
  assert(not b.ok)
  assertEqual(b.error, "unbalanced parentheses")

test "rejects trailing operator":
  r = evaluate(["1", " ", "+"])
  assert(not r.ok)
  assertEqual(r.error, "trailing operator")

test "rejects empty input":
  r = evaluate(Vector[String]())
  assertEqual(r.error, "empty expression")
  s = evaluate([" ", " "])
  assertEqual(s.error, "empty expression")

test "rejects division by zero and float remainder":
  a = evaluate(["1", "/", "0"])
  assertEqual(a.error, "division by zero")
  b = evaluate(["1", ".", "5", "%", "2"])
  assertEqual(b.error, "% requires Int operands")
