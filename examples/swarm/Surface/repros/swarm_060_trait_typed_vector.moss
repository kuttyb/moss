trait Shape:
  fn area() -> Float

type Circle:
  radius: Float

  fn area() -> Float:
    return 3.0 * radius * radius

type Square:
  side: Float

  fn area() -> Float:
    return side * side

fn main():
  var shapes = Vector[Shape]()
  shapes.push(Circle(radius: 1.0))
  shapes.push(Square(side: 2.0))
  echo shapes |> count
