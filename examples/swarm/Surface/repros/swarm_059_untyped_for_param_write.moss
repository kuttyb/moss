type Sq:
  side: Float

  fn area() -> Float:
    return side * side

type Ci:
  r: Float

  fn area() -> Float:
    return 3.0 * r * r

fn total_area(shapes) -> Float:
  var acc = 0.0
  for s in shapes:
    acc = acc + s.area()
  return acc

type Scene:
  squares: Vector[Sq]
  circles: Vector[Ci]

  fn total() -> Float:
    return total_area(squares) + total_area(circles)

fn main():
  sc = Scene(squares: [Sq(side: 2.0)], circles: [Ci(r: 1.0)])
  echo sc.total()
