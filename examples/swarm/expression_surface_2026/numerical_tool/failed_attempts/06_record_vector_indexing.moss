# The natural record-vector peak search. Indexing a nontrivial `Sample` value
# transfers the collection, so a second indexed read is rejected.
fn peak_minute(samples: Vector[Sample]):
  length = samples |> count
  var best_index = 0
  var candidate_index = 1
  while candidate_index < length:
    candidate = samples[candidate_index]
    best = samples[best_index]
    if squared_deviation(candidate) > squared_deviation(best):
      best_index = candidate_index
    candidate_index = candidate_index + 1
  return samples[best_index].minute
