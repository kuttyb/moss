# A bounded String-to-Int Accumulator translated from DataStructures.jl.
type Accumulator:
  data: Map [String, Int]

  fn get(key: String) -> Int:
    return data.get(key, 0)

  fn keys() -> Vector [String]:
    return data.keys()

  fn increment_by(key: String, amount: Int) -> Int:
    next = data.get(key, 0) + amount
    data [key] = next
    return next

  fn increment(key: String) -> Int:
    return increment_by(key, 1)

  fn decrement(key: String) -> Int:
    return increment_by(key, -1)

  fn total() -> Int:
    return data.values() |> sum

  fn merge(other: Accumulator):
    for key in other.keys():
      self.increment_by(key, other.get(key))

fn empty_accumulator() -> Accumulator:
  return Accumulator(data: Map())

test "updates an existing accumulated key":
  data = Map()
  data ["apple"] = 2
  accumulator = Accumulator(data: data)

  assertEqual(accumulator.increment("apple"), 3)
  assertEqual(accumulator.increment_by("apple", 4), 7)
  assertEqual(accumulator.decrement("apple"), 6)
  assertEqual(accumulator.get("apple"), 6)
  assertEqual(accumulator.total(), 6)

test "reads a missing key as zero":
  accumulator = empty_accumulator()
  assertEqual(accumulator.get("missing"), 0)

test "accumulates missing keys and preserves negatives":
  accumulator = empty_accumulator()
  accumulator.increment("apple")
  accumulator.increment("apple")
  accumulator.increment("banana")
  assertEqual(accumulator.get("apple"), 2)
  assertEqual(accumulator.get("banana"), 1)
  assertEqual(accumulator.get("pear"), 0)
  assertEqual(accumulator.total(), 3)

  accumulator.decrement("apple")
  assertEqual(accumulator.get("apple"), 1)
  assertEqual(accumulator.total(), 2)

test "decrements a missing key below zero":
  accumulator = empty_accumulator()
  accumulator.decrement("x")
  assertEqual(accumulator.get("x"), -1)
  assertEqual(accumulator.total(), -1)

test "merges accumulated keys":
  left_data = Map()
  left_data ["apple"] = 2
  left_data ["pear"] = 1
  left = Accumulator(data: left_data)

  right_data = Map()
  right_data ["apple"] = 3
  right_data ["banana"] = 4
  right = Accumulator(data: right_data)

  left.merge(right)

  assertEqual(left.get("apple"), 5)
  assertEqual(left.get("pear"), 1)
  assertEqual(left.get("banana"), 4)
  assertEqual(left.total(), 10)

fn main():
  accumulator = empty_accumulator()
  accumulator.increment("apple")
  echo accumulator.get("apple"), accumulator.get("missing"), accumulator.total()
