# A small Int min-heap translated from the core array algorithm used by
# JuliaCollections/DataStructures.jl. `size` is maintained explicitly because
# Moss's current `count` terminal cannot be used as an arithmetic index.
type BinaryHeap:
  data: Vector [Int]
  size: Int

  fn count() -> Int:
    return size

  fn empty() -> Bool:
    return size == 0

  fn peek() -> Int:
    return data [0]

  # Move parents down into the insertion hole, then write value once.
  fn percolate_up(start: Int) -> Int:
    value = data [start]
    position = start
    while position > 0:
      parent = (position - 1) / 2
      parent_value = data [parent]
      if parent_value <= value:
        data [position] = value
        return position
      data [position] = parent_value
      position = parent
    data [position] = value
    return position

  # Move the smaller child up into the replacement hole, then write value once.
  fn percolate_down(start: Int) -> Int:
    value = data [start]
    position = start
    while position * 2 + 1 < size:
      left = position * 2 + 1
      right = left + 1
      child = left
      if right < size:
        right_value = data [right]
        left_value = data [left]
        if right_value < left_value:
          child = right
      child_value = data [child]
      if child_value >= value:
        data [position] = value
        return position
      data [position] = child_value
      position = child
    data [position] = value
    return position

  fn push(value: Int) -> Int:
    data.push(value)
    size = size + 1
    percolate_up(size - 1)
    return size

  fn take_min() -> Int:
    result = data [0]
    last = size - 1
    replacement = data [last]
    data.pop()
    size = size - 1
    if size > 0:
      data [0] = replacement
      percolate_down(0)
    return result

fn empty_heap() -> BinaryHeap:
  return BinaryHeap(data: [], size: 0)

test "orders the Julia BinaryHeap push and pop sequence":
  heap = empty_heap()
  heap.push(5)
  heap.push(2)
  heap.push(7)
  heap.push(1)

  assertEqual(heap.peek(), 1)
  assertEqual(heap.take_min(), 1)
  assertEqual(heap.take_min(), 2)
  assertEqual(heap.take_min(), 5)
  assertEqual(heap.take_min(), 7)
  assert(heap.empty())

test "handles duplicates and negative values":
  heap = empty_heap()
  heap.push(3)
  heap.push(-4)
  heap.push(3)
  heap.push(-4)

  assertEqual(heap.take_min(), 0 - 4)
  assertEqual(heap.take_min(), 0 - 4)
  assertEqual(heap.take_min(), 3)
  assertEqual(heap.take_min(), 3)

test "supports a single element and reuse after pop":
  heap = empty_heap()
  heap.push(9)
  assertEqual(heap.peek(), 9)
  assertEqual(heap.take_min(), 9)
  assert(heap.empty())

  heap.push(4)
  heap.push(-1)
  assertEqual(heap.take_min(), 0 - 1)
  heap.push(2)
  assertEqual(heap.take_min(), 2)
  assertEqual(heap.take_min(), 4)

test "uses truncating zero-based parent division":
  assertEqual((5 / 2), 2)
  assertEqual((7 - 1) / 2, 3)

fn main():
  heap = empty_heap()
  heap.push(5)
  heap.push(2)
  heap.push(7)
  heap.push(1)
  echo heap.take_min(), heap.take_min(), heap.take_min(), heap.take_min()
