test "priority balances value urgency and effort":
  assertEqual(priority(16, 4, 2), 48)
  assertEqual(priority(13, 3, 3), 42)

test "chooser unlocks dependent work across rounds":
  values = [9, 16, 13, 20, 6]
  efforts = [2, 4, 3, 3, 2]
  dependencies = [-1, 0, 0, 1, 3]
  urgencies = [1, 2, 3, 4, 1]
  var selected = [0, 0, 0, 0, 0]

  first = choose_next(values, efforts, dependencies, urgencies, selected, 10)
  assertEqual(first, 0)
  selected[first] = 1

  second = choose_next(values, efforts, dependencies, urgencies, selected, 8)
  assertEqual(second, 1)
  selected[second] = 1

  third = choose_next(values, efforts, dependencies, urgencies, selected, 4)
  assertEqual(third, 3)
  selected[third] = 1
  assertEqual(completed_count(selected), 3)

test "chooser returns no candidate when dependency remains blocked":
  values = [20]
  efforts = [3]
  dependencies = [0]
  urgencies = [4]
  selected = [0]

  assertEqual(choose_next(values, efforts, dependencies, urgencies, selected, 5), -1)
