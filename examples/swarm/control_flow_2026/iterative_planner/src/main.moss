fn priority(value: Int, effort: Int, urgency: Int) -> Int:
  return value * 3 + urgency * 2 - effort

fn dependency_done(dependency: Int, selected: Vector[Int]) -> Bool:
  if dependency < 0:
    return true
  return selected[dependency] == 1

fn choose_next(values: Vector[Int], efforts: Vector[Int], dependencies: Vector[Int], urgencies: Vector[Int], selected: Vector[Int], remaining: Int) -> Int:
  var best_index = -1
  var best_priority = -100000
  var index = 0
  task_count = values |> count

  while index < task_count:
    if selected[index] == 0:
      if efforts[index] <= remaining:
        if dependency_done(dependencies[index], selected):
          score = priority(values[index], efforts[index], urgencies[index])
          if score > best_priority:
            best_index = index
            best_priority = score
    index = index + 1

  return best_index

fn completed_count(selected: Vector[Int]) -> Int:
  var total = 0
  var index = 0
  selected_count = selected |> count
  while index < selected_count:
    if selected[index] == 1:
      total = total + 1
    index = index + 1
  return total

fn main():
  values = [9, 16, 13, 20, 6]
  efforts = [2, 4, 3, 3, 2]
  dependencies = [-1, 0, 0, 1, 3]
  urgencies = [1, 2, 3, 4, 1]
  var selected = [0, 0, 0, 0, 0]
  var remaining = 10
  var delivered_value = 0
  var rounds = 0
  task_count = values |> count

  while rounds < task_count:
    next = choose_next(values, efforts, dependencies, urgencies, selected, remaining)
    if next < 0:
      rounds = task_count
    else:
      selected[next] = 1
      remaining = remaining - efforts[next]
      delivered_value = delivered_value + values[next]
      rounds = rounds + 1

  echo completed_count(selected), delivered_value, remaining
