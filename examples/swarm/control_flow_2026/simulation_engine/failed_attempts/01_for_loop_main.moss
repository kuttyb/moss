# First natural formulation, preserved verbatim before the while-loop rewrite.
fn urgency(demand: Int, supply: Int, weather: Int) -> Int:
  var score = demand * 2
  if supply < demand:
    score = score + 4
    if weather >= 2:
      score = score + 3
    else:
      score = score + 1
  else:
    if weather == 0:
      score = score + 1
  if score > 20:
    return 3
  else:
    if score > 12:
      return 2
    else:
      return 1

fn deliverable_supply(supply: Int, weather: Int, urgency_level: Int) -> Int:
  var delivered = supply
  if weather >= 2:
    delivered = supply / 2
  else:
    if weather == 1:
      delivered = supply - 1
  if urgency_level == 3:
    delivered = delivered + 2
  if delivered < 0:
    return 0
  else:
    return delivered

fn simulate(demands: Vector[Int], supplies: Vector[Int], weather: Vector[Int]) -> Int:
  var backlog = 0
  var fulfilled = 0
  var peak_backlog = 0
  for day in range(0, demands |> count):
    need = demands[day] + backlog
    supply = supplies[day]
    weather_code = weather[day]
    level = urgency(need, supply, weather_code)
    delivered = deliverable_supply(supply, weather_code, level)
    if delivered >= need:
      fulfilled = fulfilled + need
      backlog = 0
    else:
      fulfilled = fulfilled + delivered
      backlog = need - delivered
      if backlog > peak_backlog:
        peak_backlog = backlog
  return fulfilled - backlog - peak_backlog

fn main():
  demands = [6, 8, 4, 10, 5]
  supplies = [7, 4, 9, 7, 8]
  weather = [0, 2, 1, 2, 0]
  score = simulate(demands, supplies, weather)
  echo "resilience score", score
