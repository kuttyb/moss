# Pipeline stage helper unit tests

test "input validation within bounds":
  assertEqual(validate_input(50, 0, 100), true)
  assertEqual(validate_input(0, 0, 100), true)
  assertEqual(validate_input(100, 0, 100), true)

test "input validation out of bounds":
  assertEqual(validate_input(-1, 0, 100), false)
  assertEqual(validate_input(101, 0, 100), false)
  assertEqual(validate_input(-50, 0, 100), false)

test "payload normalization":
  assertEqual(normalize_payload(10, 5), 15)
  assertEqual(normalize_payload(0, 10), 10)
  assertEqual(normalize_payload(-5, 5), 0)

test "payload transformation math":
  assertEqual(transform_payload(10, 2, 1), 21)
  assertEqual(transform_payload(0, 5, 3), 3)
  assertEqual(transform_payload(4, 3, 7), 19)

test "min and max updates":
  # First value initializes both
  assertEqual(update_min(0, 42, 1), 42)
  assertEqual(update_max(0, 42, 1), 42)

  # Subsequent smaller value updates min only
  assertEqual(update_min(42, 15, 2), 15)
  assertEqual(update_max(42, 15, 2), 42)

  # Subsequent larger value updates max only
  assertEqual(update_min(15, 99, 3), 15)
  assertEqual(update_max(42, 99, 3), 99)
