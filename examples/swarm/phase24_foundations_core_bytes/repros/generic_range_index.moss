# Original indexed generic Range adapter from the initial bytes SDK attempt.
# `moss check` accepts the helper alone; the call is rejected when specialized.
fn from_range(data):
  n = data.length()
  var result = Vector[Int]()
  var i = 0
  while i < n:
    result.push(data[i])
    i = i + 1
  return result

domain Worker:
  fn Read(path: String) -> Int:
    file = FileIO.open(path, ro)
    data = file.read(0, 8)
    owned = from_range(data)
    file.close()
    reply owned |> count

  on_fail:
    reply -1

fn main():
  worker = Worker()
  echo message worker.Read("input.bin")
