# A bounded Int min-heap translated from CPython's Lib/heapq.py.
type BinaryHeap:
  data: Vector [Int]

  fn count() -> Int:
    return data |> count

  # CPython _siftdown: follow parents toward start, moving them down once.
  fn sift_down(start: Int, position: Int) -> Int:
    new_item = data [position]
    current = position
    while current > start:
      parent = (current - 1) / 2
      parent_item = data [parent]
      if new_item < parent_item:
        data [current] = parent_item
        current = parent
      else:
        data [current] = new_item
        return current
    data [current] = new_item
    return current

  # CPython _siftup: move the smaller-child path to a leaf, then sift back.
  fn sift_up(position: Int) -> Int:
    end = count()
    start = position
    new_item = data [position]
    current = position
    child = current * 2 + 1
    while child < end:
      right = child + 1
      if right < end:
        if data [right] <= data [child]:
          child = right
      data [current] = data [child]
      current = child
      child = current * 2 + 1
    data [current] = new_item
    return sift_down(start, current)

  fn push(value: Int) -> Int:
    data.push(value)
    return sift_down(0, count() - 1)

  fn peek() -> Int:
    return data [0]

  fn pop() -> Int:
    last_item = data [count() - 1]
    data.pop()
    if count() > 0:
      result = data [0]
      data [0] = last_item
      sift_up(0)
      return result
    return last_item

fn empty_heap() -> BinaryHeap:
  return BinaryHeap(data: [])

test "orders the Python heapq push and pop sequence":
  heap = empty_heap()
  heap.push(5)
  heap.push(2)
  heap.push(7)
  heap.push(1)

  assertEqual(heap.peek(), 1)
  assertEqual(heap.pop(), 1)
  assertEqual(heap.pop(), 2)
  assertEqual(heap.pop(), 5)
  assertEqual(heap.pop(), 7)

test "handles duplicates and negative values":
  heap = empty_heap()
  heap.push(3)
  heap.push(-4)
  heap.push(3)
  heap.push(-4)

  assertEqual(heap.pop(), -4)
  assertEqual(heap.pop(), -4)
  assertEqual(heap.pop(), 3)
  assertEqual(heap.pop(), 3)

test "supports a single element and reuse after pop":
  heap = empty_heap()
  heap.push(9)
  assertEqual(heap.peek(), 9)
  assertEqual(heap.pop(), 9)

  heap.push(4)
  heap.push(-1)
  assertEqual(heap.pop(), -1)
  heap.push(2)
  assertEqual(heap.pop(), 2)
  assertEqual(heap.pop(), 4)

test "maps CPython parent shift to Moss integer division":
  assertEqual((5 / 2), 2)
  assertEqual((7 - 1) / 2, 3)

fn main():
  heap = empty_heap()
  heap.push(5)
  heap.push(2)
  heap.push(7)
  heap.push(1)
  echo heap.peek(), heap.pop(), heap.pop(), heap.pop(), heap.pop()
