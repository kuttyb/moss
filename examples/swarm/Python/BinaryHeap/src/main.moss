# A bounded Int min-heap translated from CPython's Lib/heapq.py.
type BinaryHeap:
  data: Vector [Int]
  size: Int

  # CPython _siftdown: follow parents toward start, moving them down once.
  fn sift_down(start: Int, position: Int) -> Int:
    new_item = data [position]
    current = position
    while current > start:
      parent = (current - 1) / 2
      parent_item = data [parent]
      if new_item < parent_item:
        data [current] = parent_item
        current = parent
      else:
        data [current] = new_item
        return current
    data [current] = new_item
    return current

  # CPython _siftup: move the smaller-child path to a leaf, then sift back.
  fn sift_up(position: Int) -> Int:
    end = size
    start = position
    new_item = data [position]
    current = position
    child = current * 2 + 1
    while child < end:
      right = child + 1
      if right < end:
        right_item = data [right]
        child_item = data [child]
        if right_item <= child_item:
          child = right
      data [current] = data [child]
      current = child
      child = current * 2 + 1
    data [current] = new_item
    sift_down(start, current)
    return current

  fn push(value: Int) -> Int:
    data.push(value)
    size = size + 1
    sift_down(0, size - 1)
    return size

  fn peek() -> Int:
    return data [0]

  fn take_min() -> Int:
    last_item = data [size - 1]
    data.pop()
    size = size - 1
    if size > 0:
      result = data [0]
      data [0] = last_item
      sift_up(0)
      return result
    return last_item

fn empty_heap() -> BinaryHeap:
  return BinaryHeap(data: [], size: 0)

test "orders the Python heapq push and pop sequence":
  heap = empty_heap()
  heap.push(5)
  heap.push(2)
  heap.push(7)
  heap.push(1)

  assertEqual(heap.peek(), 1)
  assertEqual(heap.take_min(), 1)
  assertEqual(heap.take_min(), 2)
  assertEqual(heap.take_min(), 5)
  assertEqual(heap.take_min(), 7)

test "handles duplicates and negative values":
  heap = empty_heap()
  heap.push(3)
  heap.push(-4)
  heap.push(3)
  heap.push(-4)

  assertEqual(heap.take_min(), 0 - 4)
  assertEqual(heap.take_min(), 0 - 4)
  assertEqual(heap.take_min(), 3)
  assertEqual(heap.take_min(), 3)

test "supports a single element and reuse after pop":
  heap = empty_heap()
  heap.push(9)
  assertEqual(heap.peek(), 9)
  assertEqual(heap.take_min(), 9)

  heap.push(4)
  heap.push(-1)
  assertEqual(heap.take_min(), 0 - 1)
  heap.push(2)
  assertEqual(heap.take_min(), 2)
  assertEqual(heap.take_min(), 4)

fn main():
  heap = empty_heap()
  heap.push(5)
  heap.push(2)
  heap.push(7)
  heap.push(1)
  echo heap.peek(), heap.take_min(), heap.take_min(), heap.take_min(), heap.take_min()
