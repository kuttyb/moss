# A bounded String-to-Int Counter translated from CPython's collections.Counter.
type Counter:
  counts: Map [String, Int]

  # CPython Counter.__missing__: a missing key should read as zero.
  fn get(key: String) -> Int:
    return counts.get(key, 0)

  # CPython _count_elements: read, add, and write the per-key count.
  fn increment_by(key: String, amount: Int) -> Int:
    next = counts.get(key, 0) + amount
    counts [key] = next
    return next

  fn increment(key: String) -> Int:
    return increment_by(key, 1)

  fn decrement(key: String) -> Int:
    return increment_by(key, -1)

  fn total() -> Int:
    return counts.values() |> sum

fn empty_counter() -> Counter:
  return Counter(counts: Map())

test "updates an existing counter key":
  counts = Map()
  counts ["apple"] = 2
  counter = Counter(counts: counts)

  assertEqual(counter.increment("apple"), 3)
  assertEqual(counter.increment_by("apple", 4), 7)
  assertEqual(counter.decrement("apple"), 6)
  assertEqual(counter.get("apple"), 6)
  assertEqual(counter.total(), 6)

test "reads a missing key as zero":
  counter = empty_counter()
  assertEqual(counter.get("missing"), 0)

test "counts increments, amounts, and decrements":
  counter = empty_counter()
  counter.increment("apple")
  counter.increment("apple")
  counter.increment("banana")
  assertEqual(counter.get("apple"), 2)
  assertEqual(counter.get("banana"), 1)
  assertEqual(counter.get("pear"), 0)
  assertEqual(counter.total(), 3)

  counter.increment_by("apple", 4)
  assertEqual(counter.get("apple"), 6)
  assertEqual(counter.total(), 7)

  counter.decrement("apple")
  assertEqual(counter.get("apple"), 5)
  assertEqual(counter.total(), 6)

test "permits negative counts and reuse after reads":
  counter = empty_counter()
  counter.decrement("x")
  assertEqual(counter.get("x"), -1)
  assertEqual(counter.total(), -1)
  counter.increment_by("x", 3)
  counter.increment("pear")
  assertEqual(counter.get("x"), 2)
  assertEqual(counter.get("pear"), 1)
  assertEqual(counter.total(), 3)

fn main():
  counter = empty_counter()
  counter.increment("apple")
  counter.increment("apple")
  counter.increment("banana")
  counter.decrement("apple")
  echo counter.get("apple"), counter.get("banana"), counter.get("pear"), counter.total()
