module LogAnalytics

fn main():
  echo "=== Log Analytics Pipeline Engine ==="

  # Sample RequestLogs:
  l1 = RequestLog(path: "/api/users", status: 200, response_time: 45)
  l2 = RequestLog(path: "/api/orders", status: 200, response_time: 120)
  l3 = RequestLog(path: "/api/pay", status: 500, response_time: 350)
  l4 = RequestLog(path: "/api/items", status: 404, response_time: 25)
  l5 = RequestLog(path: "/api/search", status: 200, response_time: 180)
  l6 = RequestLog(path: "/api/cart", status: 200, response_time: 85)
  logs = [l1, l2, l3, l4, l5, l6]

  echo "Processed request logs count:", logs |> count

  # 1. Total latency via cross-package fold_left:
  tot_latency = total_log_latency(logs)
  echo "Total latency (ms):", tot_latency

  # 2. Windowed latency averages (sliding window of size 3):
  win_lat = compute_windowed_latency_averages(logs, 3)
  echo "Sliding window latency averages (size 3):", win_lat[0], win_lat[1], win_lat[2], win_lat[3]

  # 3. Slow-request filtering (latency > 100ms):
  slow_lats = filter_slow_latencies(logs)
  echo "Slow request latencies count:", slow_lats |> count
  echo "Slow request latencies:", slow_lats[0], slow_lats[1], slow_lats[2]

  # 4. Count slow requests via count_matching:
  slow_cnt = count_slow_requests(logs)
  echo "Count of slow requests (>100ms):", slow_cnt

  # 5. Status code frequencies:
  freqs = compute_status_frequencies(logs)
  echo "Status code frequencies:"
  echo "  200 OK:", freqs.get(200, 0)
  echo "  404 Not Found:", freqs.get(404, 0)
  echo "  500 Internal Error:", freqs.get(500, 0)

  # 6. Distinct status codes:
  distinct_statuses = distinct_status_codes(logs)
  echo "Distinct status codes count:", distinct_statuses |> count
  echo "Distinct status codes:", distinct_statuses[0], distinct_statuses[1], distinct_statuses[2]

  # Sample MetricPoints:
  m1 = MetricPoint(timestamp: 1000, value: 10)
  m2 = MetricPoint(timestamp: 1010, value: 20)
  m3 = MetricPoint(timestamp: 1020, value: 30)
  m4 = MetricPoint(timestamp: 1030, value: 40)
  m5 = MetricPoint(timestamp: 1040, value: 50)
  m6 = MetricPoint(timestamp: 1050, value: 60)
  metrics = [m1, m2, m3, m4, m5, m6]

  echo "=== System Metrics Batch & Window Processing ==="

  # 7. Total metric value via fold_left:
  tot_metrics = total_metric_value(metrics)
  echo "Total metric sum:", tot_metrics

  # 8. Batch metric sums and averages (batch size 2):
  b_sums = compute_batch_metric_sums(metrics, 2)
  b_avgs = compute_batch_metric_averages(metrics, 2)
  echo "Batch sums (size 2):", b_sums[0], b_sums[1], b_sums[2]
  echo "Batch averages (size 2):", b_avgs[0], b_avgs[1], b_avgs[2]

  # 9. Windowed metric averages (window size 3):
  win_m = compute_windowed_metric_averages(metrics, 3)
  echo "Sliding window metric averages (size 3):", win_m[0], win_m[1], win_m[2], win_m[3]

  echo "=== Pipeline Processing Complete ==="
