# Reproducer 5: Pipeline Reduce With Mutating Map Accumulator Triggers SIGABRT
# Category: Pipeline/callable-resolution defect (Compiler Crash)
# Command: moss check repro_reduce_map_abort.moss --json
#
# Observed behavior:
# The compiler crashes with SIGABRT (exit code 134 / -6):
# "moss: src/moss.cpp:6054: Assertion `!node.effects.unresolved && !node.callable_identity.empty()` failed."
#
# Root Cause (fixed in Phase 15.14):
# Observable effect analysis did not recognize built-in Map.get as a resolved
# method, so record_freq was marked unresolved when the checked reduce stage
# reached functional IR. Native lowering also needed a mutable binding for the
# consumed Map parameter that is updated through an index.

export fn record_freq(counts: Map[Int, Int], item: Int) -> Map[Int, Int]:
  c = counts.get(item, 0)
  counts[item] = c + 1
  return counts

fn main():
  var m = Map()
  m[0] = 0
  items = [200, 404, 200]
  res = items |> reduce(m, record_freq)
  echo res.get(200, 0)
