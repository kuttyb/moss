# ==============================================================================
# Reusable Sorting, Partitioning, and Binary Search Library for Moss v0.1
# ==============================================================================

# --- Core Structural Traits ---

trait Sortable:
  fn len() -> Int
  fn less(i: Int, j: Int) -> Bool
  fn swap(i: Int, j: Int) -> Int

trait Searchable:
  fn len() -> Int
  fn compare_at(i: Int) -> Int

# --- Custom Record Types ---

type Player:
  name: String
  score: Int

type Item:
  id: Int
  weight: Int

# --- Borrow-Safe Field Helper Functions ---

fn player_less(p1: Player, p2: Player) -> Bool:
  return p1.score < p2.score

fn player_score(p: Player) -> Int:
  return p.score

fn print_player(p: Player):
  echo p.name, p.score

fn item_less(it1: Item, it2: Item) -> Bool:
  return it1.weight < it2.weight

fn item_id(it: Item) -> Int:
  return it.id

fn item_weight(it: Item) -> Int:
  return it.weight

# --- Helper: Index Vector Generator ---

fn make_indices(n: Int) -> Vector[Int]:
  var result = Vector[Int]()
  var i = 0
  while i < n:
    result.push(i)
    i = i + 1
  return result

# --- Sortable Implementations over Concrete Types ---

type IntIndexSortable:
  data: Vector[Int]
  indices: Vector[Int]

  fn len() -> Int:
    return indices |> count

  fn less(i: Int, j: Int) -> Bool:
    return data[indices[i]] < data[indices[j]]

  fn swap(i: Int, j: Int) -> Int:
    tmp = indices[i]
    indices[i] = indices[j]
    indices[j] = tmp
    return 0

type StringIndexSortable:
  data: Vector[String]
  indices: Vector[Int]

  fn len() -> Int:
    return indices |> count

  fn less(i: Int, j: Int) -> Bool:
    return data[indices[i]] < data[indices[j]]

  fn swap(i: Int, j: Int) -> Int:
    tmp = indices[i]
    indices[i] = indices[j]
    indices[j] = tmp
    return 0

type PlayerScoreSortable:
  data: Vector[Player]
  indices: Vector[Int]

  fn len() -> Int:
    return indices |> count

  fn less(i: Int, j: Int) -> Bool:
    return player_less(data[indices[i]], data[indices[j]])

  fn swap(i: Int, j: Int) -> Int:
    tmp = indices[i]
    indices[i] = indices[j]
    indices[j] = tmp
    return 0

type ItemWeightSortable:
  data: Vector[Item]
  indices: Vector[Int]

  fn len() -> Int:
    return indices |> count

  fn less(i: Int, j: Int) -> Bool:
    return item_less(data[indices[i]], data[indices[j]])

  fn swap(i: Int, j: Int) -> Int:
    tmp = indices[i]
    indices[i] = indices[j]
    indices[j] = tmp
    return 0

# --- Searchable Implementations over Concrete Types ---

type IntSearcher:
  data: Vector[Int]
  target: Int

  fn len() -> Int:
    return data |> count

  fn compare_at(i: Int) -> Int:
    val = data[i]
    if target == val:
      return 0
    else:
      if target < val:
        return -1
      else:
        return 1

type StringSearcher:
  data: Vector[String]
  target: String

  fn len() -> Int:
    return data |> count

  fn compare_at(i: Int) -> Int:
    val = data[i]
    if target == val:
      return 0
    else:
      if target < val:
        return -1
      else:
        return 1

type PlayerScoreSearcher:
  data: Vector[Player]
  target_score: Int

  fn len() -> Int:
    return data |> count

  fn compare_at(i: Int) -> Int:
    val = player_score(data[i])
    if target_score == val:
      return 0
    else:
      if target_score < val:
        return -1
      else:
        return 1

type ItemWeightSearcher:
  data: Vector[Item]
  target_weight: Int

  fn len() -> Int:
    return data |> count

  fn compare_at(i: Int) -> Int:
    val = item_weight(data[i])
    if target_weight == val:
      return 0
    else:
      if target_weight < val:
        return -1
      else:
        return 1

# --- Adapter Construction Factories ---

fn make_int_sortable(data: Vector[Int]) -> IntIndexSortable:
  n = data |> count
  return IntIndexSortable(data: data, indices: make_indices(n))

fn make_string_sortable(data: Vector[String]) -> StringIndexSortable:
  n = data |> count
  return StringIndexSortable(data: data, indices: make_indices(n))

fn make_player_sortable(data: Vector[Player]) -> PlayerScoreSortable:
  n = data |> count
  return PlayerScoreSortable(data: data, indices: make_indices(n))

fn make_item_sortable(data: Vector[Item]) -> ItemWeightSortable:
  n = data |> count
  return ItemWeightSortable(data: data, indices: make_indices(n))

# --- Generic Reusable Sorting and Partitioning Algorithms ---

fn is_sorted(s: Sortable) -> Bool:
  n = s.len()
  if n <= 1:
    return true
  var i = 1
  while i < n:
    if s.less(i, i - 1):
      return false
    i = i + 1
  return true

fn selection_sort(s: Sortable):
  n = s.len()
  var i = 0
  while i < n:
    var min_idx = i
    var j = i + 1
    while j < n:
      if s.less(j, min_idx):
        min_idx = j
      j = j + 1
    if min_idx != i:
      dummy = s.swap(i, min_idx)
    i = i + 1

fn insertion_sort(s: Sortable):
  n = s.len()
  var i = 1
  while i < n:
    var j = i
    var moving = true
    while moving:
      if j <= 0:
        moving = false
      else:
        if s.less(j, j - 1):
          dummy = s.swap(j, j - 1)
          j = j - 1
        else:
          moving = false
    i = i + 1

fn partition(s: Sortable, low: Int, high: Int) -> Int:
  var pivot_idx = high
  var i = low - 1
  var j = low
  while j < high:
    if s.less(j, pivot_idx):
      i = i + 1
      dummy1 = s.swap(i, j)
    j = j + 1
  dummy2 = s.swap(i + 1, high)
  return i + 1

fn quicksort(s: Sortable):
  n = s.len()
  if n <= 1:
    return
  var stack_low = Vector[Int]()
