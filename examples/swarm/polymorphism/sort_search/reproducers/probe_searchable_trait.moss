trait Searchable:
  fn len() -> Int
  fn compare_at(i: Int) -> Int

type IntSearcher:
  data: Vector[Int]
  target: Int
  fn len() -> Int:
    return data |> count
  fn compare_at(i: Int) -> Int:
    val = data[i]
    if target == val:
      return 0
    else:
      if target < val:
        return -1
      else:
        return 1

type StringSearcher:
  data: Vector[String]
  target: String
  fn len() -> Int:
    return data |> count
  fn compare_at(i: Int) -> Int:
    if target == data[i]:
      return 0
    else:
      if target < data[i]:
        return -1
      else:
        return 1

type Player:
  name: String
  score: Int

fn player_score(p: Player) -> Int:
  return p.score

type PlayerScoreSearcher:
  data: Vector[Player]
  target_score: Int
  fn len() -> Int:
    return data |> count
  fn compare_at(i: Int) -> Int:
    val = player_score(data[i])
    if target_score == val:
      return 0
    else:
      if target_score < val:
        return -1
      else:
        return 1

fn binary_search(s: Searchable) -> Int:
  var low = 0
  var high = s.len() - 1
  while low <= high:
    mid = low + (high - low) / 2
    c = s.compare_at(mid)
    if c == 0:
      return mid
    else:
      if c < 0:
        high = mid - 1
      else:
        low = mid + 1
  return -1

fn main():
  ints = [10, 20, 30, 40, 50, 60]
  isearch = IntSearcher(data: ints, target: 40)
  echo binary_search(isearch)

  strs = ["apple", "banana", "cherry", "date"]
  ssearch = StringSearcher(data: strs, target: "cherry")
  echo binary_search(ssearch)

  p1 = Player(name: "Bob", score: 70)
  p2 = Player(name: "Charlie", score: 85)
  p3 = Player(name: "Alice", score: 95)
  psearch = PlayerScoreSearcher(data: [p1, p2, p3], target_score: 85)
  echo binary_search(psearch)

  p4 = Player(name: "Bob", score: 70)
  p5 = Player(name: "Charlie", score: 85)
  p6 = Player(name: "Alice", score: 95)
  psearch_missing = PlayerScoreSearcher(data: [p4, p5, p6], target_score: 99)
  echo binary_search(psearch_missing)
