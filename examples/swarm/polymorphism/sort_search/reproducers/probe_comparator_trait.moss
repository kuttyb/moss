trait Comparator:
  fn compare(a: Int, b: Int) -> Int

type AscendingInt:
  tag: Int
  fn compare(a: Int, b: Int) -> Int:
    if a < b:
      return -1
    else:
      if a > b:
        return 1
      else:
        return 0

fn do_compare(cmp, x: Int, y: Int) -> Int:
  return cmp.compare(x, y)

fn main():
  c = AscendingInt(tag: 0)
  echo do_compare(c, 10, 20)
