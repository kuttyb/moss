trait Comparator:
  fn compare(a: Int, b: Int) -> Int

type DefaultIntCmp:
  tag: Int
  fn compare(a: Int, b: Int) -> Int:
    if a < b:
      return -1
    else:
      if a > b:
        return 1
      else:
        return 0

fn binary_search(cmp: Comparator, items: Vector, target: Int) -> Int:
  var low = 0
  var high = (items |> count) - 1
  while low <= high:
    mid = low + (high - low) / 2
    c = cmp.compare(items[mid], target)
    if c == 0:
      return mid
    else:
      if c < 0:
        low = mid + 1
      else:
        high = mid - 1
  return -1

fn main():
  cmp = DefaultIntCmp(tag: 0)
  nums = [10, 20, 30, 40, 50]
  echo binary_search(cmp, nums, 30)
