trait IndexedSequence:
  fn get(i: Int) -> Int
  fn set(i: Int, val: Int) -> Int
  fn len() -> Int

type IntArray:
  data: Vector[Int]
  fn get(i: Int) -> Int:
    return data[i]
  fn set(i: Int, val: Int) -> Int:
    data[i] = val
    return 0
  fn len() -> Int:
    return data |> count

fn sort_indexed(seq: IndexedSequence):
  n = seq.len()
  var i = 1
  while i < n:
    key = seq.get(i)
    var j = i - 1
    var keep_going = true
    while keep_going:
      if j < 0:
        keep_going = false
      else:
        if seq.get(j) > key:
          dummy1 = seq.set(j + 1, seq.get(j))
          j = j - 1
        else:
          keep_going = false
    dummy2 = seq.set(j + 1, key)
    i = i + 1

fn main():
  var arr = IntArray(data: [5, 2, 4, 1, 3])
  sort_indexed(arr)
  echo arr.get(0), arr.get(1), arr.get(2), arr.get(3), arr.get(4)
