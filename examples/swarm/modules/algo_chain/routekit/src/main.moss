module routekit_demo
import graph
import route

fn main():
  g = graph.new_graph(5)
  graph.add_road(g, 0, 1, 4)
  graph.add_road(g, 0, 2, 1)
  graph.add_road(g, 2, 1, 2)
  graph.add_road(g, 1, 3, 5)
  r = route.shortest_paths(g, 0)
  echo route.distance(r, 3)
  p = route.path(r, 3)
  for v in p:
    echo v
  echo route.reachable(r, 4)
