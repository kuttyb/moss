module stats_test
import stats

test "integer summaries":
  nums = [3, 9, 12, 4]
  assertEqual(stats.total(nums), 28)
  assertEqual(stats.smallest(nums), 3)
  assertEqual(stats.largest(nums), 12)
  assertEqual(stats.mean_int(nums), 7)

test "float mean of ints":
  nums = [1, 2, 4]
  assertEqual(stats.mean(nums), 7.0 / 3.0)
  assertEqual(stats.mean_float([1.5, 2.5]), 2.0)

test "int/float conversion helpers":
  assertEqual(stats.to_float(10), 10.0)
  assertEqual(stats.to_float(-3), -3.0)
  assertEqual(stats.to_int(3.99), 3)
  assertEqual(stats.to_int(0.5), 0)
  assertEqual(stats.to_int(1000.0), 1000)

test "histogram uses defaulted map lookups":
  h = stats.histogram([3, 9, 12, 4, 45], 10)
  assertEqual(stats.bucket_of(h, 0), 3)
  assertEqual(stats.bucket_of(h, 1), 1)
  assertEqual(stats.bucket_of(h, 2), 0)
  assertEqual(stats.bucket_of(h, 4), 1)

test "tally counts words":
  t = stats.tally(["b", "a", "b"])
  assertEqual(stats.count_of(t, "b"), 2)
  assertEqual(stats.count_of(t, "a"), 1)
  assertEqual(stats.count_of(t, "missing"), 0)
