module app

import vec2
import scene
import model
import shapes
import report

fn main():
  s = scene.new_scene("demo")
  s.add_circle("sun", 0.0, 0.0, 2.0)
  s.add_circle("moon", 5.0, 5.0, 0.5)
  s.add_rect("floor", 0.0, 0.0, 10.0, 1.0)
  s.add_tri("roof", vec2.vec(0.0, 1.0), vec2.vec(4.0, 1.0), vec2.vec(2.0, 3.0))
  report.print_header(s)
  report.print_shapes(s)
  report.print_summary(s)
  echo "big shapes (area > 5):", s.big_count(5.0)
  s.shift_all(vec2.vec(1.0, 1.0))
  echo "after shift, total area:", s.total_area()
