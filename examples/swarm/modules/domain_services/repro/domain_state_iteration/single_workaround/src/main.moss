type Entry:
  key: Int
  value: Int

fn make_entry(key: Int, value: Int) -> Entry:
  return Entry(key: key, value: value)

fn build(ids: Vector[Int], values: Map[Int, Int]) -> Vector[Entry]:
  out = Vector[Entry]()
  for k in ids:
    out.push(make_entry(k, values.get(k, 0)))
  return out

domain Config:
  values: Map[Int, Int]
  ids = Vector[Int]()

  fn Set(key: Int, value: Int):
    values[key] = value
    ids.push(key + 0)

  fn Snapshot() -> Vector[Entry]:
    reply build(ids, values)

fn main():
  cfg = Config()
  message cfg.Set(1, 10)
  snap = message cfg.Snapshot()
  echo snap |> count
