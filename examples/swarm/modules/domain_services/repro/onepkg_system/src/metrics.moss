module metrics

import records

export trait Weighted:
  fn weight() -> Int

export fn clamp(value: Int, low: Int, high: Int) -> Int:
  if value < low:
    return low
  if value > high:
    return high
  return value

export fn severity_name(level: Int) -> String:
  if level >= 3:
    return "error"
  if level == 2:
    return "warn"
  return "info"

export fn source_name(source: Int) -> String:
  if source == 1:
    return "cache"
  if source == 2:
    return "queue"
  if source == 3:
    return "config"
  return "unknown"

export fn total_weight(items) -> Int:
  var t = 0
  for item in items:
    t = t + item.weight()
  return t

export fn summarize(events: Vector[records.Event]) -> records.Summary:
  var worst = 0
  var i = 0
  n = events |> count
  while i < n:
    level = records.event_level(events[i])
    if level > worst:
      worst = level
    i = i + 1
  return records.make_summary(n, worst)
