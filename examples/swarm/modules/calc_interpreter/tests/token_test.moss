module token_test
import token

test "binary operators have precedence":
  plus = token.make(token.kind_plus(), 0, 0)
  star = token.make(token.kind_star(), 0, 1)
  assert(plus.is_binary_op())
  assert(star.is_binary_op())
  assert(star.precedence() > plus.precedence())

test "non operators have no precedence":
  num = token.make(token.kind_num(), 42, 0)
  assertEqual(num.precedence(), 0)
  assert(not num.is_binary_op())

test "accessors report what make stored":
  t = token.make(token.kind_ident(), 23, 4)
  assertEqual(t.kind(), token.kind_ident())
  assertEqual(t.value(), 23)
  assertEqual(t.pos(), 4)

test "precedence_of agrees with the method":
  assertEqual(token.precedence_of(token.kind_minus()), 1)
  assertEqual(token.precedence_of(token.kind_percent()), 2)
  assertEqual(token.precedence_of(token.kind_lparen()), 0)
