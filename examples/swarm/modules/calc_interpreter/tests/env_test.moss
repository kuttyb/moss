module env_test
import env

test "set and get":
  e = env.new_env()
  e.set(0, 5)
  e.set(1, 7)
  assertEqual(e.get(0), 5)
  assertEqual(e.get(1), 7)
  assertEqual(e.size(), 2)

test "overwrite keeps one entry":
  e = env.new_env()
  e.set(3, 1)
  e.set(3, 2)
  assertEqual(e.get(3), 2)
  assertEqual(e.size(), 1)

test "has and fallback":
  e = env.new_env()
  assert(not e.has(4))
  assertEqual(e.get_or(4, -1), -1)
  e.set(4, 9)
  assert(e.has(4))

test "default environment":
  e = env.with_defaults()
  assertEqual(e.get(19), 10)
  assertEqual(e.get(7), 100)
  assertEqual(e.size(), 2)
