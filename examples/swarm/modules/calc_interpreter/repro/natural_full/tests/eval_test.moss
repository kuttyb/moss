module eval_test
import ast
import env
import eval
import token

# Trees are built by hand with the flat-AST API, independent of the parser.

test "sum of two numbers":
  tree = ast.new_ast()
  a = tree.add_num(20, 0)
  b = tree.add_num(22, 3)
  tree.set_root(tree.add_binary(token.kind_plus(), a, b, 1))
  r = eval.evaluate(tree, env.new_env())
  assertEqual(r.value, 42)
  assert(not r.error.failed())

test "variables come from the environment":
  scope = env.new_env()
  scope.set(23, 6)
  tree = ast.new_ast()
  x = tree.add_var(23, 0)
  two = tree.add_num(2, 4)
  tree.set_root(tree.add_binary(token.kind_star(), x, two, 2))
  r = eval.evaluate(tree, scope)
  assertEqual(r.value, 12)

test "undefined variable":
  tree = ast.new_ast()
  tree.set_root(tree.add_var(5, 0))
  r = eval.evaluate(tree, env.new_env())
  assert(r.error.failed())
  assertEqual(r.error.stage(), "eval")

test "division by zero":
  tree = ast.new_ast()
  a = tree.add_num(1, 0)
  b = tree.add_num(0, 2)
  tree.set_root(tree.add_binary(token.kind_slash(), a, b, 1))
  r = eval.evaluate(tree, env.new_env())
  assert(r.error.failed())
  assertEqual(r.error.pos, 1)

test "assignment writes the environment":
  scope = env.new_env()
  tree = ast.new_ast()
  v = tree.add_num(9, 4)
  tree.set_root(tree.add_assign(2, v, 0))
  r = eval.evaluate(tree, scope)
  assertEqual(r.value, 9)
  assertEqual(scope.get(2), 9)

test "empty tree":
  r = eval.evaluate(ast.new_ast(), env.new_env())
  assert(r.error.failed())
