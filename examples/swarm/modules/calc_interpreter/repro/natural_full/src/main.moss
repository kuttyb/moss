module app
import calc
import report

fn main():
  session = calc.new_session()
  report.show(calc.run(session, ["1", "+", "2", "*", "3"]))
  report.show(calc.run(session, ["x", " ", "=", " ", "(", "1", "0", "-", "4", ")", "*", "-", "2"]))
  report.show(calc.run(session, ["y", "=", "x", "*", "x", "+", "t"]))
  report.show(calc.run(session, ["y", "%", "7"]))
  report.show(calc.run(session, ["y", "/", "(", "x", "+", "1", "2", ")"]))
  report.show(calc.run(session, ["1", "+", "$"]))
  report.show(calc.run(session, ["(", "1", "+"]))
  report.show(calc.run(session, ["z", "+", "1"]))
  report.summary(session)
