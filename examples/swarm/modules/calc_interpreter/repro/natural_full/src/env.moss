module env

# Symbol table: variable slot (0 = a, 1 = b, ...) -> integer value. Map has
# no deletion and no membership test, so the slots in use are also tracked in
# insertion order.

export type Env:
  vars: Map[Int, Int]
  slots: Vector[Int]

  fn has(slot: Int) -> Bool:
    return contains(slots, slot)

  fn get(slot: Int) -> Int:
    return vars.get(slot, 0)

  fn get_or(slot: Int, fallback: Int) -> Int:
    return vars.get(slot, fallback)

  fn set(slot: Int, value: Int):
    known = contains(slots, slot)
    vars[slot] = value
    if not known:
      slots.push(slot)
    return

  fn size() -> Int:
    return slots |> count

# Private helper used by the exported methods (sibling-method calls do not
# work inside a module, see repro/sibling_method).
fn contains(slots: Vector[Int], slot: Int) -> Bool:
  n = slots |> count
  var i = 0
  while i < n:
    if slots[i] == slot:
      return true
    i = i + 1
  return false

export fn new_env() -> Env:
  return Env(vars: Map(), slots: Vector[Int]())

# Environment preloaded with two constants: t = 10 and h = 100.
export fn with_defaults() -> Env:
  e = new_env()
  e.set(19, 10)
  e.set(7, 100)
  return e
