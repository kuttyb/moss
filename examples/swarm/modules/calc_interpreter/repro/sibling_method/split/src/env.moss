module env

export type Env:
  names: Vector[String]

  fn has(name: String) -> Bool:
    n = names |> count
    var i = 0
    while i < n:
      if names[i] == name:
        return true
      i = i + 1
    return false

  fn set(name: String):
    if not has(name):
      names.push(name)
    return

export fn new_env() -> Env:
  return Env(names: Vector[String]())

export fn count_names(e: Env) -> Int:
  return e.names |> count
