module env

# Symbol table: variable name -> integer value. Map has no deletion and no
# membership test, so the names are also tracked in insertion order.

export type Env:
  vars: Map[String, Int]
  names: Vector[String]

  fn has(name: String) -> Bool:
    n = names |> count
    var i = 0
    while i < n:
      if names[i] == name:
        return true
      i = i + 1
    return false

  fn get(name: String) -> Int:
    return vars[name]

  fn get_or(name: String, fallback: Int) -> Int:
    return vars.get(name, fallback)

  fn set(name: String, value: Int):
    if not has(name):
      names.push(name)
    vars[name] = value

  fn size() -> Int:
    return names |> count

export fn new_env() -> Env:
  return Env(vars: Map(), names: Vector[String]())

# Environment preloaded with a few constants.
export fn with_defaults() -> Env:
  e = new_env()
  e.set("ten", 10)
  e.set("hundred", 100)
  return e
