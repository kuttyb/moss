# Modern frontend forms: inferred functions, colon-style value types, inferred domain
# state/replies, `=` constructors, pipelines, explicit messages, and assignment-await.

type Quote:
  symbol
  price
  size
  ts

fn square(x) = x * x

fn score(quote):
  value = quote.size |> square
  return value

domain Quotes:
  seen = 0

  fn Latest():
    seen = seen + 1
    reply Quote(symbol = "MOSS", price = 12.5, size = 2, ts = 100)

  fn Note(value: int):
    echo "note:", value

fn main():
  quotes = spawn Quotes()
  quote = await quotes.Latest()
  result = score(quote)
  message quotes.Note(result)
