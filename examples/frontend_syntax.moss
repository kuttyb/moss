# Modern frontend forms: inferred functions, colon-style value types, pipelines,
# explicit messages, and assignment-await syntax.

type Quote:
  symbol
  price
  size
  ts

fn square(x) = x * x

fn score(quote):
  value = quote.size |> square
  return value

domain Quotes:
  fn Latest() -> Quote:
    reply Quote(symbol: "MOSS", price: 12.5, size: 2, ts: 100)

  fn Note(value: int):
    echo "note:", value

fn main():
  quotes = spawn Quotes()
  quote = await quotes.Latest()
  result = score(quote)
  message quotes.Note(result)
