type WorkItem:
  name: string
  revisions: int
  approved: bool

domain Archive:
  fn Store(revisions: int, approved: bool):
    echo "archive: widget", revisions, approved

domain Workshop:
  fn Start(archive: Archive):
    var item = WorkItem(name: "widget", revisions: 0, approved: false)
    item.revisions = item.revisions + 1
    echo "created:", item.name, item.revisions, item.approved
    message self.Observe(item, archive)

  fn Observe(item: WorkItem, archive: Archive):
    echo "observed:", item.name, item.revisions, item.approved
    message self.Revise(item, archive)

  fn Revise(item: WorkItem, archive: Archive):
    var revised = item
    revised.revisions = revised.revisions + 1
    revised.approved = true
    echo "revised:", revised.name, revised.revisions, revised.approved
    message self.Verify(revised, archive)

  fn Verify(item: WorkItem, archive: Archive):
    echo "verified:", item.name, item.revisions, item.approved
    message archive.Store(item.revisions, item.approved)

fn main():
  let archive = spawn Archive()
  let workshop = spawn Workshop()
  message workshop.Start(archive)
