# A named trait is a compile-time contract. Circle and Rectangle both satisfy
# Drawable through their concrete methods. Each render call below selects a
# concrete specialization before Rust is generated; no trait object is created.
type Canvas:
  scale: Int

trait Drawable:
  fn area() -> Int
  fn draw(canvas: Canvas) -> Int

type Circle:
  radius: Int

  fn area():
    return radius * radius

  fn draw(canvas: Canvas):
    return radius * radius * canvas.scale

type Rectangle:
  width: Int
  height: Int

  fn area():
    return width * height

  fn draw(canvas: Canvas):
    return width * height * canvas.scale

fn render(value: Drawable, canvas: Canvas):
  area = value.area()
  painted = value.draw(canvas)
  return area + painted

fn main():
  echo render(Circle(radius = 3), Canvas(scale = 2))
  echo render(Rectangle(width = 4, height = 5), Canvas(scale = 3))
