module ndarray

import linalg
import math

export enum NdArrayError:
  InvalidShape
  Overflow
  DataLengthMismatch
  IndexRankMismatch
  IndexOutOfBounds
  ReshapeSizeMismatch
  BroadcastMismatch
  InvalidAxis
  InvalidPermutation
  SliceOutOfBounds
  EmptyReduction
  MatrixRankMismatch
  MatrixEmptyDimension

export type NdArray:
  shape: Vector[Int]
  strides: Vector[Int]
  data: Vector[Float]

type ShapeInfo:
  strides: Vector[Int]
  count: Int

fn copy_int_vector(values: Vector[Int]) -> Vector[Int]:
  var result = Vector[Int]()
  let length = values |> count
  var i = 0
  while i < length:
    result.push(values[i])
    i = i + 1
  return result

fn copy_float_vector(values: Vector[Float]) -> Vector[Float]:
  var result = Vector[Float]()
  let length = values |> count
  var i = 0
  while i < length:
    result.push(values[i])
    i = i + 1
  return result

fn shape_info(shape: Vector[Int]) -> ShapeInfo:
  let rank_value = shape |> count
  var strides = Vector[Int]()
  var i = 0
  while i < rank_value:
    strides.push(0)
    i = i + 1

  var product = 1
  i = rank_value
  while i > 0:
    i = i - 1
    let dimension = shape[i]
    if dimension < 0:
      raise NdArrayError.InvalidShape
    strides[i] = product
    if dimension == 0:
      product = 0
    else:
      if product > 9223372036854775807 / dimension:
        raise NdArrayError.Overflow
      product = product * dimension
  return ShapeInfo(strides: strides, count: product)

fn require_valid(array: NdArray):
  let info = shape_info(array.shape)
  let rank_value = array.shape |> count
  if (array.strides |> count) != rank_value:
    raise NdArrayError.InvalidShape
  var i = 0
  while i < rank_value:
    if array.strides[i] != info.strides[i]:
      raise NdArrayError.InvalidShape
    i = i + 1
  if (array.data |> count) != info.count:
    raise NdArrayError.DataLengthMismatch

fn checked_offset(array: NdArray, indices: Vector[Int]) -> Int:
  require_valid(array)
  let rank_value = array.shape |> count
  if (indices |> count) != rank_value:
    raise NdArrayError.IndexRankMismatch
  var offset = 0
  var i = 0
  while i < rank_value:
    let index = indices[i]
    if index < 0 or index >= array.shape[i]:
      raise NdArrayError.IndexOutOfBounds
    offset = offset + index * array.strides[i]
    i = i + 1
  return offset

fn aligned_dimension(shape: Vector[Int], output_axis: Int, output_rank: Int) -> Int:
  let source_axis = output_axis - (output_rank - (shape |> count))
  if source_axis < 0:
    return 1
  return shape[source_axis]

fn broadcast_shape(left: NdArray, right: NdArray) -> Vector[Int]:
  let left_rank = left.shape |> count
  let right_rank = right.shape |> count
  var output_rank = left_rank
  if right_rank > output_rank:
    output_rank = right_rank

  var output_shape = Vector[Int]()
  var axis = 0
  while axis < output_rank:
    let left_dimension = aligned_dimension(left.shape, axis, output_rank)
    let right_dimension = aligned_dimension(right.shape, axis, output_rank)
    if left_dimension == right_dimension:
      output_shape.push(left_dimension)
    else:
      if left_dimension == 1:
        output_shape.push(right_dimension)
      else:
        if right_dimension == 1:
          output_shape.push(left_dimension)
        else:
          raise NdArrayError.BroadcastMismatch
    axis = axis + 1
  return output_shape

fn broadcast_offset(array: NdArray, output_shape: Vector[Int], output_strides: Vector[Int], flat_index: Int) -> Int:
  let output_rank = output_shape |> count
  let input_rank = array.shape |> count
  let leading_axes = output_rank - input_rank
  var remaining = flat_index
  var offset = 0
  var output_axis = 0
  while output_axis < output_rank:
    let coordinate = remaining / output_strides[output_axis]
    remaining = remaining % output_strides[output_axis]
    let input_axis = output_axis - leading_axes
    if input_axis >= 0:
      if array.shape[input_axis] != 1:
        offset = offset + coordinate * array.strides[input_axis]
    output_axis = output_axis + 1
  return offset

fn binary_elementwise(left: NdArray, right: NdArray, operation: Int) -> NdArray:
  require_valid(left)
  require_valid(right)
  let output_shape = broadcast_shape(left, right)
  let info = shape_info(output_shape)
  var output_data = Vector[Float]()
  var flat_index = 0
  while flat_index < info.count:
    let left_offset = broadcast_offset(left, output_shape, info.strides, flat_index)
    let right_offset = broadcast_offset(right, output_shape, info.strides, flat_index)
    var value = 0.0
    if operation == 0:
      value = left.data[left_offset] + right.data[right_offset]
    else:
      if operation == 1:
        value = left.data[left_offset] - right.data[right_offset]
      else:
        if operation == 2:
          value = left.data[left_offset] * right.data[right_offset]
        else:
          value = left.data[left_offset] / right.data[right_offset]
    output_data.push(value)
    flat_index = flat_index + 1
  return NdArray(shape: output_shape, strides: info.strides, data: output_data)

fn scalar_elementwise(array: NdArray, value: Float, operation: Int) -> NdArray:
  require_valid(array)
  var output_data = Vector[Float]()
  let length = array.data |> count
  var i = 0
  while i < length:
    var result = 0.0
    if operation == 0:
      result = array.data[i] + value
    else:
      if operation == 1:
        result = array.data[i] - value
      else:
        if operation == 2:
          result = array.data[i] * value
        else:
          result = array.data[i] / value
    output_data.push(result)
    i = i + 1
  return NdArray(shape: copy_int_vector(array.shape), strides: copy_int_vector(array.strides), data: output_data)

fn reduction_shape(shape: Vector[Int], axis: Int) -> Vector[Int]:
  var output_shape = Vector[Int]()
  let rank_value = shape |> count
  var i = 0
  while i < rank_value:
    if i != axis:
      output_shape.push(shape[i])
    i = i + 1
  return output_shape

fn reduction_base_offset(array: NdArray, axis: Int, output_strides: Vector[Int], flat_index: Int) -> Int:
  let rank_value = array.shape |> count
  var remaining = flat_index
  var source_axis = 0
  var output_axis = 0
  var offset = 0
  while source_axis < rank_value:
    if source_axis != axis:
      let coordinate = remaining / output_strides[output_axis]
      remaining = remaining % output_strides[output_axis]
      offset = offset + coordinate * array.strides[source_axis]
      output_axis = output_axis + 1
    source_axis = source_axis + 1
  return offset

fn reduction_lane_sum(array: NdArray, offset: Int, stride: Int, length: Int) -> Float:
  var has_nan = false
  var has_positive_infinity = false
  var has_negative_infinity = false
  var i = 0
  while i < length:
    let value = array.data[offset + i * stride]
    if math.is_nan(value):
      has_nan = true
    else:
      if math.is_infinite(value):
        if value > 0.0:
          has_positive_infinity = true
        else:
          has_negative_infinity = true
    i = i + 1

  if has_nan or (has_positive_infinity and has_negative_infinity):
    return math.nan()
  if has_positive_infinity:
    return math.infinity()
  if has_negative_infinity:
    return math.neg_infinity()

  var sum = 0.0
  var compensation = 0.0
  i = 0
  while i < length:
    let value = array.data[offset + i * stride]
    let next_sum = sum + value
    if math.abs(sum) >= math.abs(value):
      compensation = compensation + ((sum - next_sum) + value)
    else:
      compensation = compensation + ((value - next_sum) + sum)
    sum = next_sum
    i = i + 1
  return sum + compensation

fn reduce_axis(array: NdArray, axis: Int, operation: Int) -> NdArray:
  require_valid(array)
  let rank_value = array.shape |> count
  if axis < 0 or axis >= rank_value:
    raise NdArrayError.InvalidAxis

  let output_shape = reduction_shape(array.shape, axis)
  let info = shape_info(output_shape)
  let reduction_length = array.shape[axis]
  if reduction_length == 0 and operation != 0 and info.count > 0:
    raise NdArrayError.EmptyReduction

  var output_data = Vector[Float]()
  var flat_index = 0
  while flat_index < info.count:
    let offset = reduction_base_offset(array, axis, info.strides, flat_index)
    let stride = array.strides[axis]
    if operation == 0:
      output_data.push(reduction_lane_sum(array, offset, stride, reduction_length))
    else:
      if operation == 3:
        let total = reduction_lane_sum(array, offset, stride, reduction_length)
        output_data.push(total / (reduction_length * 1.0))
      else:
        var value = array.data[offset]
        var i = 1
        while i < reduction_length:
          let candidate = array.data[offset + i * stride]
          if math.is_nan(candidate):
            value = candidate
          else:
            if not math.is_nan(value):
              if operation == 1:
                value = math.min(value, candidate)
              else:
                value = math.max(value, candidate)
          i = i + 1
        output_data.push(value)
    flat_index = flat_index + 1
  return NdArray(shape: output_shape, strides: info.strides, data: output_data)

export fn validate(array: NdArray) -> Bool:
  let rank_value = array.shape |> count
  if (array.strides |> count) != rank_value:
    return false
  var product = 1
  var i = rank_value
  while i > 0:
    i = i - 1
    let dimension = array.shape[i]
    if dimension < 0:
      return false
    if array.strides[i] != product:
      return false
    if dimension == 0:
      product = 0
    else:
      if product > 9223372036854775807 / dimension:
        return false
      product = product * dimension
  return (array.data |> count) == product

export fn from_flat(shape: Vector[Int], data: Vector[Float]) -> NdArray:
  let info = shape_info(shape)
  if (data |> count) != info.count:
    raise NdArrayError.DataLengthMismatch
  return NdArray(shape: copy_int_vector(shape), strides: info.strides, data: copy_float_vector(data))

export fn scalar(value: Float) -> NdArray:
  return NdArray(shape: Vector[Int](), strides: Vector[Int](), data: [value])

export fn full(shape: Vector[Int], value: Float) -> NdArray:
  let info = shape_info(shape)
  var data = Vector[Float]()
  var i = 0
  while i < info.count:
    data.push(value)
    i = i + 1
  return NdArray(shape: copy_int_vector(shape), strides: info.strides, data: data)

export fn zeros(shape: Vector[Int]) -> NdArray:
  return full(shape, 0.0)

export fn ones(shape: Vector[Int]) -> NdArray:
  return full(shape, 1.0)

export fn rank(array: NdArray) -> Int:
  require_valid(array)
  return array.shape |> count

export fn shape_copy(array: NdArray) -> Vector[Int]:
  require_valid(array)
  return copy_int_vector(array.shape)

export fn size(array: NdArray, axis: Int) -> Int:
  require_valid(array)
  let rank_value = array.shape |> count
  if axis < 0 or axis >= rank_value:
    raise NdArrayError.InvalidAxis
  return array.shape[axis]

export fn element_count(array: NdArray) -> Int:
  require_valid(array)
  return array.data |> count

export fn get(array: NdArray, indices: Vector[Int]) -> Float:
  let offset = checked_offset(array, indices)
  return array.data[offset]

export fn set(array: NdArray, indices: Vector[Int], value: Float):
  let offset = checked_offset(array, indices)
  array.data[offset] = value

export fn array_clone(array: NdArray) -> NdArray:
  require_valid(array)
  return NdArray(shape: copy_int_vector(array.shape), strides: copy_int_vector(array.strides), data: copy_float_vector(array.data))

export fn flatten(array: NdArray) -> Vector[Float]:
  require_valid(array)
  return copy_float_vector(array.data)

export fn reshape(array: NdArray, shape: Vector[Int]) -> NdArray:
  require_valid(array)
  let info = shape_info(shape)
  if info.count != (array.data |> count):
    raise NdArrayError.ReshapeSizeMismatch
  return NdArray(shape: copy_int_vector(shape), strides: info.strides, data: copy_float_vector(array.data))

export fn add(left: NdArray, right: NdArray) -> NdArray:
  return binary_elementwise(left, right, 0)

export fn subtract(left: NdArray, right: NdArray) -> NdArray:
  return binary_elementwise(left, right, 1)

export fn multiply(left: NdArray, right: NdArray) -> NdArray:
  return binary_elementwise(left, right, 2)

export fn divide(left: NdArray, right: NdArray) -> NdArray:
  return binary_elementwise(left, right, 3)

export fn add_scalar(array: NdArray, value: Float) -> NdArray:
  return scalar_elementwise(array, value, 0)

export fn subtract_scalar(array: NdArray, value: Float) -> NdArray:
  return scalar_elementwise(array, value, 1)

export fn multiply_scalar(array: NdArray, value: Float) -> NdArray:
  return scalar_elementwise(array, value, 2)

export fn divide_scalar(array: NdArray, value: Float) -> NdArray:
  return scalar_elementwise(array, value, 3)

export fn slice_copy(array: NdArray, starts: Vector[Int], stops: Vector[Int], steps: Vector[Int]) -> NdArray:
  require_valid(array)
  let rank_value = array.shape |> count
  if (starts |> count) != rank_value or (stops |> count) != rank_value or (steps |> count) != rank_value:
    raise NdArrayError.SliceOutOfBounds

  var output_shape = Vector[Int]()
  var axis = 0
  while axis < rank_value:
    let start = starts[axis]
    let stop = stops[axis]
    let step = steps[axis]
    if start < 0 or stop < start or stop > array.shape[axis] or step <= 0:
      raise NdArrayError.SliceOutOfBounds
    let distance = stop - start
    var dimension = distance / step
    if distance % step != 0:
      dimension = dimension + 1
    output_shape.push(dimension)
    axis = axis + 1

  let info = shape_info(output_shape)
  var output_data = Vector[Float]()
  var flat_index = 0
  while flat_index < info.count:
    var remaining = flat_index
    var source_offset = 0
    axis = 0
    while axis < rank_value:
      let coordinate = remaining / info.strides[axis]
      remaining = remaining % info.strides[axis]
      let source_coordinate = starts[axis] + coordinate * steps[axis]
      source_offset = source_offset + source_coordinate * array.strides[axis]
      axis = axis + 1
    output_data.push(array.data[source_offset])
    flat_index = flat_index + 1
  return NdArray(shape: output_shape, strides: info.strides, data: output_data)

export fn subarray_copy(array: NdArray, origin: Vector[Int], shape: Vector[Int]) -> NdArray:
  require_valid(array)
  let rank_value = array.shape |> count
  if (origin |> count) != rank_value or (shape |> count) != rank_value:
    raise NdArrayError.SliceOutOfBounds
  var stops = Vector[Int]()
  var steps = Vector[Int]()
  var axis = 0
  while axis < rank_value:
    let start = origin[axis]
    let dimension = shape[axis]
    if start < 0 or dimension < 0 or start > array.shape[axis] or dimension > array.shape[axis] - start:
      raise NdArrayError.SliceOutOfBounds
    stops.push(start + dimension)
    steps.push(1)
    axis = axis + 1
  return slice_copy(array, origin, stops, steps)

export fn sum_axis(array: NdArray, axis: Int) -> NdArray:
  return reduce_axis(array, axis, 0)

export fn min_axis(array: NdArray, axis: Int) -> NdArray:
  return reduce_axis(array, axis, 1)

export fn max_axis(array: NdArray, axis: Int) -> NdArray:
  return reduce_axis(array, axis, 2)

export fn mean_axis(array: NdArray, axis: Int) -> NdArray:
  return reduce_axis(array, axis, 3)

export fn permute_axes(array: NdArray, axes: Vector[Int]) -> NdArray:
  require_valid(array)
  let rank_value = array.shape |> count
  if (axes |> count) != rank_value:
    raise NdArrayError.InvalidPermutation

  var seen = Vector[Bool]()
  var i = 0
  while i < rank_value:
    seen.push(false)
    i = i + 1

  var new_shape = Vector[Int]()
  i = 0
  while i < rank_value:
    let axis = axes[i]
    if axis < 0 or axis >= rank_value:
      raise NdArrayError.InvalidPermutation
    if seen[axis]:
      raise NdArrayError.InvalidPermutation
    seen[axis] = true
    new_shape.push(array.shape[axis])
    i = i + 1

  let info = shape_info(new_shape)
  var data = Vector[Float]()
  var flat_index = 0
  while flat_index < info.count:
    var remaining = flat_index
    var source_offset = 0
    i = 0
    while i < rank_value:
      let coordinate = remaining / info.strides[i]
      remaining = remaining % info.strides[i]
      let source_axis = axes[i]
      source_offset = source_offset + coordinate * array.strides[source_axis]
      i = i + 1
    data.push(array.data[source_offset])
    flat_index = flat_index + 1
  return NdArray(shape: new_shape, strides: info.strides, data: data)

export fn transpose(array: NdArray) -> NdArray:
  require_valid(array)
  if (array.shape |> count) != 2:
    raise NdArrayError.InvalidPermutation
  return permute_axes(array, [1, 0])

export fn from_matrix(matrix: linalg.Matrix) -> NdArray:
  if matrix.rows <= 0 or matrix.cols <= 0:
    raise NdArrayError.MatrixEmptyDimension
  if matrix.rows > 9223372036854775807 / matrix.cols:
    raise NdArrayError.Overflow
  let expected = matrix.rows * matrix.cols
  if (matrix.data |> count) != expected:
    raise NdArrayError.DataLengthMismatch
  return from_flat([matrix.rows, matrix.cols], matrix.data)

export fn to_matrix(array: NdArray) -> linalg.Matrix:
  require_valid(array)
  if (array.shape |> count) != 2:
    raise NdArrayError.MatrixRankMismatch
  if array.shape[0] == 0 or array.shape[1] == 0:
    raise NdArrayError.MatrixEmptyDimension
  return linalg.from_vector(array.shape[0], array.shape[1], array.data)
