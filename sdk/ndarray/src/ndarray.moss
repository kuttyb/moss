module ndarray

import linalg

export enum NdArrayError:
  InvalidShape
  Overflow
  DataLengthMismatch
  IndexRankMismatch
  IndexOutOfBounds
  ReshapeSizeMismatch
  BroadcastMismatch
  InvalidAxis
  InvalidPermutation
  SliceOutOfBounds
  EmptyReduction
  MatrixRankMismatch
  MatrixEmptyDimension

export type NdArray:
  shape: Vector[Int]
  strides: Vector[Int]
  data: Vector[Float]

type ShapeInfo:
  strides: Vector[Int]
  count: Int

fn copy_int_vector(values: Vector[Int]) -> Vector[Int]:
  var result = Vector[Int]()
  let length = values |> count
  var i = 0
  while i < length:
    result.push(values[i])
    i = i + 1
  return result

fn copy_float_vector(values: Vector[Float]) -> Vector[Float]:
  var result = Vector[Float]()
  let length = values |> count
  var i = 0
  while i < length:
    result.push(values[i])
    i = i + 1
  return result

fn shape_info(shape: Vector[Int]) -> ShapeInfo:
  let rank_value = shape |> count
  var strides = Vector[Int]()
  var i = 0
  while i < rank_value:
    strides.push(0)
    i = i + 1

  var product = 1
  i = rank_value
  while i > 0:
    i = i - 1
    let dimension = shape[i]
    if dimension < 0:
      raise NdArrayError.InvalidShape
    strides[i] = product
    if dimension == 0:
      product = 0
    else:
      if product > 9223372036854775807 / dimension:
        raise NdArrayError.Overflow
      product = product * dimension
  return ShapeInfo(strides: strides, count: product)

fn require_valid(array: NdArray):
  let info = shape_info(array.shape)
  let rank_value = array.shape |> count
  if (array.strides |> count) != rank_value:
    raise NdArrayError.InvalidShape
  var i = 0
  while i < rank_value:
    if array.strides[i] != info.strides[i]:
      raise NdArrayError.InvalidShape
    i = i + 1
  if (array.data |> count) != info.count:
    raise NdArrayError.DataLengthMismatch

fn checked_offset(array: NdArray, indices: Vector[Int]) -> Int:
  require_valid(array)
  let rank_value = array.shape |> count
  if (indices |> count) != rank_value:
    raise NdArrayError.IndexRankMismatch
  var offset = 0
  var i = 0
  while i < rank_value:
    let index = indices[i]
    if index < 0 or index >= array.shape[i]:
      raise NdArrayError.IndexOutOfBounds
    offset = offset + index * array.strides[i]
    i = i + 1
  return offset

export fn validate(array: NdArray) -> Bool:
  let rank_value = array.shape |> count
  if (array.strides |> count) != rank_value:
    return false
  var product = 1
  var i = rank_value
  while i > 0:
    i = i - 1
    let dimension = array.shape[i]
    if dimension < 0:
      return false
    if array.strides[i] != product:
      return false
    if dimension == 0:
      product = 0
    else:
      if product > 9223372036854775807 / dimension:
        return false
      product = product * dimension
  return (array.data |> count) == product

export fn from_flat(shape: Vector[Int], data: Vector[Float]) -> NdArray:
  let info = shape_info(shape)
  if (data |> count) != info.count:
    raise NdArrayError.DataLengthMismatch
  return NdArray(shape: copy_int_vector(shape), strides: info.strides, data: copy_float_vector(data))

export fn scalar(value: Float) -> NdArray:
  return NdArray(shape: Vector[Int](), strides: Vector[Int](), data: [value])

export fn full(shape: Vector[Int], value: Float) -> NdArray:
  let info = shape_info(shape)
  var data = Vector[Float]()
  var i = 0
  while i < info.count:
    data.push(value)
    i = i + 1
  return NdArray(shape: copy_int_vector(shape), strides: info.strides, data: data)

export fn zeros(shape: Vector[Int]) -> NdArray:
  return full(shape, 0.0)

export fn ones(shape: Vector[Int]) -> NdArray:
  return full(shape, 1.0)

export fn rank(array: NdArray) -> Int:
  require_valid(array)
  return array.shape |> count

export fn shape_copy(array: NdArray) -> Vector[Int]:
  require_valid(array)
  return copy_int_vector(array.shape)

export fn size(array: NdArray, axis: Int) -> Int:
  require_valid(array)
  let rank_value = array.shape |> count
  if axis < 0 or axis >= rank_value:
    raise NdArrayError.InvalidAxis
  return array.shape[axis]

export fn element_count(array: NdArray) -> Int:
  require_valid(array)
  return array.data |> count

export fn get(array: NdArray, indices: Vector[Int]) -> Float:
  let offset = checked_offset(array, indices)
  return array.data[offset]

export fn set(array: NdArray, indices: Vector[Int], value: Float):
  let offset = checked_offset(array, indices)
  array.data[offset] = value

export fn array_clone(array: NdArray) -> NdArray:
  require_valid(array)
  return NdArray(shape: copy_int_vector(array.shape), strides: copy_int_vector(array.strides), data: copy_float_vector(array.data))

export fn flatten(array: NdArray) -> Vector[Float]:
  require_valid(array)
  return copy_float_vector(array.data)

export fn reshape(array: NdArray, shape: Vector[Int]) -> NdArray:
  require_valid(array)
  let info = shape_info(shape)
  if info.count != (array.data |> count):
    raise NdArrayError.ReshapeSizeMismatch
  return NdArray(shape: copy_int_vector(shape), strides: info.strides, data: copy_float_vector(array.data))

export fn permute_axes(array: NdArray, axes: Vector[Int]) -> NdArray:
  require_valid(array)
  let rank_value = array.shape |> count
  if (axes |> count) != rank_value:
    raise NdArrayError.InvalidPermutation

  var seen = Vector[Bool]()
  var i = 0
  while i < rank_value:
    seen.push(false)
    i = i + 1

  var new_shape = Vector[Int]()
  i = 0
  while i < rank_value:
    let axis = axes[i]
    if axis < 0 or axis >= rank_value:
      raise NdArrayError.InvalidPermutation
    if seen[axis]:
      raise NdArrayError.InvalidPermutation
    seen[axis] = true
    new_shape.push(array.shape[axis])
    i = i + 1

  let info = shape_info(new_shape)
  var data = Vector[Float]()
  var flat_index = 0
  while flat_index < info.count:
    var remaining = flat_index
    var source_offset = 0
    i = 0
    while i < rank_value:
      let coordinate = remaining / info.strides[i]
      remaining = remaining % info.strides[i]
      let source_axis = axes[i]
      source_offset = source_offset + coordinate * array.strides[source_axis]
      i = i + 1
    data.push(array.data[source_offset])
    flat_index = flat_index + 1
  return NdArray(shape: new_shape, strides: info.strides, data: data)

export fn transpose(array: NdArray) -> NdArray:
  require_valid(array)
  if (array.shape |> count) != 2:
    raise NdArrayError.InvalidPermutation
  return permute_axes(array, [1, 0])

export fn from_matrix(matrix: linalg.Matrix) -> NdArray:
  if matrix.rows <= 0 or matrix.cols <= 0:
    raise NdArrayError.MatrixEmptyDimension
  if matrix.rows > 9223372036854775807 / matrix.cols:
    raise NdArrayError.Overflow
  let expected = matrix.rows * matrix.cols
  if (matrix.data |> count) != expected:
    raise NdArrayError.DataLengthMismatch
  return from_flat([matrix.rows, matrix.cols], matrix.data)

export fn to_matrix(array: NdArray) -> linalg.Matrix:
  require_valid(array)
  if (array.shape |> count) != 2:
    raise NdArrayError.MatrixRankMismatch
  if array.shape[0] == 0 or array.shape[1] == 0:
    raise NdArrayError.MatrixEmptyDimension
  return linalg.from_vector(array.shape[0], array.shape[1], array.data)
