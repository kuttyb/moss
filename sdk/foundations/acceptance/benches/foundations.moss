import bytes
import algorithms

bench "sort 256 descending Ints":
  var values = Vector[Int]()
  var i = 256
  while i > 0:
    values.push(i)
    i = i - 1
  algorithms.sort_int(values)
  values[0]

bench "sort 256 permuted Ints":
  var values = Vector[Int]()
  var i = 0
  while i < 256:
    values.push((i * 73) % 257)
    i = i + 1
  algorithms.sort_int(values)
  values[0]

bench "copy 512 owned bytes":
  var values = Vector[Int]()
  var i = 0
  while i < 512:
    values.push(i % 256)
    i = i + 1
  copied = bytes.copy_bytes(values)
  copied[511]
