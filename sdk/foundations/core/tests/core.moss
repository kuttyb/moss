module core

test "min and max":
  assertEqual(min_int(4, 7), 4)
  assertEqual(max_int(4, 7), 7)
  assertEqual(min_int(4, 4), 4)

test "valid indices":
  assert(valid_index(0, 1))
  assert(not valid_index(-1, 1))
  assert(not valid_index(0, 0))
  assert(not valid_index(1, 1))
  assert(not valid_index(0, -1))

test "valid slices":
  assert(valid_slice(0, 0, 0))
  assert(valid_slice(1, 2, 3))
  assert(valid_slice(3, 0, 3))
  assert(not valid_slice(2, 2, 3))
  assert(not valid_slice(-1, 1, 3))
  assert(not valid_slice(1, -1, 3))
  assert(not valid_slice(0, 0, -1))
  assert(not valid_slice(3, 1, 3))
  assert(valid_slice(9223372036854775807, 0, 9223372036854775807))
  assert(not valid_slice(9223372036854775807, 1, 9223372036854775807))

test "clamp boundaries":
  assertEqual(clamp_int(-4, 0, 10), 0)
  assertEqual(clamp_int(15, 0, 10), 10)
  assertEqual(clamp_int(5, 0, 10), 5)
  assertEqual(clamp_int(1, 2, 2), 2)
