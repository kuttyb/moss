module bytes

test "byte validity":
  assert(is_byte(0))
  assert(is_byte(255))
  assert(not is_byte(-1))
  assert(not is_byte(256))
  assert(all_bytes(Vector[Int]()))
  assert(all_bytes([0, 127, 255]))
  assert(not all_bytes([0, 256]))
  assert(not all_bytes([999, 1]))

test "copy and clipped slice":
  var source = [10, 20, 30]
  copied = copy_bytes(source)
  assertEqual(copied |> count, 3)
  assertEqual(copied[1], 20)
  part = slice_bytes(source, 1, 100)
  assertEqual(part |> count, 2)
  assertEqual(part[0], 20)
  assertEqual(part[1], 30)
  assertEqual(slice_bytes(source, -1, 2) |> count, 0)
  assertEqual(slice_bytes(source, 3, 2) |> count, 0)
  assertEqual(slice_bytes(source, 0, 0) |> count, 0)
  selected = slice_bytes([999, 20, 30], 1, 2)
  assertEqual(selected[0], 20)
  assertEqual(selected[1], 30)
  source[1] = 99
  assertEqual(copied[1], 20)
  assertEqual(part[0], 20)

test "safe reads and writes":
  var values = [1, 2]
  assertEqual(get_or(values, -1, 9), 9)
  assertEqual(get_or(values, 1, 9), 2)
  assert(not set_if_valid(values, 2, 5))
  assert(not set_if_valid(values, -1, 5))
  assert(not set_if_valid(values, 0, 256))
  assert(set_if_valid(values, 0, 255))
  assert(not append_if_valid(values, -1))
  assert(append_if_valid(values, 0))
  assertEqual(values |> count, 3)
  assertEqual(values[0], 255)
  assertEqual(values[2], 0)
