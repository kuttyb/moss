import collections

bench "index of last in 256 Ints":
  var values = Vector[Int]()
  var i = 0
  while i < 256:
    values.push(i)
    i = i + 1
  collections.index_of(values, 255)

bench "reverse copy of 256 Ints":
  var values = Vector[Int]()
  var i = 0
  while i < 256:
    values.push(i)
    i = i + 1
  reversed = collections.reversed_copy_int(values)
  reversed[0]
