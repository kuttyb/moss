import algorithms

bench "sort 256 descending Ints":
  var values = Vector[Int]()
  var i = 256
  while i > 0:
    values.push(i)
    i = i - 1
  algorithms.sort_int(values)
  values[0]

bench "lower bound in 256 Ints":
  var values = Vector[Int]()
  var i = 0
  while i < 256:
    values.push(i)
    i = i + 1
  algorithms.lower_bound_int(values, 128)
