module algorithms

# Restore the max-heap property below start in items[0..end).
fn sift_down_int(items: Vector[Int], start: Int, end: Int):
  var root = start
  while root < end / 2:
    var child = root * 2 + 1
    if child + 1 < end and items[child] < items[child + 1]:
      child = child + 1
    if items[root] < items[child]:
      tmp = items[root]
      items[root] = items[child]
      items[child] = tmp
      root = child
    else:
      return

# Sorts a writable Int vector ascending, in place.
# Worst-case time O(n log n); extra storage O(1).
export fn sort_int(items: Vector[Int]):
  n = items |> count
  var start = n / 2
  while start > 0:
    start = start - 1
    sift_down_int(items, start, n)
  var end = n
  while end > 1:
    end = end - 1
    tmp = items[0]
    items[0] = items[end]
    items[end] = tmp
    sift_down_int(items, 0, end)

# Requires ascending sorted input. Returns the first index with value >= target,
# or the vector length when every value is less than target.
export fn lower_bound_int(items: Vector[Int], target: Int) -> Int:
  var low = 0
  var high = items |> count
  while low < high:
    mid = low + (high - low) / 2
    if items[mid] < target:
      low = mid + 1
    else:
      high = mid
  return low

# Requires ascending sorted input. Returns the first equal index, or -1.
export fn binary_search_int(items: Vector[Int], target: Int) -> Int:
  index = lower_bound_int(items, target)
  n = items |> count
  if index < n:
    if items[index] == target:
      return index
  return 0 - 1
