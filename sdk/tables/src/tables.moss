fn group_extreme_int(table: Table, groups: GroupIndex, name: String, minimum: Bool) -> IntColumnValues:
  require_group_table(groups, table)
  index = require_named_column(table, name, kind_int())
  column = clone_column_unchecked(table.columns[index])
  var values = Vector[Int]()
  var validity = Vector[Bool]()
  var group = 0
  group_total = groups.sizes |> count
  while group < group_total:
    var result = 0
    var present = false
    var row = groups.first_rows[group]
    while row >= 0:
      if column.validity[row]:
        value = column.ints[row]
        if not present or (minimum and value < result) or (not minimum and value > result):
          result = value
        present = true
      row = groups.next_rows[row]
    values.push(result)
    validity.push(present)
    group = group + 1
  return IntColumnValues(values: values, validity: validity)

fn group_extreme_float(table: Table, groups: GroupIndex, name: String, minimum: Bool) -> FloatColumnValues:
  require_group_table(groups, table)
  index = require_named_column(table, name, kind_float())
  column = clone_column_unchecked(table.columns[index])
  var values = Vector[Float]()
  var validity = Vector[Bool]()
  var group = 0
  group_total = groups.sizes |> count
  while group < group_total:
    var result = 0.0
    var present = false
    var row = groups.first_rows[group]
    while row >= 0:
      if column.validity[row]:
        value = column.floats[row]
        if not present or is_nan(value) or (not is_nan(result) and minimum and value < result) or (not is_nan(result) and not minimum and value > result):
          result = value
        present = true
      row = groups.next_rows[row]
    values.push(result)
    validity.push(present)
    group = group + 1
  return FloatColumnValues(values: values, validity: validity)

export fn group_min_int(table: Table, groups: GroupIndex, name: String) -> IntColumnValues:
  return group_extreme_int(table, groups, name, true)

export fn group_max_int(table: Table, groups: GroupIndex, name: String) -> IntColumnValues:
  return group_extreme_int(table, groups, name, false)

export fn group_min_float(table: Table, groups: GroupIndex, name: String) -> FloatColumnValues:
  return group_extreme_float(table, groups, name, true)

export fn group_max_float(table: Table, groups: GroupIndex, name: String) -> FloatColumnValues:
  return group_extreme_float(table, groups, name, false)

fn contains_string(values: Vector[String], value: String) -> Bool:
  var i = 0
  n = values |> count
  while i < n:
    if values[i] == value:
      return true
    i = i + 1
  return false

fn right_join_names(left: Table, right: Table, right_key_index: Int, suffix: String) -> Vector[String]:
  var left_names = Vector[String]()
  var used = Vector[String]()
  var i = 0
  left_count = left.columns |> count
  while i < left_count:
    left_names.push(left.columns[i].name + "")
    used.push(left.columns[i].name + "")
    i = i + 1
  var names = Vector[String]()
  i = 0
  right_count = right.columns |> count
  while i < right_count:
    if i != right_key_index:
      original = right.columns[i].name + ""
      var output_name = original + ""
      if contains_string(left_names, output_name):
        if suffix.length() == 0:
          raise TableError.DuplicateColumnName
        output_name = original + suffix
      if contains_string(used, output_name):
        raise TableError.DuplicateColumnName
      used.push(output_name + "")
      names.push(output_name + "")
    i = i + 1
  return names

fn append_join_pair(left_rows: Vector[Int], right_rows: Vector[Int], left_row: Int, right_row: Int, limit: Int):
  current = left_rows |> count
  if current == 9223372036854775807:
    raise TableError.IntegerOverflow
  if current >= limit:
    raise TableError.OutputLimitExceeded(limit: limit)
  left_rows.push(left_row)
  right_rows.push(right_row)

fn joined_right_column(column: Column, output_name: String, right_rows: Vector[Int], force_nullable: Bool) -> Column:
  var validity = Vector[Bool]()
  var ints = Vector[Int]()
  var floats = Vector[Float]()
  var bools = Vector[Bool]()
  var strings = Vector[String]()
  var i = 0
  n = right_rows |> count
  while i < n:
    row = right_rows[i]
    var present = false
    if row >= 0:
      present = column.validity[row]
    validity.push(present)
    if column.kind == kind_int():
      if present:
        ints.push(column.ints[row])
      else:
        ints.push(0)
    else:
      if column.kind == kind_float():
        if present:
          floats.push(column.floats[row])
        else:
          floats.push(0.0)
      else:
        if column.kind == kind_bool():
          if present:
            bools.push(column.bools[row])
          else:
            bools.push(false)
        else:
          if present:
            strings.push(column.strings[row] + "")
          else:
            strings.push("")
    i = i + 1
  return Column(name: output_name + "", kind: column.kind, nullable: force_nullable or column.nullable, validity: validity, ints: ints, floats: floats, bools: bools, strings: strings)

fn assemble_join(left: Table, right: Table, right_key_index: Int, names: Vector[String], left_rows: Vector[Int], right_rows: Vector[Int], left_join: Bool) -> Table:
  var result = select_rows_unchecked(left, left_rows)
  var right_column_index = 0
  var name_index = 0
  right_count = right.columns |> count
  while right_column_index < right_count:
    if right_column_index != right_key_index:
      column = joined_right_column(right.columns[right_column_index], names[name_index], right_rows, left_join)
      push_column(result.columns, column)
      name_index = name_index + 1
    right_column_index = right_column_index + 1
  return result

fn require_output_limit(limit: Int):
  if limit < 0:
    raise TableError.InvalidOutputLimit(limit: limit)

export fn inner_join_int(left: Table, right: Table, left_key: String, right_key: String, right_suffix: String, max_output_rows: Int) -> Table:
  require_valid_table(left)
  require_valid_table(right)
  require_output_limit(max_output_rows)
  left_key_index = require_named_column(left, left_key, kind_int())
  right_key_index = require_named_column(right, right_key, kind_int())
  names = right_join_names(left, right, right_key_index, right_suffix)
  right_groups = group_by_int(right, right_key)
  var group_lookup = empty_int_int_map()
  var group = 0
  group_total = right_groups.sizes |> count
  while group < group_total:
    if right_groups.key_validity[group]:
      group_lookup[right_groups.int_keys[group]] = group
    group = group + 1
  left_column = clone_column_unchecked(left.columns[left_key_index])
  var left_rows = Vector[Int]()
  var right_rows = Vector[Int]()
  var left_row = 0
  while left_row < left.row_count:
    if left_column.validity[left_row]:
      match_group = group_lookup.get(left_column.ints[left_row], -1)
      if match_group >= 0:
        var right_row = right_groups.first_rows[match_group]
        while right_row >= 0:
          append_join_pair(left_rows, right_rows, left_row, right_row, max_output_rows)
          right_row = right_groups.next_rows[right_row]
    left_row = left_row + 1
  return assemble_join(left, right, right_key_index, names, left_rows, right_rows, false)

export fn left_join_int(left: Table, right: Table, left_key: String, right_key: String, right_suffix: String, max_output_rows: Int) -> Table:
  require_valid_table(left)
  require_valid_table(right)
  require_output_limit(max_output_rows)
  left_key_index = require_named_column(left, left_key, kind_int())
  right_key_index = require_named_column(right, right_key, kind_int())
  names = right_join_names(left, right, right_key_index, right_suffix)
  right_groups = group_by_int(right, right_key)
  var group_lookup = empty_int_int_map()
  var group = 0
  group_total = right_groups.sizes |> count
  while group < group_total:
    if right_groups.key_validity[group]:
      group_lookup[right_groups.int_keys[group]] = group
    group = group + 1
  left_column = clone_column_unchecked(left.columns[left_key_index])
  var left_rows = Vector[Int]()
  var right_rows = Vector[Int]()
  var left_row = 0
  while left_row < left.row_count:
    var matched = false
    if left_column.validity[left_row]:
      match_group = group_lookup.get(left_column.ints[left_row], -1)
      if match_group >= 0:
        var right_row = right_groups.first_rows[match_group]
        while right_row >= 0:
          append_join_pair(left_rows, right_rows, left_row, right_row, max_output_rows)
          matched = true
          right_row = right_groups.next_rows[right_row]
    if not matched:
      append_join_pair(left_rows, right_rows, left_row, -1, max_output_rows)
    left_row = left_row + 1
  return assemble_join(left, right, right_key_index, names, left_rows, right_rows, true)

export fn inner_join_string(left: Table, right: Table, left_key: String, right_key: String, right_suffix: String, max_output_rows: Int) -> Table:
  require_valid_table(left)
  require_valid_table(right)
  require_output_limit(max_output_rows)
  left_key_index = require_named_column(left, left_key, kind_string())
  right_key_index = require_named_column(right, right_key, kind_string())
  names = right_join_names(left, right, right_key_index, right_suffix)
  right_groups = group_by_string(right, right_key)
  var group_lookup = empty_string_int_map()
  var group = 0
  group_total = right_groups.sizes |> count
  while group < group_total:
    if right_groups.key_validity[group]:
      group_lookup[right_groups.string_keys[group]] = group
    group = group + 1
  left_column = clone_column_unchecked(left.columns[left_key_index])
  var left_rows = Vector[Int]()
  var right_rows = Vector[Int]()
  var left_row = 0
  while left_row < left.row_count:
    if left_column.validity[left_row]:
      match_group = group_lookup.get(left_column.strings[left_row], -1)
      if match_group >= 0:
        var right_row = right_groups.first_rows[match_group]
        while right_row >= 0:
          append_join_pair(left_rows, right_rows, left_row, right_row, max_output_rows)
          right_row = right_groups.next_rows[right_row]
    left_row = left_row + 1
  return assemble_join(left, right, right_key_index, names, left_rows, right_rows, false)

export fn left_join_string(left: Table, right: Table, left_key: String, right_key: String, right_suffix: String, max_output_rows: Int) -> Table:
  require_valid_table(left)
  require_valid_table(right)
  require_output_limit(max_output_rows)
  left_key_index = require_named_column(left, left_key, kind_string())
  right_key_index = require_named_column(right, right_key, kind_string())
