fn row_precedes(column: Column, left: Int, right: Int, ascending: Bool) -> Bool:
  left_valid = column.validity[left]
  right_valid = column.validity[right]
  if left_valid and not right_valid:
    return true
  if not left_valid:
    return false
  if not right_valid:
    return false
  if column.kind == kind_int():
    if ascending:
      return column.ints[left] < column.ints[right]
    return column.ints[left] > column.ints[right]
  if column.kind == kind_float():
    left_nan = is_nan(column.floats[left])
    right_nan = is_nan(column.floats[right])
    if left_nan:
      return false
    if right_nan:
      return true
    if ascending:
      return column.floats[left] < column.floats[right]
    return column.floats[left] > column.floats[right]
  if column.kind == kind_bool():
    if column.bools[left] == column.bools[right]:
      return false
    if ascending:
      return not column.bools[left]
    return column.bools[left]
  return false

fn stable_order(column: Column, row_count_value: Int, ascending: Bool) -> Vector[Int]:
  var order = Vector[Int]()
  var row = 0
  while row < row_count_value:
    order.push(row)
    row = row + 1
  var width = 1
  while width < row_count_value:
    var merged = Vector[Int]()
    var start = 0
    while start < row_count_value:
      remaining = row_count_value - start
      var middle = row_count_value
      if width < remaining:
        middle = start + width
      var finish = row_count_value
      after_middle = row_count_value - middle
      if width < after_middle:
        finish = middle + width
      var left = start
      var right = middle
      while left < middle and right < finish:
        if row_precedes(column, order[right], order[left], ascending):
          merged.push(order[right])
          right = right + 1
        else:
          merged.push(order[left])
          left = left + 1
      while left < middle:
        merged.push(order[left])
        left = left + 1
      while right < finish:
        merged.push(order[right])
        right = right + 1
      start = finish
    order = merged
    if width > row_count_value / 2:
      width = row_count_value
    else:
      width = width * 2
  return order

export fn sort_by(table: Table, name: String, ascending: Bool) -> Table:
  require_valid_table(table)
  index = find_column_index_unchecked(table, name)
  if index < 0:
    raise TableError.ColumnNotFound
  column = clone_column_unchecked(table.columns[index])
  if column.kind == kind_string():
    raise TableError.UnsupportedOrdering(kind: kind_string())
  order = stable_order(column, table.row_count, ascending)
  return select_rows_unchecked(table, order)

export fn sort_string_by_order(table: Table, name: String, categories: Vector[String], ascending: Bool) -> Table:
  require_valid_table(table)
  index = require_named_column(table, name, kind_string())
  var ranks = empty_string_int_map()
  var category = 0
  category_count = categories |> count
  while category < category_count:
    value = categories[category]
    if ranks.get(value, -1) >= 0:
      raise TableError.DuplicateCategory
    ranks[value] = category
    category = category + 1
  source = clone_column_unchecked(table.columns[index])
  var row_ranks = Vector[Int]()
  var row = 0
  while row < table.row_count:
    if source.validity[row]:
      rank = ranks.get(source.strings[row], -1)
      if rank < 0:
        raise TableError.CategoryNotFound
      row_ranks.push(rank)
    else:
      row_ranks.push(0)
    row = row + 1
  rank_column = Column(name: "rank", kind: kind_int(), nullable: source.nullable, validity: copy_bools(source.validity), ints: row_ranks, floats: Vector[Float](), bools: Vector[Bool](), strings: Vector[String]())
  order = stable_order(rank_column, table.row_count, ascending)
  return select_rows_unchecked(table, order)

export fn distinct_int(table: Table, name: String) -> Table:
  require_valid_table(table)
  index = require_named_column(table, name, kind_int())
  column = clone_column_unchecked(table.columns[index])
  var seen = empty_int_bool_map()
  var saw_missing = false
  var rows = Vector[Int]()
  var row = 0
  while row < table.row_count:
    if column.validity[row]:
      value = column.ints[row]
      if not seen.get(value, false):
        seen[value] = true
        rows.push(row)
    else:
      if not saw_missing:
        saw_missing = true
        rows.push(row)
    row = row + 1
  return select_rows_unchecked(table, rows)

