  while left_row < left.row_count:
    var matched = false
    if left_column.validity[left_row]:
      match_group = group_lookup.get(left_column.strings[left_row], -1)
      if match_group >= 0:
        var right_row = right_groups.first_rows[match_group]
        while right_row >= 0:
          append_join_pair(left_rows, right_rows, left_row, right_row, max_output_rows)
          matched = true
          right_row = right_groups.next_rows[right_row]
    if not matched:
      append_join_pair(left_rows, right_rows, left_row, -1, max_output_rows)
