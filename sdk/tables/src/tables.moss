    row = row + 1
  return select_rows_unchecked(table, rows)

export fn validate_group_index(groups: GroupIndex) -> Bool:
  if groups.source_row_count < 0:
    return false
  if groups.key_kind != kind_int() and groups.key_kind != kind_string():
    return false
  group_total = groups.sizes |> count
  if (groups.key_validity |> count) != group_total:
    return false
  if (groups.first_rows |> count) != group_total or (groups.last_rows |> count) != group_total:
    return false
  if (groups.next_rows |> count) != groups.source_row_count:
    return false
  if groups.key_kind == kind_int():
    if (groups.int_keys |> count) != group_total or (groups.string_keys |> count) != 0:
      return false
  else:
    if (groups.string_keys |> count) != group_total or (groups.int_keys |> count) != 0:
      return false
  var seen = Vector[Bool]()
  var row = 0
  while row < groups.source_row_count:
    if groups.next_rows[row] < -1 or groups.next_rows[row] >= groups.source_row_count:
      return false
    seen.push(false)
    row = row + 1
  var group = 0
  var visited_total = 0
  var missing_groups = 0
  while group < group_total:
    if groups.sizes[group] <= 0:
      return false
    if groups.first_rows[group] < 0 or groups.first_rows[group] >= groups.source_row_count:
      return false
    if groups.last_rows[group] < 0 or groups.last_rows[group] >= groups.source_row_count:
      return false
    if not groups.key_validity[group]:
      missing_groups = missing_groups + 1
      if missing_groups > 1:
        return false
      if groups.key_kind == kind_int() and groups.int_keys[group] != 0:
        return false
      if groups.key_kind == kind_string() and groups.string_keys[group] != "":
        return false
    else:
      var earlier = 0
      while earlier < group:
        if groups.key_validity[earlier]:
          if groups.key_kind == kind_int() and groups.int_keys[earlier] == groups.int_keys[group]:
            return false
          if groups.key_kind == kind_string() and groups.string_keys[earlier] == groups.string_keys[group]:
            return false
        earlier = earlier + 1
    var current = groups.first_rows[group]
    var in_group = 0
    var observed_last = 0 - 1
    while current >= 0:
      if current >= groups.source_row_count or seen[current]:
        return false
      seen[current] = true
      observed_last = current
      in_group = in_group + 1
      visited_total = visited_total + 1
      if in_group > groups.sizes[group]:
        return false
      current = groups.next_rows[current]
    if in_group != groups.sizes[group] or observed_last != groups.last_rows[group]:
      return false
    group = group + 1
  if visited_total != groups.source_row_count:
    return false
  return true

fn require_valid_group_index(groups: GroupIndex):
  if not validate_group_index(groups):
    raise TableError.InvalidGroupIndex

fn append_group_row(first_rows: Vector[Int], last_rows: Vector[Int], sizes: Vector[Int], next_rows: Vector[Int], group: Int, row: Int):
  if sizes[group] == 0:
    first_rows[group] = row
  else:
    previous = last_rows[group]
    next_rows[previous] = row
  last_rows[group] = row
  sizes[group] = sizes[group] + 1

export fn group_by_int(table: Table, name: String) -> GroupIndex:
  require_valid_table(table)
  index = require_named_column(table, name, kind_int())
  column = clone_column_unchecked(table.columns[index])
  var key_validity = Vector[Bool]()
  var int_keys = Vector[Int]()
  var first_rows = Vector[Int]()
  var last_rows = Vector[Int]()
  var sizes = Vector[Int]()
  var next_rows = Vector[Int]()
  var row = 0
  while row < table.row_count:
    next_rows.push(0 - 1)
    row = row + 1
  var groups_by_key = empty_int_int_map()
  var missing_group = 0 - 1
  row = 0
  while row < table.row_count:
    var group = 0 - 1
    if column.validity[row]:
      value = column.ints[row]
      group = groups_by_key.get(value, -1)
      if group < 0:
        group = sizes |> count
        if group == 9223372036854775807:
          raise TableError.IntegerOverflow
        groups_by_key[value] = group
        key_validity.push(true)
        int_keys.push(value)
        first_rows.push(0 - 1)
        last_rows.push(0 - 1)
        sizes.push(0)
    else:
      group = missing_group
      if group < 0:
        group = sizes |> count
        if group == 9223372036854775807:
          raise TableError.IntegerOverflow
        missing_group = group
        key_validity.push(false)
        int_keys.push(0)
        first_rows.push(0 - 1)
        last_rows.push(0 - 1)
        sizes.push(0)
    append_group_row(first_rows, last_rows, sizes, next_rows, group, row)
    row = row + 1
  return GroupIndex(key_kind: kind_int(), key_validity: key_validity, int_keys: int_keys, string_keys: Vector[String](), first_rows: first_rows, last_rows: last_rows, sizes: sizes, next_rows: next_rows, source_row_count: table.row_count)

export fn group_by_string(table: Table, name: String) -> GroupIndex:
  require_valid_table(table)
  index = require_named_column(table, name, kind_string())
  column = clone_column_unchecked(table.columns[index])
  var key_validity = Vector[Bool]()
  var string_keys = Vector[String]()
  var first_rows = Vector[Int]()
  var last_rows = Vector[Int]()
  var sizes = Vector[Int]()
  var next_rows = Vector[Int]()
  var row = 0
  while row < table.row_count:
    next_rows.push(0 - 1)
    row = row + 1
  var groups_by_key = empty_string_int_map()
  var missing_group = 0 - 1
  row = 0
  while row < table.row_count:
    var group = 0 - 1
    if column.validity[row]:
      value = column.strings[row]
      group = groups_by_key.get(value, -1)
      if group < 0:
        group = sizes |> count
        if group == 9223372036854775807:
          raise TableError.IntegerOverflow
        groups_by_key[value] = group
        key_validity.push(true)
        string_keys.push(value + "")
        first_rows.push(0 - 1)
        last_rows.push(0 - 1)
        sizes.push(0)
    else:
      group = missing_group
      if group < 0:
        group = sizes |> count
        if group == 9223372036854775807:
          raise TableError.IntegerOverflow
        missing_group = group
        key_validity.push(false)
        string_keys.push("")
        first_rows.push(0 - 1)
        last_rows.push(0 - 1)
        sizes.push(0)
    append_group_row(first_rows, last_rows, sizes, next_rows, group, row)
    row = row + 1
  return GroupIndex(key_kind: kind_string(), key_validity: key_validity, int_keys: Vector[Int](), string_keys: string_keys, first_rows: first_rows, last_rows: last_rows, sizes: sizes, next_rows: next_rows, source_row_count: table.row_count)

export fn group_count(groups: GroupIndex) -> Int:
  require_valid_group_index(groups)
  return groups.sizes |> count

export fn group_count_rows(groups: GroupIndex) -> Vector[Int]:
  require_valid_group_index(groups)
  return copy_ints(groups.sizes)

export fn group_int_keys(groups: GroupIndex) -> IntColumnValues:
  require_valid_group_index(groups)
  if groups.key_kind != kind_int():
    raise TableError.WrongColumnType(expected_kind: kind_int(), actual_kind: groups.key_kind)
  return IntColumnValues(values: copy_ints(groups.int_keys), validity: copy_bools(groups.key_validity))

export fn group_string_keys(groups: GroupIndex) -> StringColumnValues:
  require_valid_group_index(groups)
  if groups.key_kind != kind_string():
    raise TableError.WrongColumnType(expected_kind: kind_string(), actual_kind: groups.key_kind)
  return StringColumnValues(values: copy_strings(groups.string_keys), validity: copy_bools(groups.key_validity))

fn require_group_table(groups: GroupIndex, table: Table):
  require_valid_group_index(groups)
  require_valid_table(table)
  if groups.source_row_count != table.row_count:
    raise TableError.GroupRowCountMismatch(expected: groups.source_row_count, actual: table.row_count)

export fn group_count_present(table: Table, groups: GroupIndex, name: String) -> Vector[Int]:
  require_group_table(groups, table)
  index = find_column_index_unchecked(table, name)
  if index < 0:
    raise TableError.ColumnNotFound
  column = clone_column_unchecked(table.columns[index])
  var counts = Vector[Int]()
  var group = 0
  group_total = groups.sizes |> count
  while group < group_total:
    var present = 0
    var row = groups.first_rows[group]
    while row >= 0:
      if column.validity[row]:
        present = present + 1
      row = groups.next_rows[row]
    counts.push(present)
    group = group + 1
  return counts

fn checked_add_int(left: Int, right: Int) -> Int:
  if right > 0 and left > 0:
    remaining = 9223372036854775807 - left
    if right > remaining:
      raise TableError.IntegerOverflow
  if right < 0 and left < 0:
    remaining = (-9223372036854775807 - 1) - left
    if right < remaining:
      raise TableError.IntegerOverflow
  return left + right

export fn group_sum_int(table: Table, groups: GroupIndex, name: String) -> IntColumnValues:
  require_group_table(groups, table)
  index = require_named_column(table, name, kind_int())
  column = clone_column_unchecked(table.columns[index])
  var values = Vector[Int]()
  var validity = Vector[Bool]()
  var group = 0
  group_total = groups.sizes |> count
  while group < group_total:
    var total = 0
    var present = false
    var row = groups.first_rows[group]
    while row >= 0:
      if column.validity[row]:
        total = checked_add_int(total, column.ints[row])
        present = true
      row = groups.next_rows[row]
    values.push(total)
    validity.push(present)
    group = group + 1
  return IntColumnValues(values: values, validity: validity)

export fn group_sum_float(table: Table, groups: GroupIndex, name: String) -> FloatColumnValues:
  require_group_table(groups, table)
  index = require_named_column(table, name, kind_float())
  column = clone_column_unchecked(table.columns[index])
  var values = Vector[Float]()
  var validity = Vector[Bool]()
  var group = 0
  group_total = groups.sizes |> count
  while group < group_total:
    var total = 0.0
    var present = false
    var row = groups.first_rows[group]
    while row >= 0:
      if column.validity[row]:
        total = total + column.floats[row]
        present = true
      row = groups.next_rows[row]
    values.push(total)
    validity.push(present)
    group = group + 1
  return FloatColumnValues(values: values, validity: validity)

export fn group_mean_int(table: Table, groups: GroupIndex, name: String) -> FloatColumnValues:
  require_group_table(groups, table)
  index = require_named_column(table, name, kind_int())
  column = clone_column_unchecked(table.columns[index])
  var values = Vector[Float]()
  var validity = Vector[Bool]()
  var group = 0
  group_total = groups.sizes |> count
  while group < group_total:
    var total = 0.0
    var present_count = 0
    var row = groups.first_rows[group]
    while row >= 0:
      if column.validity[row]:
        total = total + column.ints[row] * 1.0
        present_count = present_count + 1
      row = groups.next_rows[row]
    if present_count > 0:
      values.push(total / (present_count * 1.0))
      validity.push(true)
    else:
      values.push(0.0)
      validity.push(false)
    group = group + 1
  return FloatColumnValues(values: values, validity: validity)

