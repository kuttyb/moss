module tables_test

import tables

test "all four column types and owned accessors":
  var source_ints = [10, 20, 30]
  var source_strings = ["alpha", "hidden", "gamma"]
  ints = tables.int_column("id", false, source_ints, [true, true, true])
  floats = tables.float_column("score", true, [1.5, 99.0, 3.5], [true, false, true])
  bools = tables.bool_column("active", true, [true, true, false], [true, false, true])
  strings = tables.string_column("name", true, source_strings, [true, false, true])

  assert(tables.validate_column(ints))
  assert(tables.validate_column(floats))
  assert(tables.validate_column(bools))
  assert(tables.validate_column(strings))
  assertEqual(floats.floats[1], 0.0)
  assert(not bools.bools[1])
  assertEqual(strings.strings[1], "")

  table0 = tables.new_table(3)
  table1 = tables.add_column(table0, ints)
  table2 = tables.add_column(table1, floats)
  table3 = tables.add_column(table2, bools)
  table4 = tables.add_column(table3, strings)
  assert(tables.validate_table(table4))
  assertEqual(tables.table_row_count(table4), 3)
  assertEqual(tables.column_count(table4), 4)
  assertEqual(tables.column_index(table4, "score"), 1)
  assertEqual(tables.column_name(table4, 2), "active")
  assertEqual(tables.column_kind(table4, 3), tables.kind_string())
  assert(tables.column_nullable(table4, 1))

  source_ints[0] = 999
  source_strings[0] = "changed"
  int_result = tables.int_values(table4, "id")
  float_result = tables.float_values(table4, "score")
  bool_result = tables.bool_values(table4, "active")
  string_result = tables.string_values(table4, "name")
  assertEqual(int_result.values[0], 10)
  assertEqual(float_result.values[2], 3.5)
  assert(not float_result.validity[1])
  assert(bool_result.values[0])
  assertEqual(string_result.values[0], "alpha")

  int_result.values[0] = 777
  int_again = tables.int_values(table4, "id")
  assertEqual(int_again.values[0], 10)

test "zero rows and zero columns retain explicit row count":
  empty = tables.new_table(0)
  assert(tables.validate_table(empty))
  assertEqual(tables.table_row_count(empty), 0)
  assertEqual(tables.column_count(empty), 0)

  rows_only = tables.new_table(4)
  selected_none = tables.select_columns(rows_only, Vector[String]())
  assertEqual(tables.table_row_count(selected_none), 4)
  assertEqual(tables.column_count(selected_none), 0)
  filtered = tables.filter_mask(rows_only, [true, false, true, false])
  assertEqual(tables.table_row_count(filtered), 2)
  assertEqual(tables.column_count(filtered), 0)
  dropped = tables.drop_missing_rows(rows_only)
  assertEqual(tables.table_row_count(dropped), 4)

  empty_column = tables.int_column("empty", true, Vector[Int](), Vector[Bool]())
  with_empty = tables.add_column(empty, empty_column)
  assert(tables.validate_table(with_empty))
  assertEqual(tables.int_values(with_empty, "empty").values |> count, 0)

test "column add replace remove and projection":
  base = tables.new_table(2)
  ids = tables.int_column("id", false, [1, 2], [true, true])
  names = tables.string_column("name", false, ["one", "two"], [true, true])
  table1 = tables.add_column(base, ids)
  table2 = tables.add_column(table1, names)

  replacement = tables.int_column("id", false, [11, 22], [true, true])
  replaced = tables.replace_column(table2, replacement)
  assertEqual(tables.int_values(replaced, "id").values[1], 22)
  assertEqual(tables.int_values(table2, "id").values[1], 2)

  projected = tables.select_columns(replaced, ["name", "id"])
  assertEqual(tables.column_name(projected, 0), "name")
  assertEqual(tables.column_name(projected, 1), "id")

  removed = tables.remove_column(projected, "name")
  assertEqual(tables.column_count(removed), 1)
  assertEqual(tables.table_row_count(removed), 2)
  no_columns = tables.remove_column(removed, "id")
  assertEqual(tables.column_count(no_columns), 0)
  assertEqual(tables.table_row_count(no_columns), 2)

test "row selection filtering and missing operations":
  table0 = tables.new_table(4)
  table1 = tables.add_column(table0, tables.int_column("id", false, [10, 20, 30, 40], [true, true, true, true]))
  table2 = tables.add_column(table1, tables.float_column("score", true, [1.0, 9.0, 3.0, 9.0], [true, false, true, false]))
  table3 = tables.add_column(table2, tables.bool_column("flag", true, [true, true, false, true], [true, false, true, true]))
  table4 = tables.add_column(table3, tables.string_column("label", true, ["a", "x", "c", "d"], [true, false, true, true]))

  assert(not tables.is_missing(table4, "score", 0))
  assert(tables.is_missing(table4, "score", 1))
  selected = tables.select_rows(table4, [3, 1, 1])
  assertEqual(tables.table_row_count(selected), 3)
  selected_ids = tables.int_values(selected, "id")
  assertEqual(selected_ids.values[0], 40)
  assertEqual(selected_ids.values[1], 20)
  assertEqual(selected_ids.values[2], 20)

  filtered = tables.filter_mask(table4, [false, true, true, false])
  assertEqual(tables.table_row_count(filtered), 2)
  assertEqual(tables.int_values(filtered, "id").values[1], 30)

  complete = tables.drop_missing_rows(table4)
  assertEqual(tables.table_row_count(complete), 2)
  assertEqual(tables.int_values(complete, "id").values[0], 10)
  assertEqual(tables.int_values(complete, "id").values[1], 30)

  filled_int_source = tables.add_column(tables.new_table(2), tables.int_column("v", true, [5, 99], [true, false]))
  filled_int = tables.fill_missing_int(filled_int_source, "v", 7)
  assertEqual(tables.int_values(filled_int, "v").values[1], 7)
  assert(tables.int_values(filled_int, "v").validity[1])
  assert(tables.is_missing(filled_int_source, "v", 1))

  filled_float = tables.fill_missing_float(table4, "score", 2.5)
  assertEqual(tables.float_values(filled_float, "score").values[1], 2.5)
  filled_bool = tables.fill_missing_bool(table4, "flag", false)
  assert(not tables.bool_values(filled_bool, "flag").values[1])
  assert(tables.bool_values(filled_bool, "flag").validity[1])
  filled_string = tables.fill_missing_string(table4, "label", "unknown")
  assertEqual(tables.string_values(filled_string, "label").values[1], "unknown")

test "clone produces independent owned storage":
  base = tables.add_column(tables.new_table(2), tables.int_column("id", false, [4, 5], [true, true]))
  var copied = tables.clone(base)
  copied.columns[0].ints[0] = 99
  assertEqual(tables.int_values(copied, "id").values[0], 99)
  assertEqual(tables.int_values(base, "id").values[0], 4)

test "constructor and schema errors are typed":
  var caught_negative_rows = false
  try:
    ignored = tables.new_table(0 - 1)
  recover tables.TableError.InvalidRowCount(row_count):
    assertEqual(row_count, -1)
    caught_negative_rows = true
  assert(caught_negative_rows)

  var caught_empty_name = false
  try:
    ignored = tables.int_column("", false, [1], [true])
  recover tables.TableError.EmptyColumnName:
    caught_empty_name = true
  assert(caught_empty_name)

  var caught_length = false
  try:
    ignored = tables.bool_column("b", true, [true], [true, false])
  recover tables.TableError.ColumnLengthMismatch(values_length, validity_length):
    assertEqual(values_length, 1)
    assertEqual(validity_length, 2)
    caught_length = true
  assert(caught_length)

  var caught_nonnullable = false
  try:
    ignored = tables.string_column("s", false, ["x"], [false])
  recover tables.TableError.NonNullableMissing(index):
    assertEqual(index, 0)
    caught_nonnullable = true
  assert(caught_nonnullable)

  base = tables.add_column(tables.new_table(2), tables.int_column("id", false, [1, 2], [true, true]))
  var caught_duplicate = false
  try:
    ignored = tables.add_column(base, tables.int_column("id", false, [3, 4], [true, true]))
  recover tables.TableError.DuplicateColumnName:
    caught_duplicate = true
  assert(caught_duplicate)

  var caught_row_mismatch = false
  try:
    ignored = tables.add_column(base, tables.float_column("f", false, [1.0], [true]))
  recover tables.TableError.TableRowCountMismatch(expected, actual):
    assertEqual(expected, 2)
    assertEqual(actual, 1)
    caught_row_mismatch = true
  assert(caught_row_mismatch)

test "lookup type and row selection errors are typed":
  table = tables.add_column(tables.new_table(2), tables.int_column("id", false, [1, 2], [true, true]))
  var caught_missing = false
  try:
    ignored = tables.column_index(table, "absent")
  recover tables.TableError.ColumnNotFound:
    caught_missing = true
  assert(caught_missing)

  var caught_type = false
  try:
    ignored = tables.string_values(table, "id")
  recover tables.TableError.WrongColumnType(expected_kind, actual_kind):
    assertEqual(expected_kind, tables.kind_string())
    assertEqual(actual_kind, tables.kind_int())
    caught_type = true
  assert(caught_type)

  var caught_column_index = false
  try:
    ignored = tables.column_name(table, 1)
  recover tables.TableError.ColumnIndexOutOfBounds(index, count):
    assertEqual(index, 1)
    assertEqual(count, 1)
    caught_column_index = true
  assert(caught_column_index)

  var caught_row_index = false
  try:
    ignored = tables.select_rows(table, [0, 2])
  recover tables.TableError.RowIndexOutOfBounds(index, row_count):
    assertEqual(index, 2)
    assertEqual(row_count, 2)
    caught_row_index = true
  assert(caught_row_index)

  var caught_mask = false
  try:
    ignored = tables.filter_mask(table, [true])
  recover tables.TableError.MaskLengthMismatch(expected, actual):
    assertEqual(expected, 2)
    assertEqual(actual, 1)
    caught_mask = true
  assert(caught_mask)

test "forged records are rejected before indexing":
  bad_kind = tables.Column(name: "bad", kind: 9, nullable: false, validity: [true], ints: [1], floats: Vector[Float](), bools: Vector[Bool](), strings: Vector[String]())
  assert(not tables.validate_column(bad_kind))
  var caught_kind = false
  try:
    ignored = tables.add_column(tables.new_table(1), bad_kind)
  recover tables.TableError.InvalidColumnKind(kind):
    assertEqual(kind, 9)
    caught_kind = true
  assert(caught_kind)

  bad_storage = tables.Column(name: "bad", kind: tables.kind_int(), nullable: false, validity: [true], ints: [1], floats: [2.0], bools: Vector[Bool](), strings: Vector[String]())
  assert(not tables.validate_column(bad_storage))
  var caught_storage = false
  try:
    ignored = tables.add_column(tables.new_table(1), bad_storage)
  recover tables.TableError.UnexpectedStorage(kind):
    assertEqual(kind, tables.kind_int())
    caught_storage = true
  assert(caught_storage)

  bad_filler = tables.Column(name: "bad", kind: tables.kind_int(), nullable: true, validity: [false], ints: [8], floats: Vector[Float](), bools: Vector[Bool](), strings: Vector[String]())
  assert(not tables.validate_column(bad_filler))
  var bad_columns = [bad_filler]
  bad_table = tables.Table(columns: bad_columns, row_count: 1)
  assert(not tables.validate_table(bad_table))
  var caught_filler = false
  try:
    ignored = tables.table_row_count(bad_table)
  recover tables.TableError.NonCanonicalMissing(index):
    assertEqual(index, 0)
    caught_filler = true
  assert(caught_filler)

  short_column = tables.int_column("short", false, [1], [true])
  var short_columns = [short_column]
  short_table = tables.Table(columns: short_columns, row_count: 2)
  assert(not tables.validate_table(short_table))
  var caught_short = false
  try:
    ignored = tables.column_count(short_table)
  recover tables.TableError.TableRowCountMismatch(expected, actual):
    assertEqual(expected, 2)
    assertEqual(actual, 1)
    caught_short = true
  assert(caught_short)

  first = tables.int_column("dup", false, [1], [true])
  second = tables.string_column("dup", false, ["x"], [true])
  var duplicate_columns = [first, second]
  duplicate_table = tables.Table(columns: duplicate_columns, row_count: 1)
  assert(not tables.validate_table(duplicate_table))
  var caught_forged_duplicate = false
  try:
    ignored = tables.table_row_count(duplicate_table)
  recover tables.TableError.DuplicateColumnName:
    caught_forged_duplicate = true
  assert(caught_forged_duplicate)

test "duplicate projections and wrong fill type fail":
  table = tables.add_column(tables.new_table(1), tables.int_column("id", false, [1], [true]))
  var caught_projection_duplicate = false
  try:
    ignored = tables.select_columns(table, ["id", "id"])
  recover tables.TableError.DuplicateColumnName:
    caught_projection_duplicate = true
  assert(caught_projection_duplicate)

  var caught_fill_type = false
  try:
    ignored = tables.fill_missing_float(table, "id", 1.0)
  recover tables.TableError.WrongColumnType(expected_kind, actual_kind):
    assertEqual(expected_kind, tables.kind_float())
    assertEqual(actual_kind, tables.kind_int())
    caught_fill_type = true
  assert(caught_fill_type)

test "typed filters preserve row order and missing semantics":
  table0 = tables.new_table(6)
  table1 = tables.add_column(table0, tables.int_column("i", true, [(-9223372036854775807 - 1), 0, 5, 5, 9223372036854775807, 0], [true, false, true, true, true, true]))
  table2 = tables.add_column(table1, tables.float_column("f", true, [-0.0, 9.0, 2.5, 2.5, 8.0, 0.0], [true, false, true, true, true, true]))
  table3 = tables.add_column(table2, tables.bool_column("b", true, [true, false, false, true, true, false], [true, false, true, true, true, true]))
  table = tables.add_column(table3, tables.string_column("s", true, ["a", "", "b", "a", "c", "a"], [true, false, true, true, true, true]))

  assertEqual(tables.table_row_count(tables.filter_int_equal(table, "i", 5)), 2)
  assertEqual(tables.int_values(tables.filter_int_range(table, "i", -1, 5), "i").values, [5, 5, 0])
  assertEqual(tables.table_row_count(tables.filter_float_equal(table, "f", 0.0)), 2)
  assertEqual(tables.table_row_count(tables.filter_float_range(table, "f", -0.0, 2.5)), 4)
  assertEqual(tables.int_values(tables.filter_bool_equal(table, "b", false), "i").values, [5, 0])
  assertEqual(tables.int_values(tables.filter_string_equal(table, "s", "a"), "i").values, [(-9223372036854775807 - 1), 5, 0])
  assertEqual(tables.table_row_count(tables.filter_missing(table, "s")), 1)
  assertEqual(tables.table_row_count(tables.filter_present(table, "s")), 5)

test "stable sorting handles numbers bool NaN signed zero and missing":
  nan = 0.0 / 0.0
  table0 = tables.new_table(7)
  table1 = tables.add_column(table0, tables.int_column("row", false, [0, 1, 2, 3, 4, 5, 6], [true, true, true, true, true, true, true]))
  table2 = tables.add_column(table1, tables.float_column("value", true, [nan, -0.0, 0.0, 2.0, 99.0, -1.0, nan], [true, true, true, true, false, true, true]))
  table = tables.add_column(table2, tables.bool_column("flag", true, [true, false, false, true, true, false, true], [true, true, true, true, false, true, true]))

  ascending = tables.sort_by(table, "value", true)
  assertEqual(tables.int_values(ascending, "row").values, [5, 1, 2, 3, 0, 6, 4])
  descending = tables.sort_by(table, "value", false)
  assertEqual(tables.int_values(descending, "row").values, [3, 1, 2, 5, 0, 6, 4])
  bool_sorted = tables.sort_by(table, "flag", true)
  assertEqual(tables.int_values(bool_sorted, "row").values, [1, 2, 5, 0, 3, 6, 4])

  int_table0 = tables.new_table(5)
  int_table1 = tables.add_column(int_table0, tables.int_column("row", false, [0, 1, 2, 3, 4], [true, true, true, true, true]))
  int_table = tables.add_column(int_table1, tables.int_column("value", true, [9223372036854775807, (-9223372036854775807 - 1), 0, (-9223372036854775807 - 1), 0], [true, true, true, true, false]))
  assertEqual(tables.int_values(tables.sort_by(int_table, "value", true), "row").values, [1, 3, 2, 0, 4])

  strings = tables.add_column(tables.new_table(4), tables.string_column("grade", true, ["medium", "low", "high", ""], [true, true, true, false]))
  var unsupported = false
  try:
    ignored = tables.sort_by(strings, "grade", true)
  recover tables.TableError.UnsupportedOrdering(kind):
    assertEqual(kind, tables.kind_string())
    unsupported = true
  assert(unsupported)
  categorical = tables.sort_string_by_order(strings, "grade", ["low", "medium", "high"], false)
  assertEqual(tables.string_values(categorical, "grade").values, ["high", "medium", "low", ""])
  assert(not tables.string_values(categorical, "grade").validity[3])
  var duplicate_category = false
  try:
    ignored_duplicate = tables.sort_string_by_order(strings, "grade", ["low", "low", "medium", "high"], true)
  recover tables.TableError.DuplicateCategory:
    duplicate_category = true
  assert(duplicate_category)
  var missing_category = false
  try:
    ignored_missing = tables.sort_string_by_order(strings, "grade", ["low", "medium"], true)
  recover tables.TableError.CategoryNotFound:
    missing_category = true
  assert(missing_category)

test "distinct Int and String preserve first occurrence including missing":
  ints0 = tables.new_table(7)
  ints1 = tables.add_column(ints0, tables.int_column("key", true, [2, 0, 2, 1, 0, 1, 3], [true, false, true, true, false, true, true]))
  ints = tables.add_column(ints1, tables.int_column("row", false, [0, 1, 2, 3, 4, 5, 6], [true, true, true, true, true, true, true]))
  distinct_ints = tables.distinct_int(ints, "key")
  assertEqual(tables.int_values(distinct_ints, "row").values, [0, 1, 3, 6])

  strings0 = tables.new_table(6)
  strings1 = tables.add_column(strings0, tables.string_column("key", true, ["b", "", "b", "a", "", "c"], [true, false, true, true, false, true]))
  strings = tables.add_column(strings1, tables.int_column("row", false, [0, 1, 2, 3, 4, 5], [true, true, true, true, true, true]))
  distinct_strings = tables.distinct_string(strings, "key")
  assertEqual(tables.int_values(distinct_strings, "row").values, [0, 1, 3, 5])

test "grouping is first seen linked and aggregates ignore missing":
  table0 = tables.new_table(6)
  table1 = tables.add_column(table0, tables.int_column("key", true, [2, 0, 2, 1, 0, 1], [true, false, true, true, false, true]))
  table2 = tables.add_column(table1, tables.int_column("ival", true, [10, 0, -3, 0, 0, 7], [true, false, true, false, false, true]))
  table = tables.add_column(table2, tables.float_column("fval", true, [1.5, 0.0, 2.5, 0.0, 0.0, -4.0], [true, false, true, false, false, true]))
  groups = tables.group_by_int(table, "key")
  assert(tables.validate_group_index(groups))
  assertEqual(tables.group_count(groups), 3)
  assertEqual(tables.group_int_keys(groups).values, [2, 0, 1])
  assertEqual(tables.group_int_keys(groups).validity, [true, false, true])
  assertEqual(tables.group_count_rows(groups), [2, 2, 2])
  assertEqual(tables.group_count_present(table, groups, "ival"), [2, 0, 1])
  isum = tables.group_sum_int(table, groups, "ival")
  assertEqual(isum.values, [7, 0, 7])
  assertEqual(isum.validity, [true, false, true])
  imean = tables.group_mean_int(table, groups, "ival")
  assertEqual(imean.values, [3.5, 0.0, 7.0])
  assertEqual(imean.validity, [true, false, true])
  assertEqual(tables.group_min_int(table, groups, "ival").values, [-3, 0, 7])
  assertEqual(tables.group_max_int(table, groups, "ival").values, [10, 0, 7])
  assertEqual(tables.group_sum_float(table, groups, "fval").values, [4.0, 0.0, -4.0])
  assertEqual(tables.group_mean_float(table, groups, "fval").validity, [true, false, true])
  assertEqual(tables.group_min_float(table, groups, "fval").values, [1.5, 0.0, -4.0])
  assertEqual(tables.group_max_float(table, groups, "fval").values, [2.5, 0.0, -4.0])

  string_table = tables.add_column(tables.new_table(5), tables.string_column("key", true, ["x", "y", "x", "", "y"], [true, true, true, false, true]))
  string_groups = tables.group_by_string(string_table, "key")
  assertEqual(tables.group_string_keys(string_groups).values, ["x", "y", ""])
  assertEqual(tables.group_count_rows(string_groups), [2, 2, 1])

test "group integer sum overflow and malformed index are typed":
  overflow0 = tables.new_table(2)
  overflow1 = tables.add_column(overflow0, tables.int_column("key", false, [1, 1], [true, true]))
  overflow = tables.add_column(overflow1, tables.int_column("value", false, [9223372036854775807, 1], [true, true]))
  groups = tables.group_by_int(overflow, "key")
  var caught_overflow = false
  try:
    ignored = tables.group_sum_int(overflow, groups, "value")
  recover tables.TableError.IntegerOverflow:
    caught_overflow = true
  assert(caught_overflow)

  bad = tables.GroupIndex(key_kind: tables.kind_int(), key_validity: [true], int_keys: [1], string_keys: Vector[String](), first_rows: [0], last_rows: [0], sizes: [2], next_rows: [-1], source_row_count: 1)
  assert(not tables.validate_group_index(bad))
  var caught_bad = false
  try:
    ignored_bad = tables.group_count(bad)
  recover tables.TableError.InvalidGroupIndex:
    caught_bad = true
  assert(caught_bad)

test "Int joins are stable many to many and null keys never match":
  left0 = tables.new_table(5)
  left1 = tables.add_column(left0, tables.int_column("key", true, [1, 2, 1, 0, 3], [true, true, true, false, true]))
  left = tables.add_column(left1, tables.int_column("tag", false, [10, 20, 11, 40, 30], [true, true, true, true, true]))
  right0 = tables.new_table(5)
  right1 = tables.add_column(right0, tables.int_column("rkey", true, [1, 1, 2, 0, 4], [true, true, true, false, true]))
  right2 = tables.add_column(right1, tables.int_column("value", false, [100, 101, 200, 999, 400], [true, true, true, true, true]))
  right = tables.add_column(right2, tables.int_column("tag", false, [7, 8, 9, 10, 11], [true, true, true, true, true]))

  inner = tables.inner_join_int(left, right, "key", "rkey", "_right", 20)
  assertEqual(tables.table_row_count(inner), 5)
  assertEqual(tables.int_values(inner, "tag").values, [10, 10, 20, 11, 11])
  assertEqual(tables.int_values(inner, "value").values, [100, 101, 200, 100, 101])
  assertEqual(tables.int_values(inner, "tag_right").values, [7, 8, 9, 7, 8])

  outer = tables.left_join_int(left, right, "key", "rkey", "_right", 20)
  assertEqual(tables.table_row_count(outer), 7)
  assertEqual(tables.int_values(outer, "tag").values, [10, 10, 20, 11, 11, 40, 30])
  right_values = tables.int_values(outer, "value")
  assertEqual(right_values.values, [100, 101, 200, 100, 101, 0, 0])
  assertEqual(right_values.validity, [true, true, true, true, true, false, false])

test "String joins empty sides limits and suffix collisions are checked":
  left0 = tables.new_table(3)
  left1 = tables.add_column(left0, tables.string_column("key", true, ["a", "", "b"], [true, false, true]))
  left = tables.add_column(left1, tables.int_column("left_value", false, [1, 2, 3], [true, true, true]))
  right0 = tables.new_table(3)
  right1 = tables.add_column(right0, tables.string_column("key2", true, ["a", "a", ""], [true, true, false]))
  right = tables.add_column(right1, tables.int_column("right_value", false, [10, 11, 99], [true, true, true]))
  inner = tables.inner_join_string(left, right, "key", "key2", "_r", 10)
  assertEqual(tables.int_values(inner, "left_value").values, [1, 1])
  assertEqual(tables.int_values(inner, "right_value").values, [10, 11])
  outer = tables.left_join_string(left, right, "key", "key2", "_r", 10)
  assertEqual(tables.int_values(outer, "left_value").values, [1, 1, 2, 3])
  assertEqual(tables.int_values(outer, "right_value").validity, [true, true, false, false])

  empty_right0 = tables.new_table(0)
  empty_right1 = tables.add_column(empty_right0, tables.string_column("key2", false, Vector[String](), Vector[Bool]()))
  empty_right = tables.add_column(empty_right1, tables.int_column("right_value", false, Vector[Int](), Vector[Bool]()))
  empty_inner = tables.inner_join_string(left, empty_right, "key", "key2", "_r", 10)
  assertEqual(tables.table_row_count(empty_inner), 0)
  empty_left_join = tables.left_join_string(left, empty_right, "key", "key2", "_r", 10)
  assertEqual(tables.table_row_count(empty_left_join), 3)
  assertEqual(tables.int_values(empty_left_join, "right_value").validity, [false, false, false])

  empty_left0 = tables.new_table(0)
  empty_left1 = tables.add_column(empty_left0, tables.string_column("key", false, Vector[String](), Vector[Bool]()))
  empty_left = tables.add_column(empty_left1, tables.int_column("left_value", false, Vector[Int](), Vector[Bool]()))
  assertEqual(tables.table_row_count(tables.left_join_string(empty_left, right, "key", "key2", "_r", 10)), 0)

  var caught_limit = false
  try:
    ignored_limit = tables.inner_join_string(left, right, "key", "key2", "_r", 1)
  recover tables.TableError.OutputLimitExceeded(limit):
    assertEqual(limit, 1)
    caught_limit = true
  assert(caught_limit)
  var caught_negative_limit = false
  try:
    ignored_negative_limit = tables.inner_join_string(left, right, "key", "key2", "_r", -1)
  recover tables.TableError.InvalidOutputLimit(limit):
    assertEqual(limit, -1)
    caught_negative_limit = true
  assert(caught_negative_limit)

  collision_left0 = tables.new_table(1)
  collision_left1 = tables.add_column(collision_left0, tables.int_column("key", false, [1], [true]))
  collision_left2 = tables.add_column(collision_left1, tables.int_column("value", false, [1], [true]))
  collision_left = tables.add_column(collision_left2, tables.int_column("value_r", false, [2], [true]))
  collision_right0 = tables.new_table(1)
  collision_right1 = tables.add_column(collision_right0, tables.int_column("rkey", false, [1], [true]))
  collision_right = tables.add_column(collision_right1, tables.int_column("value", false, [3], [true]))
  var caught_collision = false
  try:
    ignored_collision = tables.inner_join_int(collision_left, collision_right, "key", "rkey", "_r", 10)
  recover tables.TableError.DuplicateColumnName:
    caught_collision = true
  assert(caught_collision)

test "csv schema validation is closed and typed":
  schema = tables.csv_schema([tables.csv_field("id", tables.kind_int(), false), tables.csv_field("name", tables.kind_string(), true)], true, ",", "NA")
  assert(tables.validate_csv_schema(schema))

  var duplicate_caught = false
  try:
    ignored = tables.csv_schema([tables.csv_field("id", tables.kind_int(), false), tables.csv_field("id", tables.kind_int(), false)], true, ",", "NA")
  recover tables.CsvAdapterError.DuplicateFieldName(index):
    assertEqual(index, 1)
    duplicate_caught = true
  assert(duplicate_caught)

  var empty_fields = [tables.csv_field("id", tables.kind_int(), false)]
  ignored_field = empty_fields.pop()
  var empty_caught = false
  try:
    ignored = tables.csv_schema(empty_fields, false, ",", "")
  recover tables.CsvAdapterError.EmptySchema:
    empty_caught = true
  assert(empty_caught)

  var delimiter_caught = false
  try:
    ignored = tables.csv_schema([tables.csv_field("id", tables.kind_int(), false)], false, "||", "NA")
  recover tables.CsvAdapterError.InvalidDelimiter:
    delimiter_caught = true
  assert(delimiter_caught)

  forged = tables.CsvSchema(fields: [tables.CsvField(name: "x", kind: 99, nullable: false)], has_header: false, delimiter: ",", missing_token: "NA")
  assert(not tables.validate_csv_schema(forged))
  var kind_caught = false
  try:
    ignored = tables.csv_import("x", forged)
  recover tables.CsvAdapterError.InvalidFieldKind(index, kind):
    assertEqual(index, 0)
    assertEqual(kind, 99)
    kind_caught = true
  assert(kind_caught)

test "csv import parses all four kinds and quoted fields in row order":
  schema = tables.csv_schema([tables.csv_field("id", tables.kind_int(), false), tables.csv_field("score", tables.kind_float(), true), tables.csv_field("active", tables.kind_bool(), false), tables.csv_field("name", tables.kind_string(), false)], true, ",", "NA")
  input = "id,score,active,name\r\n2,1.5,true,\"Doe, \"\"D\"\"\"\r\n1,NA,false,\"line 1\nline 2\"\r\n"
  table = tables.csv_import(input, schema)
  assertEqual(tables.table_row_count(table), 2)
  assertEqual(tables.int_values(table, "id").values, [2, 1])
  scores = tables.float_values(table, "score")
  assertEqual(scores.values[0], 1.5)
  assert(not scores.validity[1])
  assertEqual(tables.bool_values(table, "active").values, [true, false])
  assertEqual(tables.string_values(table, "name").values[0], "Doe, \"D\"")
  assertEqual(tables.string_values(table, "name").values[1], "line 1\nline 2")

test "csv import validates headers and row widths":
  schema = tables.csv_schema([tables.csv_field("id", tables.kind_int(), false), tables.csv_field("name", tables.kind_string(), false)], true, ",", "NA")
  var missing_header_caught = false
  try:
    ignored = tables.csv_import("", schema)
  recover tables.CsvAdapterError.MissingHeader:
    missing_header_caught = true
  assert(missing_header_caught)

  var header_width_caught = false
  try:
    ignored = tables.csv_import("id\r\n", schema)
  recover tables.CsvAdapterError.HeaderWidthMismatch(expected, actual):
    assertEqual(expected, 2)
    assertEqual(actual, 1)
    header_width_caught = true
  assert(header_width_caught)

  var header_name_caught = false
  try:
    ignored = tables.csv_import("name,id\r\n", schema)
  recover tables.CsvAdapterError.HeaderNameMismatch(index):
    assertEqual(index, 0)
    header_name_caught = true
  assert(header_name_caught)

  var row_width_caught = false
  try:
    ignored = tables.csv_import("id,name\r\n1\r\n", schema)
  recover tables.CsvAdapterError.RowWidthMismatch(row, expected, actual):
    assertEqual(row, 0)
    assertEqual(expected, 2)
    assertEqual(actual, 1)
    row_width_caught = true
  assert(row_width_caught)

test "csv import rejects invalid numbers booleans and nonnullable missing":
  schema = tables.csv_schema([tables.csv_field("i", tables.kind_int(), false), tables.csv_field("f", tables.kind_float(), false), tables.csv_field("b", tables.kind_bool(), false)], false, ",", "NA")
  var int_caught = false
  try:
    ignored = tables.csv_import("12x,1.0,true", schema)
  recover tables.CsvAdapterError.InvalidCell(row, column, kind):
    assertEqual(row, 0)
    assertEqual(column, 0)
    assertEqual(kind, tables.kind_int())
    int_caught = true
  assert(int_caught)

  var float_caught = false
  try:
    ignored = tables.csv_import("12,1x,true", schema)
  recover tables.CsvAdapterError.InvalidCell(row, column, kind):
    assertEqual(row, 0)
    assertEqual(column, 1)
    assertEqual(kind, tables.kind_float())
    float_caught = true
  assert(float_caught)

  var bool_caught = false
  try:
    ignored = tables.csv_import("12,1.0,TRUE", schema)
  recover tables.CsvAdapterError.InvalidCell(row, column, kind):
    assertEqual(row, 0)
    assertEqual(column, 2)
    assertEqual(kind, tables.kind_bool())
    bool_caught = true
  assert(bool_caught)

  var missing_caught = false
  try:
    ignored = tables.csv_import("NA,1.0,true", schema)
  recover tables.CsvAdapterError.NonNullableMissing(row, column):
    assertEqual(row, 0)
    assertEqual(column, 0)
    missing_caught = true
  assert(missing_caught)

test "csv missing token escaping distinguishes present collisions":
  schema = tables.csv_schema([tables.csv_field("id", tables.kind_int(), false), tables.csv_field("note", tables.kind_string(), true)], false, ",", "NA")
  input = "1,NA\n2,\\NA\n3,\\\\lead"
  table = tables.csv_import(input, schema)
  notes = tables.string_values(table, "note")
  assert(not notes.validity[0])
  assert(notes.validity[1])
  assertEqual(notes.values[1], "NA")
  assertEqual(notes.values[2], "\\lead")

  int_schema = tables.csv_schema([tables.csv_field("id", tables.kind_int(), false)], false, ",", "7")
  int_table = tables.add_column(tables.new_table(1), tables.int_column("id", false, [7], [true]))
  encoded = tables.csv_export(int_table, int_schema)
  assertEqual(encoded, "\\7\r\n")
  decoded = tables.csv_import(encoded, int_schema)
  assertEqual(tables.int_values(decoded, "id").values[0], 7)

test "csv supported columns round trip with quoting and missing values":
  schema = tables.csv_schema([tables.csv_field("id", tables.kind_int(), false), tables.csv_field("active", tables.kind_bool(), false), tables.csv_field("note", tables.kind_string(), true)], true, ",", "MISSING")
  table0 = tables.new_table(4)
  table1 = tables.add_column(table0, tables.int_column("id", false, [7, -9, 10, 11], [true, true, true, true]))
  table2 = tables.add_column(table1, tables.bool_column("active", false, [true, false, true, false], [true, true, true, true]))
  table3 = tables.add_column(table2, tables.string_column("note", true, ["a,b \"q\"\nline", "MISSING", "\\lead", "ignored"], [true, true, true, false]))
  encoded = tables.csv_export(table3, schema)
  decoded = tables.csv_import(encoded, schema)
  assertEqual(tables.int_values(decoded, "id").values, [7, -9, 10, 11])
  assertEqual(tables.bool_values(decoded, "active").values, [true, false, true, false])
  notes = tables.string_values(decoded, "note")
  assertEqual(notes.values[0], "a,b \"q\"\nline")
  assertEqual(notes.values[1], "MISSING")
  assertEqual(notes.values[2], "\\lead")
  assert(notes.validity[0])
  assert(notes.validity[1])
  assert(notes.validity[2])
  assert(not notes.validity[3])

test "csv empty inputs and empty tables retain explicit schema":
  no_header = tables.csv_schema([tables.csv_field("id", tables.kind_int(), false)], false, ",", "NA")
  empty = tables.csv_import("", no_header)
  assertEqual(tables.table_row_count(empty), 0)
  assertEqual(tables.column_count(empty), 1)
  assertEqual(tables.csv_export(empty, no_header), "")

  with_header = tables.csv_schema([tables.csv_field("id", tables.kind_int(), false)], true, ",", "NA")
  header_only = tables.add_column(tables.new_table(0), tables.int_column("id", false, Vector[Int](), Vector[Bool]()))
  encoded = tables.csv_export(header_only, with_header)
  assertEqual(encoded, "id\r\n")
  decoded = tables.csv_import(encoded, with_header)
  assertEqual(tables.table_row_count(decoded), 0)
  assertEqual(tables.column_count(decoded), 1)

  float_header = tables.csv_schema([tables.csv_field("value", tables.kind_float(), true)], true, ",", "NA")
  empty_float = tables.add_column(tables.new_table(0), tables.float_column("value", true, Vector[Float](), Vector[Bool]()))
  assertEqual(tables.csv_export(empty_float, float_header), "value\r\n")

test "csv export rejects schema mismatch and unsupported exact formatting":
  int_table = tables.add_column(tables.new_table(1), tables.int_column("id", false, [1], [true]))
  count_schema = tables.csv_schema([tables.csv_field("id", tables.kind_int(), false), tables.csv_field("name", tables.kind_string(), false)], false, ",", "NA")
  var count_caught = false
  try:
    ignored = tables.csv_export(int_table, count_schema)
  recover tables.CsvAdapterError.TableColumnCountMismatch(expected, actual):
    assertEqual(expected, 2)
    assertEqual(actual, 1)
    count_caught = true
  assert(count_caught)

  name_schema = tables.csv_schema([tables.csv_field("other", tables.kind_int(), false)], false, ",", "NA")
  var name_caught = false
  try:
    ignored = tables.csv_export(int_table, name_schema)
  recover tables.CsvAdapterError.TableColumnNameMismatch(column):
    assertEqual(column, 0)
    name_caught = true
  assert(name_caught)

  kind_schema = tables.csv_schema([tables.csv_field("id", tables.kind_float(), false)], false, ",", "NA")
  var kind_caught = false
  try:
    ignored = tables.csv_export(int_table, kind_schema)
  recover tables.CsvAdapterError.TableColumnKindMismatch(column, expected, actual):
    assertEqual(column, 0)
    assertEqual(expected, tables.kind_float())
    assertEqual(actual, tables.kind_int())
    kind_caught = true
  assert(kind_caught)

  nullable_schema = tables.csv_schema([tables.csv_field("id", tables.kind_int(), true)], false, ",", "NA")
  var nullable_caught = false
  try:
    ignored = tables.csv_export(int_table, nullable_schema)
  recover tables.CsvAdapterError.TableColumnNullabilityMismatch(column, expected, actual):
    assertEqual(column, 0)
    assert(expected)
    assert(not actual)
    nullable_caught = true
  assert(nullable_caught)

  float_table = tables.add_column(tables.new_table(1), tables.float_column("value", false, [1.5], [true]))
  float_schema = tables.csv_schema([tables.csv_field("value", tables.kind_float(), false)], false, ",", "NA")
  var float_caught = false
  try:
    ignored = tables.csv_export(float_table, float_schema)
  recover tables.CsvAdapterError.UnsupportedFormatting(row, column, kind):
    assertEqual(row, 0)
    assertEqual(column, 0)
    assertEqual(kind, tables.kind_float())
    float_caught = true
  assert(float_caught)

  min_table = tables.add_column(tables.new_table(1), tables.int_column("id", false, [(-9223372036854775807 - 1)], [true]))
  min_schema = tables.csv_schema([tables.csv_field("id", tables.kind_int(), false)], false, ",", "NA")
  var min_caught = false
  try:
    ignored = tables.csv_export(min_table, min_schema)
  recover tables.CsvAdapterError.UnsupportedFormatting(row, column, kind):
    assertEqual(row, 0)
    assertEqual(column, 0)
    assertEqual(kind, tables.kind_int())
    min_caught = true
  assert(min_caught)

  missing_float = tables.add_column(tables.new_table(1), tables.float_column("value", true, [9.0], [false]))
  missing_float_schema = tables.csv_schema([tables.csv_field("value", tables.kind_float(), true)], false, ",", "NA")
  missing_encoded = tables.csv_export(missing_float, missing_float_schema)
  assertEqual(missing_encoded, "NA\r\n")
  missing_decoded = tables.csv_import(missing_encoded, missing_float_schema)
  assert(not tables.float_values(missing_decoded, "value").validity[0])
