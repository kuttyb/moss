import fmt

test "formatter builder indentation and lines":
  f = fmt.new_formatter("  ")
  buf = fmt.new_buffer()
  fmt.write_line(buf, f, "{")
  fmt.indent(f)
  fmt.write_indent(buf, f)
  fmt.write(buf, "\"name\": ")
  fmt.write(buf, "\"moss\"")
  fmt.write_newline(buf)
  fmt.dedent(f)
  fmt.write_line(buf, f, "}")
  output = fmt.finish(buf)
  expected = "{\n  \"name\": \"moss\"\n}\n"
  assertEqual(output, expected)

test "string padding and repeat":
  assertEqual(fmt.repeat_string("ab", 3), "ababab")
  assertEqual(fmt.repeat_string("x", 0), "")
  assertEqual(fmt.pad_left("42", 5, "0"), "00042")
  assertEqual(fmt.pad_right("hi", 4, " "), "hi  ")
  assertEqual(fmt.pad_left("longer", 4, " "), "longer")

test "hex formatting u16":
  assertEqual(fmt.format_hex_u16(0), "0000")
  assertEqual(fmt.format_hex_u16(65), "0041")
  assertEqual(fmt.format_hex_u16(8364), "20ac")
  assertEqual(fmt.format_hex_u16(65535), "ffff")

test "json string escaping":
  raw = "hello \"world\"\nline 2\ttab\\slash"
  escaped = fmt.escape_json_string(raw)
  expected = "hello \\\"world\\\"\\nline 2\\ttab\\\\slash"
  assertEqual(escaped, expected)

  quoted = fmt.quote_json_string("simple")
  quote = "\""
  assertEqual(quoted, quote + "simple" + quote)

test "csv field escaping":
  quote = "\""
  assertEqual(fmt.escape_csv_field("simple", ","), "simple")
  assertEqual(fmt.escape_csv_field("has,comma", ","), quote + "has,comma" + quote)
  assertEqual(fmt.escape_csv_field("line1\nline2", ","), quote + "line1\nline2" + quote)
  assertEqual(fmt.quote_csv_field_always("simple"), quote + "simple" + quote)

test "format_int boundaries and int64 min":
  assertEqual(fmt.format_int(0), "0")
  assertEqual(fmt.format_int(1), "1")
  assertEqual(fmt.format_int(-1), "-1")
  assertEqual(fmt.format_int(42), "42")
  assertEqual(fmt.format_int(-42), "-42")
  assertEqual(fmt.format_int(1000000), "1000000")
  assertEqual(fmt.format_int(-1000000), "-1000000")
  assertEqual(fmt.format_int(9223372036854775807), "9223372036854775807")
  int64_min = 0 - 9223372036854775807 - 1
  assertEqual(fmt.format_int(int64_min), "-9223372036854775808")

test "json string escaping control characters":
  var ctrl_in = Vector[String]()
  ctrl_in.push("a")
  ctrl_in.push("\n")
  ctrl_in.push("b")
  ctrl_in.push("\t")
  ctrl_in.push("c")
  ctrl_in.push("\r")
  ctrl_in.push("d")
  s = "".join(ctrl_in)
  escaped = fmt.escape_json_string(s)
  expected = "a\\nb\\tc\\rd"
  assertEqual(escaped, expected)
