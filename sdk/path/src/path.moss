module path

# moss.path uses POSIX lexical path syntax: '/' is the only separator and
# there is no host filesystem access. Paths are Unicode Strings; component
# positions are code-point positions only where an API returns a String.

fn exact_slice(value: String, start: Int, length: Int) -> String:
  if start < 0 or length < 0 or start > value.length() or length > value.length() - start:
    return ""
  if length == 0:
    return ""
  chars = value.chars()
  var pieces = Vector[String]()
  var i = 0
  while i < length:
    pieces.push(chars[start + i].to_string())
    i = i + 1
  return "".join(pieces)

fn is_separator(value: String) -> Bool:
  return value == "/"

fn trim_trailing_separators(value: String) -> String:
  length = value.length()
  if length == 0:
    return ""
  chars = value.chars()
  end = length
  while end > 1 and is_separator(chars[end - 1].to_string()):
    end = end - 1
  return exact_slice(value, 0, end)

fn starts_with_at(value_chars, pattern_chars, start: Int) -> Bool:
  pattern_length = pattern_chars |> count
  var i = 0
  while i < pattern_length:
    if value_chars[start + i] != pattern_chars[i]:
      return false
    i = i + 1
  return true

export fn is_absolute(value: String) -> Bool:
  return value.length() > 0 and value.char_at(0) == '/'

export fn is_relative(value: String) -> Bool:
  return not is_absolute(value)

# Return nonempty lexical components. Leading/trailing and repeated '/' are
# separators, not components; '.' and '..' remain visible in this raw view.
export fn components(value: String) -> Vector[String]:
  raw = value.split("/")
  result = Vector[String]()
  count = raw |> count
  var i = 0
  while i < count:
    if raw[i] != "":
      result.push(raw[i])
    i = i + 1
  return result

export fn component_count(value: String) -> Int:
  return components(value) |> count

# Normalize only lexical '.', '..', repeated separators, and trailing
# separators. It never reads the filesystem or resolves symlinks.
export fn normalize(value: String) -> String:
  absolute = is_absolute(value)
  raw = components(value)
  stack = Vector[String]()
  stack_count = 0
  raw_count = raw |> count
  var i = 0
  while i < raw_count:
    part = raw[i]
    if part == "" or part == ".":
      i = i + 1
    else:
      if part == "..":
        if stack_count > 0 and stack[stack_count - 1] != "..":
          stack_count = stack_count - 1
        else:
          if not absolute:
            if stack_count < (stack |> count):
              stack[stack_count] = part
            else:
              stack.push(part)
            stack_count = stack_count + 1
        i = i + 1
      else:
        if stack_count < (stack |> count):
          stack[stack_count] = part
        else:
          stack.push(part)
        stack_count = stack_count + 1
        i = i + 1

  result = ""
  if absolute:
    result = "/"
  var j = 0
  while j < stack_count:
    if result != "" and result != "/":
      result = result + "/"
    result = result + stack[j]
    j = j + 1
  if result == "":
    return "."
  return result

# Join with POSIX lexical rules. An absolute right operand replaces the left
# operand. The result is normalized, but no filesystem lookup occurs.
export fn join(left: String, right: String) -> String:
  if is_absolute(right):
    return normalize(right)
  if left == "":
    return normalize(right)
  if right == "":
    return normalize(left)
  return normalize(left + "/" + right)

export fn basename(value: String) -> String:
  normalized = normalize(value)
  if normalized == "/":
    return "/"
  trimmed = trim_trailing_separators(normalized)
  chars = trimmed.chars()
  length = chars |> count
  var i = length - 1
  while i >= 0:
    if is_separator(chars[i].to_string()):
      return exact_slice(trimmed, i + 1, length - i - 1)
    i = i - 1
  return trimmed

export fn dirname(value: String) -> String:
  normalized = normalize(value)
  if normalized == "/":
    return "/"
  trimmed = trim_trailing_separators(normalized)
  chars = trimmed.chars()
  length = chars |> count
  var i = length - 1
  while i >= 0:
    if is_separator(chars[i].to_string()):
      if i == 0:
        return "/"
      return exact_slice(trimmed, 0, i)
    i = i - 1
  return "."

# Return the suffix after the final '.' in the basename, without the dot.
# A leading dot is not an extension, so '.env' has an empty extension.
export fn extension(value: String) -> String:
  name = basename(value)
  if name == "/" or name == "." or name == "..":
    return ""
  chars = name.chars()
  length = chars |> count
  var i = length - 1
  while i > 0:
    if chars[i] == '.':
      return exact_slice(name, i + 1, length - i - 1)
    i = i - 1
  return ""

export fn stem(value: String) -> String:
  name = basename(value)
  ext = extension(value)
  if ext == "":
    return name
  return exact_slice(name, 0, name.length() - ext.length() - 1)

# Component-boundary prefix and suffix tests. Empty values are normalized to
# '.', so an empty path is the relative current-directory path.
export fn has_prefix(value: String, prefix: String) -> Bool:
  normalized = normalize(value)
  candidate = normalize(prefix)
  if candidate == "/":
    return is_absolute(normalized)
  if normalized == candidate:
    return true
  if normalized.length() <= candidate.length():
    return false
  if exact_slice(normalized, 0, candidate.length()) != candidate:
    return false
  return normalized.char_at(candidate.length()) == '/'

export fn has_suffix(value: String, suffix: String) -> Bool:
  normalized = normalize(value)
  candidate = normalize(suffix)
  if normalized == candidate:
    return true
  if candidate == "/":
    return normalized == "/"
  if normalized.length() <= candidate.length():
    return false
  start = normalized.length() - candidate.length()
  if exact_slice(normalized, start, candidate.length()) != candidate:
    return false
  return normalized.char_at(start - 1) == '/'
