{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moss:agent-feedback:1.0",
  "title": "Moss developer-experience observation",
  "description": "Schema version 1.0 for one line in agent-feedback/**/observations.jsonl. Later incompatible record shapes must use a new schema_version and schema revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "phase",
    "project",
    "workstream",
    "agent_role",
    "category",
    "task",
    "observation",
    "impact",
    "evidence",
    "resolution",
    "commit"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "phase": {
      "$ref": "#/$defs/path_component"
    },
    "project": {
      "$ref": "#/$defs/path_component"
    },
    "workstream": {
      "$ref": "#/$defs/path_component"
    },
    "agent_role": {
      "$ref": "#/$defs/nonempty_string"
    },
    "category": {
      "type": "string",
      "enum": [
        "language-friction",
        "language-positive",
        "surprise",
        "debugging-bottleneck",
        "ecosystem-friction",
        "tooling-positive",
        "tooling-negative",
        "performance-observation"
      ]
    },
    "task": {
      "$ref": "#/$defs/nonempty_string"
    },
    "observation": {
      "$ref": "#/$defs/nonempty_string"
    },
    "impact": {
      "$ref": "#/$defs/nonempty_string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["resolved", "unresolved", "workaround", "explained"]
        },
        "summary": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "severity": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        {"type": "null"}
      ]
    },
    "time_lost_minutes": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "tool_used": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "tool_helpfulness": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["helpful", "partially-helpful", "unhelpful"]
        },
        {"type": "null"}
      ]
    },
    "reproducer": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "suggestion": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "tags": {
      "anyOf": [
        {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonempty_string"
          }
        },
        {"type": "null"}
      ]
    },
    "related_issue": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "comparison_language": {
      "$ref": "#/$defs/nullable_nonempty_string"
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_nonempty_string": {
      "anyOf": [
        {"$ref": "#/$defs/nonempty_string"},
        {"type": "null"}
      ]
    },
    "path_component": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
