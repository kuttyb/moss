#!/usr/bin/env python3
"""Margo: deterministic Moss package/project orchestration.

Margo deliberately does not parse Moss.  It resolves packages, builds their
existing Moss project artifacts dependency-first, and supplies compiled module
interfaces through MOSS_MODULE_PATH to the compiler that owns module semantics.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import shlex
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
import tomllib


class MargoError(Exception):
    pass


REPO = Path(__file__).resolve().parent
MOSS = Path(os.environ.get("MOSS", REPO / "moss")).resolve()


def manifest_at(root: Path) -> Path:
    for name in ("Moss.toml", "moss.toml"):
        candidate = root / name
        if candidate.is_file():
            return candidate
    raise MargoError(f"package at {root} lacks Moss.toml")


def find_root(start: Path) -> Path:
    path = start.resolve()
    if path.is_file():
        path = path.parent
    while True:
        try:
            manifest_at(path)
            return path
        except MargoError:
            if path.parent == path:
                raise MargoError("no Moss.toml found in this directory or a parent")
            path = path.parent


def read_manifest(root: Path) -> tuple[Path, dict]:
    manifest = manifest_at(root)
    try:
        data = tomllib.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise MargoError(f"malformed manifest {manifest}: {error}") from error
    package = data.get("package", data.get("project"))
    if not isinstance(package, dict) or not isinstance(package.get("name"), str):
        raise MargoError(f"{manifest}: [package].name (or legacy [project].name) is required")
    if not isinstance(package.get("version"), str):
        raise MargoError(f"{manifest}: package version is required")
    dependencies = data.get("dependencies", {})
    if not isinstance(dependencies, dict):
        raise MargoError(f"{manifest}: [dependencies] must be a table")
    build = data.get("build", {})
    source = build.get("source", "src") if isinstance(build, dict) else "src"
    if not isinstance(source, str) or not source:
        raise MargoError(f"{manifest}: [build].source must be a non-empty relative path")
    return manifest, {"name": package["name"], "version": package["version"],
                      "dependencies": dependencies, "source": source}


def margo_home() -> Path:
    return Path(os.environ.get("MARGO_HOME", Path.home() / ".margo")).expanduser().resolve()


def run(command: list[str], *, cwd: Path | None = None, env: dict | None = None,
        capture: bool = False) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(command, cwd=cwd, env=env, text=True,
                              capture_output=capture, check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        detail = ((error.stderr or error.stdout or "").strip()
                  if isinstance(error, subprocess.CalledProcessError) else str(error))
        raise MargoError(f"command failed ({' '.join(command)}): {detail}") from error


def locked_git(lock: dict, name: str, url: str) -> str | None:
    for entry in lock.get("package", []):
        if entry.get("name") == name and entry.get("git") == url:
            commit = entry.get("commit")
            if isinstance(commit, str):
                return commit
    return None


def checkout_git(url: str, selector: str, home: Path) -> tuple[Path, str]:
    safe = hashlib.sha256(url.encode("utf-8")).hexdigest()[:24]
    database = home / "git" / "db" / safe
    # A lockfile pins a full commit. If its checkout already exists, resolution
    # is offline and must not contact the moving remote.
    if len(selector) == 40 and all(ch in "0123456789abcdef" for ch in selector.lower()):
        cached = home / "git" / "checkouts" / safe / selector
        if cached.is_dir():
            manifest_at(cached)
            return cached.resolve(), selector
    if not database.exists():
        database.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "clone", "--quiet", "--no-checkout", url, str(database)])
    else:
        run(["git", "-C", str(database), "fetch", "--quiet", "--tags", "origin"])
    resolved = run(["git", "-C", str(database), "rev-parse", f"{selector}^{{commit}}"], capture=True).stdout.strip()
    if len(resolved) != 40:
        raise MargoError(f"Git selector {selector!r} for {url} did not resolve to a commit")
    checkout = home / "git" / "checkouts" / safe / resolved
    if not checkout.exists():
        checkout.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "clone", "--quiet", "--no-checkout", str(database), str(checkout)])
        run(["git", "-C", str(checkout), "checkout", "--quiet", "--detach", resolved])
    manifest_at(checkout)
    return checkout.resolve(), resolved


class Package:
    def __init__(self, root: Path, manifest: Path, data: dict, identity: str,
                 source: dict):
        self.root, self.manifest, self.data = root, manifest, data
        self.identity, self.source = identity, source
        self.dependencies: list[Package] = []


def load_lock(root: Path) -> dict:
    lock = root / "Moss.lock"
    if not lock.exists():
        return {}
    try:
        data = tomllib.loads(lock.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise MargoError(f"malformed lockfile {lock}: {error}") from error
    if data.get("version", 1) != 1:
        raise MargoError(f"unsupported Moss.lock version in {lock}")
    return data


def write_lock(root: Path, packages: list[Package]) -> None:
    git = sorted((p for p in packages if p.source["kind"] == "git"),
                 key=lambda p: (p.data["name"], p.source["url"], p.source["commit"]))
    if not git:
        return
    lines = ["version = 1", ""]
    for package in git:
        lines += ["[[package]]", f'name = {package.data["name"]!r}',
                  f'git = {package.source["url"]!r}',
                  f'commit = {package.source["commit"]!r}', ""]
    text = "\n".join(lines)
    target = root / "Moss.lock"
    if not target.exists() or target.read_text(encoding="utf-8") != text:
        target.write_text(text, encoding="utf-8")


def resolve_graph(root: Path) -> tuple[Package, list[Package]]:
    lock, home = load_lock(root), margo_home()
    by_identity: dict[str, Package] = {}
    by_name: dict[str, str] = {}
    visiting: list[str] = []

    def visit(package_root: Path, identity: str, source: dict) -> Package:
        if identity in visiting:
            start = visiting.index(identity)
            names = [by_identity[item].data["name"] for item in visiting[start:]]
            raise MargoError("package dependency cycle: " + " -> ".join(names + [names[0]]))
        if identity in by_identity:
            return by_identity[identity]
        manifest, data = read_manifest(package_root)
        name = data["name"]
        other = by_name.get(name)
        if other and other != identity:
            raise MargoError(f"conflicting package identity for {name}: {other} vs {identity}")
        package = Package(package_root, manifest, data, identity, source)
        by_identity[identity] = package
        by_name[name] = identity
        visiting.append(identity)
        for dep_name in sorted(data["dependencies"]):
            spec = data["dependencies"][dep_name]
            if not isinstance(spec, dict):
                raise MargoError(f"{manifest}: dependency {dep_name!r} must use {{ path = ... }} or {{ git = ... }}")
            has_path, has_git = "path" in spec, "git" in spec
            if has_path == has_git:
                raise MargoError(f"{manifest}: dependency {dep_name!r} must specify exactly one of path or git")
            if has_path:
                if set(spec) != {"path"} or not isinstance(spec["path"], str):
                    raise MargoError(f"{manifest}: path dependency {dep_name!r} must contain only a string path")
                child_root = (package_root / spec["path"]).resolve()
                if child_root.suffix == ".moss":
                    raise MargoError(f"{manifest}: dependency {dep_name!r} must name a package root, not a .moss file")
                child = visit(child_root, "path:" + str(child_root), {"kind": "path", "path": str(child_root)})
            else:
                allowed = {"git", "rev", "tag", "branch"}
                if not set(spec) <= allowed or not isinstance(spec["git"], str):
                    raise MargoError(f"{manifest}: invalid Git dependency {dep_name!r}")
                selectors = [key for key in ("rev", "tag", "branch") if key in spec]
                if len(selectors) > 1:
                    raise MargoError(f"{manifest}: Git dependency {dep_name!r} may specify only one of rev, tag, branch")
                url = spec["git"]
                locked = locked_git(lock, dep_name, url)
                selector = locked or (spec[selectors[0]] if selectors else "HEAD")
                child_root, commit = checkout_git(url, selector, home)
                child = visit(child_root, f"git:{url}#{commit}", {"kind": "git", "url": url, "commit": commit})
            package.dependencies.append(child)
        visiting.pop()
        return package

    root_manifest, root_data = read_manifest(root)
    root_package = visit(root, "path:" + str(root.resolve()), {"kind": "root"})
    ordered: list[Package] = []
    emitted: set[str] = set()
    def emit(package: Package) -> None:
        for dependency in sorted(package.dependencies, key=lambda p: (p.data["name"], p.identity)):
            emit(dependency)
        if package.identity not in emitted:
            emitted.add(package.identity); ordered.append(package)
    emit(root_package)
    write_lock(root, ordered)
    return root_package, ordered


def profile_name(release: bool, check_only: bool = False) -> str:
    profile = "release" if release else "debug"
    return "check-" + profile if check_only else profile


def package_environment(root: Package, ordered: list[Package], release: bool,
                        check_only: bool = False) -> dict:
    paths = [str(package.root / "build" / profile_name(release, check_only))
             for package in ordered if package is not root]
    env = dict(os.environ)
    # The opt-in ABI-v10 compiler uses one content-addressed shared runtime
    # artifact across every package in this dependency graph.
    env.setdefault("MOSS_RUNTIME_SOURCE_DIR", str(REPO / "runtime" / "moss_runtime"))
    env["MOSS_MARGO_PACKAGE_BUILD_ROOTS"] = os.pathsep.join(
        str((package.root / "build" / profile_name(release, check_only)).resolve())
        for package in ordered)
    if paths:
        existing = [p for p in env.get("MOSS_MODULE_PATH", "").split(os.pathsep) if p]
        pkg_build_dirs = {str((pkg.root / "build").resolve()) for pkg in ordered}
        filtered_existing = []
        for p in existing:
            try:
                resolved_p = str(Path(p).resolve())
                if not any(resolved_p == b_dir or resolved_p.startswith(b_dir + os.sep) for b_dir in pkg_build_dirs):
                    filtered_existing.append(p)
            except Exception:
                filtered_existing.append(p)
        env["MOSS_MODULE_PATH"] = os.pathsep.join(paths + filtered_existing)
    return env


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def semantic_interfaces(package: Package, release: bool,
                        check_only: bool = False) -> list[dict]:
    directory = package.root / "build" / profile_name(release, check_only)
    rows = []
    for interface in sorted(directory.glob("*.mossi")):
        fields = {}
        for line in interface.read_text(encoding="utf-8").splitlines():
            key, separator, value = line.partition(" ")
            if separator and key in {"module_id", "native_abi", "schema_version",
                                     "concrete_interface_hash", "generic_semantic_hash",
                                     "semantic_contract_hash"}:
                fields[key] = value
        if "module_id" not in fields:
            raise MargoError(f"invalid module interface identity in {interface}")
        if fields.get("schema_version") == "10":
            semantic = fields.get("semantic_contract_hash")
            if not semantic:
                raise MargoError(f"missing semantic contract hash in {interface}")
            hashes = {"semantic_contract_hash": semantic}
        else:
            concrete = fields.get("concrete_interface_hash")
            generic = fields.get("generic_semantic_hash")
            if not concrete or not generic:
                raise MargoError(f"missing semantic interface hashes in {interface}")
            hashes = {"concrete_interface_hash": concrete,
                      "generic_semantic_hash": generic}
        rows.append({"module_id": fields["module_id"],
                     "native_abi": fields.get("native_abi", ""), **hashes})
    return rows


def package_toolchain_identity(check_only: bool) -> dict:
    compiler = MOSS
    if not compiler.is_file():
        raise MargoError(f"Moss compiler is not a file: {compiler}")
    identity = {"moss_path": str(compiler), "moss_sha256": sha256_file(compiler)}
    delegated = os.environ.get("M1_REAL_MOSS")
    if delegated:
        delegated_path = Path(delegated).resolve()
        identity["delegated_moss_path"] = str(delegated_path)
        identity["delegated_moss_sha256"] = sha256_file(delegated_path)
    if not check_only:
        configured = os.environ.get("RUSTC", "rustc")
        rustc = shutil.which(configured) if "/" not in configured else configured
        if not rustc or not Path(rustc).is_file():
            raise MargoError("rustc was not found; install Rust or set RUSTC to an executable")
        rustc_path = Path(rustc).resolve()
        version = subprocess.run([str(rustc_path), "--version", "--verbose"],
                                 text=True, capture_output=True, check=False)
        if version.returncode != 0:
            raise MargoError("could not identify the configured Rust compiler")
        identity.update({"rustc_path": str(rustc_path),
                         "rustc_sha256": sha256_file(rustc_path),
                         "rustc_version": version.stdout.strip()})
    return identity


def package_sources(package: Package) -> list[dict]:
    source_root = package.root / package.data["source"]
    if source_root.is_file():
        files = [source_root] if source_root.suffix == ".moss" else []
    elif source_root.is_dir():
        files = sorted(path for path in source_root.rglob("*.moss") if path.is_file())
    else:
        files = []
    rows = []
    for path in files:
        rows.append({"path": path.relative_to(package.root).as_posix(),
                     "sha256": sha256_file(path)})
    if not rows:
        raise MargoError(f"package {package.data['name']} has no Moss sources under {source_root}")
    return rows


def package_test_sources(package: Package) -> list[Path]:
    tests_root = package.root / "tests"
    if not tests_root.is_dir():
        return []
    return sorted(path for path in tests_root.rglob("*.moss") if path.is_file())


def dependency_native_artifacts(package: Package, release: bool) -> list[dict]:
    rows = []
    profile = "release" if release else "debug"
    for dependency in sorted(package.dependencies,
                             key=lambda item: (item.data["name"], item.identity)):
        directory = dependency.root / "build" / profile
        for artifact in sorted(directory.glob("*.rlib")):
            rows.append({"package": dependency.identity,
                         "path": artifact.name,
                         "sha256": sha256_file(artifact)})
    return rows


def ambient_provider_source_state(interface: Path) -> dict:
    owner = next((parent for parent in interface.parents
                  if (parent / "Moss.toml").is_file() or
                     (parent / "moss.toml").is_file()), None)
    if owner is None:
        owner = next((parent for parent in interface.parents
                      if (parent / "build").is_dir()), None)
    if owner is None:
        return {"owner": "missing"}

    candidates = [owner / "Moss.toml", owner / "moss.toml"]
    manifest = next((path for path in candidates if path.is_file()), None)
    if manifest is None:
        return {"owner": str(owner), "manifest": "missing"}
    state = {"owner": str(owner), "manifest": str(manifest),
             "manifest_sha256": sha256_file(manifest)}
    try:
        _, data = read_manifest(owner)
    except MargoError as error:
        state["manifest_error"] = str(error)
        return state

    source_root = owner / data["source"]
    state["source_root"] = str(source_root)
    state["source_root_exists"] = source_root.exists()
    if source_root.is_file():
        paths = [source_root] if source_root.suffix == ".moss" else []
    elif source_root.is_dir():
        paths = sorted(path for path in source_root.rglob("*.moss")
                       if path.is_file())
    else:
        paths = []
    state["sources"] = [
        {"path": path.relative_to(owner).as_posix(),
         "sha256": sha256_file(path)} for path in paths]
    return state


def ambient_provider_is_current(interface: Path) -> bool:
    """Whether the interface's source freshness key matches its owner.

    The boolean is safe in check-only fingerprints: ordinary body edits do
    not invalidate consumers once the provider has rebuilt its interface,
    while a stale ambient interface changes the key and cannot be skipped.
    """
    owner = next((parent for parent in interface.parents
                  if (parent / "Moss.toml").is_file() or
                  (parent / "moss.toml").is_file()), None)
    if owner is None:
        return False
    manifest, data = read_manifest(owner)
    source_root = owner / data["source"]
    if source_root.is_file():
        sources = [source_root] if source_root.suffix == ".moss" else []
    elif source_root.is_dir():
        sources = sorted(path for path in source_root.rglob("*.moss")
                         if path.is_file())
    else:
        sources = []
    if not sources:
        return False
    material = bytearray(f"{len(sources)}\n".encode("utf-8"))
    for source in sources:
        relative = source.relative_to(owner).as_posix().encode("utf-8")
        contents = source.read_bytes()
        material.extend(f"{len(relative)}\n".encode("ascii"))
        material.extend(relative)
        material.extend(f"{len(contents)}\n".encode("ascii"))
        material.extend(contents)
    declared = next((line.partition(b" ")[2]
                     for line in interface.read_bytes().splitlines()
                     if line.startswith(b"package_source_hash ")), b"")
    return declared == ("sha256:" + hashlib.sha256(material).hexdigest()).encode()


def ambient_provider_inputs(package: Package, ordered: list[Package],
                            release: bool, check_only: bool) -> list[dict]:
    graph_build_roots = {str((package.root / "build").resolve())
                         for package in ordered}
    roots = []
    for position, entry in enumerate(filter(None,
            os.environ.get("MOSS_MODULE_PATH", "").split(os.pathsep))):
        roots.append({"origin": "MOSS_MODULE_PATH", "position": position,
                      "path": Path(entry).resolve()})
    roots.append({"origin": "package-deps", "position": 0,
                  "path": (package.root / "deps").resolve()})
    rows = []
    for origin in roots:
        root = origin["path"]
        if origin["origin"] == "MOSS_MODULE_PATH" and any(
                str(root) == build or str(root).startswith(build + os.sep)
                for build in graph_build_roots):
            continue
        if not root.is_dir():
            rows.append({**{key: value for key, value in origin.items()
                           if key != "path"}, "path": str(root),
                         "missing": True})
            continue
        for interface in sorted(root.rglob("*.mossi")):
            record = {**{key: value for key, value in origin.items()
                         if key != "path"}, "path": str(interface),
                      "section1": ambient_semantic_interface(interface)}
            if check_only:
                try:
                    record["source_current"] = ambient_provider_is_current(interface)
                except (OSError, ValueError, MargoError) as error:
                    raise MargoError(
                        f"cannot validate ambient provider freshness {interface}: {error}")
            else:
                # Native package outputs may need relinking after a provider
                # body changes. Semantic-check fingerprints intentionally use
                # only Section 1; Section 2 is checked execution data.
                record["interface_sha256"] = sha256_file(interface)
                try:
                    record["provider_source_state"] = \
                        ambient_provider_source_state(interface)
                except (OSError, ValueError) as error:
                    raise MargoError(
                        f"cannot fingerprint ambient provider interface {interface}: {error}")
            if not check_only:
                candidates = [interface.with_suffix(".rlib"),
                              interface.parent / ("lib" + interface.stem + ".rlib")]
                rlib = next((candidate for candidate in candidates
                             if candidate.is_file()), None)
                record["native_artifact_sha256"] = (
                    sha256_file(rlib) if rlib else "missing")
            rows.append(record)
    return rows


def ambient_semantic_interface(interface: Path) -> dict:
    raw = interface.read_bytes()
    section_marker = b"\nexecution_body_version "
    section2 = raw.find(section_marker)
    section1 = raw[:section2] + b"\n" if section2 >= 0 else raw
    section1 = b"".join(
        line for line in section1.splitlines(keepends=True)
        if not line.startswith(b"package_source_hash "))
    section1 = normalize_section1_locations(section1)
    fields = {}
    for raw_line in section1.splitlines():
        line = raw_line.decode("utf-8", errors="ignore")
        key, separator, value = line.partition(" ")
        if separator and key in {"module_id", "native_abi", "schema_version",
                                 "concrete_interface_hash", "generic_semantic_hash",
                                 "semantic_contract_hash", "binary_contract_hash"}:
            fields[key] = value
    if "module_id" not in fields:
        raise MargoError(f"invalid module interface identity in {interface}")
    if fields.get("schema_version") == "10":
        semantic = fields.get("semantic_contract_hash")
        binary = fields.get("binary_contract_hash")
        if not semantic:
            raise MargoError(f"missing ABI-v10 semantic or binary contract hash in {interface}")
        consumer_contract = "\n".join((fields["module_id"],
                                         fields.get("native_abi", ""),
                                         binary or "", semantic)) + "\n"
        return {"module_id": fields["module_id"],
                "native_abi": fields.get("native_abi", ""),
                "semantic_contract_hash": semantic,
                "section1_sha256": hashlib.sha256(
                    consumer_contract.encode("utf-8")).hexdigest()}
    concrete = fields.get("concrete_interface_hash")
    generic = fields.get("generic_semantic_hash")
    if not concrete or not generic:
        raise MargoError(f"missing semantic interface hashes in {interface}")
    return {"module_id": fields["module_id"],
            "native_abi": fields.get("native_abi", ""),
            "concrete_interface_hash": concrete,
            "generic_semantic_hash": generic,
            "section1_sha256": hashlib.sha256(section1).hexdigest()}


def normalize_section1_locations(section1: bytes) -> bytes:
    """Hash Section 1 independently from absolute source line metadata."""
    def replace_field(line: bytes, index: int) -> bytes:
        start = 0
        for _ in range(index):
            while start < len(line) and line[start:start + 1].isspace():
                start += 1
            while start < len(line) and not line[start:start + 1].isspace():
                start += 1
        while start < len(line) and line[start:start + 1].isspace():
            start += 1
        end = start
        while end < len(line) and not line[end:end + 1].isspace():
            end += 1
        return line[:start] + b"0" + line[end:] if end > start else line

    normalized = []
    for raw_line in section1.splitlines(keepends=True):
        ending = b"\n" if raw_line.endswith(b"\n") else b""
        line = raw_line[:-1] if ending else raw_line
        fields = line.split()
        if fields:
            if fields[0] == b"generic_stmt" and len(fields) >= 3:
                line = replace_field(line, 2)
            elif fields[0] == b"generic_result" and len(fields) >= 2:
                line = replace_field(line, 1)
            elif fields[0].endswith(b"_warning"):
                index = 2 if fields[0] in {
                    b"object_method_warning", b"handler_warning"} else 1
                if len(fields) > index:
                    line = replace_field(line, index)
            elif fields[0] == b"generic_entity_id":
                line = re.sub(rb"@[0-9]+(?=\")", b"@0", line)
        normalized.append(line + ending)
    return b"".join(normalized)


def execution_body_package_fingerprint(interface: Path) -> str | None:
    lines = interface.read_bytes().splitlines()
    try:
        payload = lines.index(b"execution_body_payload")
    except ValueError:
        return None
    if payload + 1 >= len(lines):
        raise MargoError(f"truncated execution-body section in {interface}")
    key, separator, value = lines[payload + 1].partition(b" ")
    if key != b"package_fingerprint" or not separator or not value:
        raise MargoError(f"missing execution-body package fingerprint in {interface}")
    try:
        return value.decode("ascii")
    except UnicodeDecodeError as error:
        raise MargoError(f"malformed execution-body package fingerprint in {interface}") from error


def interface_native_abi(interface: Path) -> int | None:
    match = re.search(rb"(?m)^native_abi ([0-9]+)$", interface.read_bytes())
    return int(match.group(1)) if match else None


def package_fingerprint(package: Package, release: bool, check_only: bool,
                        toolchain: dict, ordered: list[Package],
                        include_test_sources: bool) -> str:
    dependencies = []
    for dependency in sorted(package.dependencies,
                             key=lambda item: (item.data["name"], item.identity)):
        dependencies.append({"identity": dependency.identity,
                             "semantic_interfaces": semantic_interfaces(
                                 dependency, release, check_only)})
    flags = {key: os.environ.get(key, "") for key in (
        "MOSS_STAGED_ABI", "MOSS_STAGED_STRING_REPR", "MOSS_RUNTIME_SOURCE_DIR",
        "RUSTFLAGS", "CARGO_ENCODED_RUSTFLAGS")}
    payload = {
        "format": "margo-package-fingerprint-v3",
        "execution_body_section": 1,
        "check_test_target": "root-only" if check_only else "none",
        "identity": package.identity,
        "name": package.data["name"],
        "version": package.data["version"],
        "manifest_sha256": sha256_file(package.manifest),
        "sources": package_sources(package),
        "test_sources": ([{"path": path.relative_to(package.root).as_posix(),
                           "sha256": sha256_file(path)}
                          for path in package_test_sources(package)]
                         if check_only and include_test_sources else []),
        "dependencies": dependencies,
        # Cargo owns Rust dependency freshness. Moss semantic packages are
        # invalidated by the provider interfaces above, not rlib byte hashes.
        "native_dependency_artifacts": [],
        "ambient_providers": ambient_provider_inputs(
            package, ordered, release, check_only),
        "compiler_and_toolchain": toolchain,
        "flags": flags,
        "profile": profile_name(release, check_only),
        "mode": "semantic-check" if check_only else "native-build",
    }
    material = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(material.encode("utf-8")).hexdigest()


def output_snapshot(package: Package, release: bool,
                    check_only: bool, result: dict | None) -> dict:
    directory = package.root / "build" / profile_name(release, check_only)
    # Both interface and location sidecars are required cached outputs. A
    # missing .locations file must invalidate the provider's package state so
    # imported declarations retain editor navigation metadata.
    files: set[Path] = set(directory.glob("*.mossi"))
    files.update(directory.glob("*.locations"))
    if result:
        artifacts = result.get("artifacts", {})
        if isinstance(artifacts, dict):
            for key, value in artifacts.items():
                if key == "backend_toolchain":
                    continue
                values = value if isinstance(value, list) else [value]
                for item in values:
                    if isinstance(item, str):
                        candidate = Path(item)
                        if candidate.is_file():
                            files.add(candidate)
    return {str(path.resolve()): sha256_file(path)
            for path in sorted(files) if path.is_file()}


def cargo_package_name(package: Package, kind: str, module: str = "") -> str:
    if kind == "bin":
        stable_name = re.sub(r"[^A-Za-z0-9_]", "_", package.data["name"]).rstrip("_")
        return "moss_package_" + (stable_name or "anonymous")
    identity = package.identity + "\n" + kind + "\n" + module
    return "margo_" + kind + "_" + hashlib.sha256(
        identity.encode("utf-8")).hexdigest()[:20]


def rust_crate_name(module: str) -> str:
    value = re.sub(r"[^A-Za-z0-9_]", "_", "moss_" + module).rstrip("_")
    return value or "anonymous"


def write_if_changed(path: Path, contents: str) -> None:
    if path.is_file() and path.read_text(encoding="utf-8") == contents:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(contents, encoding="utf-8")


def cargo_build_graph(root: Package, packages: list[Package],
                      artifacts: dict[str, dict], release: bool,
                      jobs: int) -> tuple[list[str], list[str]]:
    """Compile all emitted Rust for one resolved graph in a stable Cargo workspace."""
    profile = profile_name(release)
    for package in packages:
        stale_workspace = package.root / "build" / profile / ".margo-cargo"
        if stale_workspace.is_dir():
            shutil.rmtree(stale_workspace)
    legacy_workspace = root.root / "build" / profile / ".margo-cargo"
    if legacy_workspace.is_dir():
        shutil.rmtree(legacy_workspace)
    workspace = root.root / "build" / ".margo-cargo" / profile
    crates_dir = workspace / "crates"
    crates_dir.mkdir(parents=True, exist_ok=True)
    records = []
    modules_by_package = {}
    binary_names = [cargo_package_name(package, "bin") for package in packages]
    if len(binary_names) != len(set(binary_names)):
        raise MargoError("Moss package names collide after Cargo name normalization")
    for package in packages:
        artifact_data = artifacts[package.identity].get("artifacts", {})
        modules = {}
        for raw_rlib in artifact_data.get("module_rlibs", []):
            stem = Path(raw_rlib).name
            if not stem.startswith("lib") or not stem.endswith(".rlib"):
                raise MargoError(f"unexpected module rlib path: {raw_rlib}")
            module = stem[3:-5]
            source = package.root / "build" / profile_name(release) / f"{module}.rs"
            if not source.is_file():
                raise MargoError(f"generated Rust is missing for {module}: {source}")
            name = cargo_package_name(package, "lib", module)
            record = {"package": package, "module": module,
                      "crate_name": rust_crate_name(module), "source": source,
                      "cargo_name": name, "crate_dir": crates_dir / name,
                      "kind": "lib"}
            modules[module] = record
            records.append(record)
        modules_by_package[package.identity] = modules
        source = Path(artifact_data.get("generated_rust", ""))
        executable = Path(artifact_data.get("executable", ""))
        if not source.is_file() or not executable.name:
            raise MargoError(f"generated root Rust or executable path is missing for {package.data['name']}")
        name = cargo_package_name(package, "bin")
        records.append({"package": package, "module": "", "crate_name": "",
                        "source": source, "cargo_name": name,
                        "crate_dir": crates_dir / name, "kind": "bin",
                        "executable": executable})

    graph_modules = {module for modules in modules_by_package.values()
                     for module in modules}
    ambient_modules: dict[str, dict] = {}
    ambient_packages: dict[str, Package] = {}
    ambient_candidates: dict[str, list[tuple[Path, str, str]]] = {}
    ambient_roots = [Path(raw_root) for raw_root in
                     os.environ.get("MOSS_MODULE_PATH", "").split(os.pathsep)
                     if raw_root]
    ambient_roots.extend(package.root / "deps" for package in packages)
    for ambient_root in ambient_roots:
        if not ambient_root.is_dir():
            continue
        for interface in ambient_root.rglob("*.mossi"):
            try:
                # v10 interfaces include length-delimited binary payloads after
                # the textual header, so decode only the individual header rows.
                interface_lines = [line.decode("ascii") for line in
                                   interface.read_bytes().splitlines()
                                   if line.isascii()]
            except OSError:
                continue
            module_id = next((line.split(maxsplit=1)[1]
                              for line in interface_lines
                              if line.startswith("module_id ")), "")
            module = module_id.rsplit("::", 1)[-1] if module_id else interface.stem
            if module in graph_modules:
                continue
            contract = next((line for line in interface_lines
                             if line.startswith("provider_contract_digest ") or
                             line.startswith("semantic_contract_hash ")), "")
            ambient_candidates.setdefault(module, []).append(
                (interface.resolve(), module_id, contract))

    def provider_for(package: Package, module: str) -> dict:
        local = modules_by_package[package.identity].get(module)
        if local:
            return local
        candidates = []
        visited = set()
        def visit(current: Package) -> None:
            for dependency in current.dependencies:
                if dependency.identity in visited:
                    continue
                visited.add(dependency.identity)
                found = modules_by_package.get(dependency.identity, {}).get(module)
                if found:
                    candidates.append(found)
                visit(dependency)
        visit(package)
        if not candidates and module in ambient_modules:
            candidates.append(ambient_modules[module])
        if len(candidates) != 1:
            reason = "missing" if not candidates else "ambiguous"
            raise MargoError(f"Cargo provider for module {module} is {reason} in {package.data['name']}")
        return candidates[0]

    def materialize_ambient(module: str) -> None:
        if module in graph_modules or module in ambient_modules:
            return
        choices = ambient_candidates.get(module, [])
        contracts = {(module_id, contract) for _, module_id, contract in choices}
        if not choices:
            raise MargoError(f"Cargo provider for module {module} is missing from ambient module paths")
        if len(contracts) > 1:
            raise MargoError(f"ambiguous ambient Cargo provider for module {module}")
        interface = choices[0][0]
        owner = next((parent for parent in interface.parents
                      if (parent / "Moss.toml").is_file() or
                      (parent / "moss.toml").is_file()), None)
        if owner is None:
            raise MargoError(f"source-backed Cargo provider {module} has no package manifest")
        manifest, data = read_manifest(owner)
        stale_workspace = owner / "build" / profile / ".margo-cargo"
        if stale_workspace.is_dir():
            shutil.rmtree(stale_workspace)
        identity = "ambient-path:" + str(owner.resolve())
        package = ambient_packages.setdefault(identity, Package(
            owner.resolve(), manifest, data, identity,
            {"kind": "ambient", "path": str(owner.resolve())}))
        source = owner / "build" / profile_name(release) / f"{module}.rs"
        if not source.is_file():
            source = interface.parent / f"{module}.rs"
        if not source.is_file():
            emit_env = dict(os.environ)
            emit_env["MOSS_MARGO_CARGO_DRIVER"] = "1"
            emit_env["MOSS_MARGO_PACKAGE_BUILD_ROOTS"] = os.pathsep.join(
                [*(str((item.root / "build" / profile_name(release)).resolve())
                  for item in packages),
                 str((owner / "build" / profile_name(release)).resolve())])
            run([str(MOSS), "build", "--json"], cwd=owner, env=emit_env,
                capture=True)
            source = owner / "build" / profile_name(release) / f"{module}.rs"
            if not source.is_file():
                raise MargoError(
                    f"source-backed Cargo provider {module} has no generated Rust artifact")
        name = cargo_package_name(package, "lib", module)
        record = {"package": package, "module": module,
                  "crate_name": rust_crate_name(module), "source": source,
                  "cargo_name": name, "crate_dir": crates_dir / name,
                  "kind": "lib", "ambient": True}
        ambient_modules[module] = record
        modules_by_package.setdefault(identity, {})[module] = record
        records.append(record)
        imports = set(re.findall(
            r"(?m)^\s*extern crate (moss_[A-Za-z_][A-Za-z0-9_]*);",
            source.read_text(encoding="utf-8")))
        for crate in sorted(imports):
            if crate != "moss_runtime" and crate.startswith("moss_"):
                dependency = crate[5:]
                if dependency not in graph_modules:
                    materialize_ambient(dependency)

    initial_imports = set()
    for record in records:
        initial_imports.update(re.findall(
            r"(?m)^\s*extern crate (moss_[A-Za-z_][A-Za-z0-9_]*);",
            record["source"].read_text(encoding="utf-8")))
    for crate in sorted(initial_imports):
        module = crate[5:]
        if module not in graph_modules:
            materialize_ambient(module)

    record_by_name = {record["cargo_name"]: record for record in records}
    for existing in crates_dir.iterdir():
        if existing.is_dir() and existing.name not in record_by_name:
            shutil.rmtree(existing)

    # Build manifests after the ambient module closure has been added.

    runtime_dir = Path(os.environ.get("MOSS_RUNTIME_SOURCE_DIR",
                                     REPO / "runtime" / "moss_runtime")).resolve()
    external_crates: dict[str, Path] = {}
    for record in records:
        imports = sorted(set(re.findall(
            r"(?m)^\s*extern crate ([A-Za-z_][A-Za-z0-9_]*);",
            record["source"].read_text(encoding="utf-8"))))
        source_text = record["source"].read_text(encoding="utf-8")
        if "moss_runtime::" in source_text and "moss_runtime" not in imports:
            imports.append("moss_runtime")
        dependencies = []
        for crate in imports:
            if crate == "moss_runtime" and (runtime_dir / "Cargo.toml").is_file():
                dependencies.append((crate, "moss_runtime", runtime_dir))
            elif crate.startswith("moss_"):
                module = crate[5:]
                try:
                    provider = provider_for(record["package"], module)
                except MargoError as error:
                    raise
                else:
                    dependencies.append((crate, provider["cargo_name"], provider["crate_dir"]))
            else:
                raise MargoError(f"unsupported generated Rust dependency {crate} in {record['source']}")
        crate_dir = record["crate_dir"]
        cargo_source = record["source"]
        manifest = ["[package]", f"name = {json.dumps(record['cargo_name'])}",
                    f"version = {json.dumps(record['package'].data['version'])}",
                    'edition = "2021"', 'build = "build.rs"',
                    'publish = false', ""]
        source_rel = os.path.relpath(record["source"].resolve(), crate_dir.resolve())
        if record["kind"] == "lib":
            manifest += ["[lib]", f"name = {json.dumps(record['crate_name'])}",
                         f"path = {json.dumps(source_rel)}", ""]
        else:
            manifest += ["[[bin]]", f"name = {json.dumps(record['executable'].name)}",
                         f"path = {json.dumps(source_rel)}", ""]
        if dependencies:
            manifest.append("[dependencies]")
            for alias, name, dependency_dir in dependencies:
                dependency_path = os.path.relpath(dependency_dir.resolve(), crate_dir.resolve())
                manifest.append(f"{alias} = {{ package = {json.dumps(name)}, path = {json.dumps(dependency_path)} }}")
            manifest.append("")
        write_if_changed(crate_dir / "Cargo.toml", "\n".join(manifest))
        build_rs = ('fn main() { println!("cargo:rerun-if-env-changed=MOSS_EXTERNAL_RLIB_FINGERPRINT"); '
                    'println!("cargo:rustc-env=MOSS_EXTERNAL_RLIB_FINGERPRINT={}", '
                    'std::env::var("MOSS_EXTERNAL_RLIB_FINGERPRINT").unwrap_or_default()); '
                    'println!("cargo:rustc-check-cfg=cfg(moss_process_root)"); '
                    'println!("cargo:rustc-check-cfg=cfg(moss_perf)"); '
                    + ('println!("cargo:rustc-cfg=moss_process_root"); ' if record["kind"] == "bin" else '')
                    + '}\n')
        write_if_changed(crate_dir / "build.rs", build_rs)

    members = sorted(os.path.relpath(record["crate_dir"], workspace)
                     for record in records)
    workspace_manifest = "[workspace]\nmembers = [\n" + "".join(
        f"  {json.dumps(member)},\n" for member in members) + "]\nresolver = \"2\"\n"
    write_if_changed(workspace / "Cargo.toml", workspace_manifest)
    env = dict(os.environ)
    encoded_flags = env.get("CARGO_ENCODED_RUSTFLAGS")
    flags = encoded_flags.split("\x1f") if encoded_flags else shlex.split(env.get("RUSTFLAGS", ""))
    flags.extend(["-D", "warnings"])
    env["MOSS_EXTERNAL_RLIB_FINGERPRINT"] = ""
    env["CARGO_ENCODED_RUSTFLAGS"] = "\x1f".join(flags)
    command = [os.environ.get("CARGO", "cargo"), "build", "--workspace",
               "--manifest-path", str(workspace / "Cargo.toml"),
               "--jobs", str(jobs), "--message-format=json-render-diagnostics"]
    completed = subprocess.run(command, cwd=root.root, env=env, text=True,
                               capture_output=True, check=False)
    if completed.returncode != 0:
        raise MargoError(f"Cargo package build failed: {(completed.stderr or completed.stdout).strip()}")
    metadata = json.loads(run([os.environ.get("CARGO", "cargo"), "metadata",
                              "--format-version", "1", "--manifest-path",
                              workspace / "Cargo.toml"], cwd=root.root,
                              env=env, capture=True).stdout)
    id_to_name = {item["id"]: item["name"] for item in metadata.get("packages", [])}
    freshness = {package.data["name"]: [] for package in packages}
    for line in completed.stdout.splitlines():
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if message.get("reason") != "compiler-artifact":
            continue
        record = record_by_name.get(id_to_name.get(message.get("package_id"), ""))
        if not record:
            continue
        kinds = message.get("target", {}).get("kind", [])
        if any(kind in ("lib", "bin") for kind in kinds):
            freshness.setdefault(record["package"].data["name"], []).append(
                bool(message.get("fresh", False)))
        filenames = [Path(path) for path in message.get("filenames", [])]
        if record["kind"] == "lib" and not record.get("ambient", False):
            rlib = next((path for path in filenames if path.suffix == ".rlib"), None)
            if rlib is not None:
                stable = record["package"].root / "build" / profile_name(release) / f"lib{record['module']}.rlib"
                stable.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(rlib, stable)
                alias = stable.parent / f"lib{record['crate_name']}.rlib"
                if alias != stable:
                    shutil.copyfile(rlib, alias)
        elif record["kind"] == "bin":
            binary = next((path for path in filenames if path.is_file()), None)
            if binary is not None:
                record["executable"].parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(binary, record["executable"])
    package_names = [package.data["name"] for package in packages]
    checked = [name for name in package_names
               if freshness.get(name) and not all(freshness[name])]
    skipped = [name for name in package_names
               if freshness.get(name) and all(freshness[name])]
    return checked, skipped


def atomic_json(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + f".{os.getpid()}.tmp")
    temporary.write_text(json.dumps(payload, sort_keys=True, indent=2) + "\n",
                         encoding="utf-8")
    os.replace(temporary, path)


def build_graph(root: Package, ordered: list[Package], release: bool,
                json_mode: bool, check_only: bool = False,
                jobs: int = 1) -> tuple[list[dict], list[str], list[str], list[str], list[str]]:
    if jobs < 1:
        raise MargoError("package build job count must be at least 1")
    toolchain = package_toolchain_identity(check_only)

    def build_one(package: Package) -> tuple[dict, bool]:
        profile = profile_name(release, check_only)
        state_path = package.root / "build" / profile / ".margo-fingerprint.json"
        is_root_package = package.root.resolve() == root.root.resolve()
        fingerprint = package_fingerprint(package, release, check_only,
                                          toolchain, ordered,
                                          include_test_sources=is_root_package)
        prior = {}
        try:
            prior = json.loads(state_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            pass
        prior_result = prior.get("result") if isinstance(prior, dict) else None
        current_outputs = output_snapshot(package, release, check_only, prior_result)
        has_check_interface = any(Path(path).suffix == ".mossi"
                                  for path in current_outputs)
        if (prior.get("format") == "margo-package-state-v1" and
                prior.get("fingerprint") == fingerprint and
                prior.get("outputs") == current_outputs and
                (not check_only or has_check_interface) and
                (check_only or isinstance(prior_result, dict))):
            if isinstance(prior_result, dict):
                return prior_result, False
            return {}, False
        env = package_environment(package, ordered, release, check_only)
        env["MARGO_PACKAGE_FINGERPRINT"] = fingerprint
        if not check_only:
            env["MOSS_MARGO_CARGO_DRIVER"] = "1"
        command = [str(MOSS), "build"] + (["--release"] if release else []) + \
                  (["--check"] if check_only else []) + ["--json"]
        completed = run(command, cwd=package.root, env=env, capture=True)
        try:
            payload = json.loads(completed.stdout)["result"]
        except (json.JSONDecodeError, KeyError) as error:
            raise MargoError(f"dependency package build produced invalid Moss JSON for {package.data['name']}") from error
        test_sources = package_test_sources(package)
        if check_only and is_root_package and test_sources:
            test_check = subprocess.run(
                [str(MOSS), "test", "--check", "--json"],
                cwd=package.root, env=env, text=True,
                capture_output=True, check=False)
            if test_check.returncode != 0:
                diagnostic = test_check.stdout.strip() or test_check.stderr.strip()
                raise MargoError(
                    f"test target semantic check failed for {package.data['name']}: "
                    f"{diagnostic}")
        outputs = output_snapshot(package, release, check_only, payload)
        if check_only:
            for output in outputs:
                path = Path(output)
                if path.suffix != ".mossi":
                    continue
                embedded = execution_body_package_fingerprint(path)
                if interface_native_abi(path) in (9, 10) and embedded is None:
                    raise MargoError(
                        f"new ABI-v{interface_native_abi(path)} .mossi is missing its execution-body section: {path}")
                if embedded is not None and embedded != fingerprint:
                    raise MargoError(
                        f".mossi execution-body fingerprint mismatch for {path}: "
                        f"expected {fingerprint}, found {embedded!r}")
        state = {"format": "margo-package-state-v1", "fingerprint": fingerprint,
                 "outputs": outputs, "result": payload}
        atomic_json(state_path, state)
        return payload, True

    # Each wave contains packages whose direct providers have completed. Packages
    # in a wave write separate build roots, so they can safely use separate Moss
    # processes while preserving the dependency-first interface contract.
    artifacts_by_identity: dict[str, dict] = {}
    checked_identities: set[str] = set()
    native_checked: set[str] = set()
    native_skipped: set[str] = set()
    pending = list(ordered)
    completed: set[str] = set()
    with ThreadPoolExecutor(max_workers=jobs, thread_name_prefix="margo-package") as pool:
        while pending:
            ready = [package for package in pending
                     if all(dependency.identity in completed
                            for dependency in package.dependencies)]
            if not ready:
                raise MargoError("internal error: package graph has no buildable package")
            futures = {pool.submit(build_one, package): package for package in ready}
            failures = []
            results = {}
            for future in as_completed(futures):
                package = futures[future]
                try:
                    results[package.identity] = future.result()
                except Exception as error:
                    failures.append((package, error))
            if failures:
                package, error = sorted(failures,
                    key=lambda item: ordered.index(item[0]))[0]
                if isinstance(error, MargoError):
                    raise error
                raise MargoError(f"package build failed for {package.data['name']}: {error}") from error
            for package in ready:
                artifact, was_checked = results[package.identity]
                artifacts_by_identity[package.identity] = artifact
                if was_checked:
                    checked_identities.add(package.identity)
                completed.add(package.identity)
                pending.remove(package)
        if not check_only:
            native_checked_list, native_skipped_list = cargo_build_graph(
                root, ordered, artifacts_by_identity, release, jobs)
            native_checked.update(native_checked_list)
            native_skipped.update(native_skipped_list)
            # Cargo owns native outputs. Refresh fingerprints after it writes
            # stable provider rlibs and executable paths.
            for package in ordered:
                profile = profile_name(release)
                state_path = package.root / "build" / profile / ".margo-fingerprint.json"
                try:
                    state = json.loads(state_path.read_text(encoding="utf-8"))
                except (OSError, json.JSONDecodeError):
                    continue
                result = state.get("result")
                if isinstance(result, dict):
                    state["outputs"] = output_snapshot(package, release,
                                                        False, result)
                    atomic_json(state_path, state)
    artifacts = [artifacts_by_identity[package.identity] for package in ordered]
    checked = [package.data["name"] for package in ordered
               if package.identity in checked_identities]
    skipped = [package.data["name"] for package in ordered
               if package.identity not in checked_identities]
    native_checked_ordered = [package.data["name"] for package in ordered
                              if package.data["name"] in native_checked]
    native_skipped_ordered = [package.data["name"] for package in ordered
                              if package.data["name"] in native_skipped]
    return artifacts, checked, skipped, native_checked_ordered, native_skipped_ordered


def main() -> int:
    parser = argparse.ArgumentParser(prog="margo")
    parser.add_argument("command", choices=("build", "run", "test", "bench", "clean", "debug"))
    parser.add_argument("filter", nargs="?")
    parser.add_argument("--root", type=Path,
                        help="package root (defaults to the current directory or a parent)")
    parser.add_argument("--release", action="store_true")
    parser.add_argument("--check", action="store_true",
                        help="check package semantics and write .mossi interfaces without rustc")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--moss-json", action="store_true",
                        help=argparse.SUPPRESS)
    parser.add_argument("--trace", action="store_true")
    parser.add_argument("--interp", action="store_true")
    parser.add_argument("-j", "--jobs", type=int, default=max(1, os.cpu_count() or 1),
                        help="maximum number of independent package builds (default: CPU count)")
    args = parser.parse_args()
    try:
        if args.jobs < 1:
            raise MargoError("-j/--jobs must be at least 1")
        if args.command == "debug" and (args.filter or args.release or args.json or args.interp):
            unsupported = []
            if args.filter:
                unsupported.append(args.filter)
            if args.release:
                unsupported.append("--release")
            if args.json:
                unsupported.append("--json")
            if args.interp:
                unsupported.append("--interp")
            raise MargoError(
                "margo debug supports only 'margo debug' and 'margo debug --trace'; "
                "unsupported arguments: " + " ".join(unsupported))
        if args.check and args.command != "build":
            raise MargoError("--check is supported only by 'margo build'")
        if args.moss_json and args.command != "build":
            raise MargoError("--moss-json is supported only by 'margo build'")
        if args.command != "debug" and args.command != "test" and args.trace:
            raise MargoError("--trace is supported only by margo debug and margo test --interp")
        if args.command != "test" and args.interp:
            raise MargoError("--interp is supported only by margo test")
        if args.command == "test" and args.trace and not args.interp:
            raise MargoError("--trace with margo test requires --interp")
        if args.command == "test" and args.interp and args.release:
            raise MargoError("margo test --interp does not support --release")
        root_path = find_root(args.root if args.root is not None else Path.cwd())
        root, ordered = resolve_graph(root_path)

        if args.command == "test" and args.interp:
            # Fast Debug consumes checked dependency bodies from the same
            # package snapshots used by ordinary semantic imports. Refresh
            # dependencies first, without checking unrelated root-package
            # declarations or invoking rustc.
            dependency_order = [package for package in ordered
                                if package is not root]
            build_graph(root, dependency_order, False, args.json,
                        check_only=True, jobs=args.jobs)
            env = package_environment(root, ordered, False, check_only=True)
            test_cmd = [str(MOSS), "test", "--interp"]
            if args.filter:
                test_cmd.append(args.filter)
            if args.trace:
                test_cmd.append("--trace")
            if args.json:
                test_cmd.append("--json")
            return subprocess.run(test_cmd, cwd=root.root, env=env).returncode

        if args.command == "debug":
            # Make dependency interfaces and executable bodies current without
            # a native build. Fast Debug resolves only those .mossi artifacts;
            # the root package is checked from the selected execution entries.
            dependency_order = [package for package in ordered
                                if package is not root]
            build_graph(root, dependency_order, False, args.json,
                        check_only=True, jobs=args.jobs)
            env = package_environment(root, ordered, False, check_only=True)
            debug_cmd = [str(MOSS), "debug", str(root.root)]
            if args.trace:
                debug_cmd.append("--trace")
            return subprocess.run(debug_cmd, cwd=root.root, env=env).returncode

        if args.command == "clean":
            run([str(MOSS), "clean"] + (["--json"] if args.json else []), cwd=root.root)
            return 0
        artifacts, checked_packages, skipped_packages, native_checked, native_skipped = build_graph(
            root, ordered, args.release, args.json, args.check, args.jobs)
        if args.check:
            if args.json:
                print(json.dumps({"schema_version": "margo-1", "ok": True,
                    "root_package": root.data["name"],
                    "build_order": [p.data["name"] for p in ordered],
                    "packages": [{"name": p.data["name"], "source": p.source}
                                 for p in ordered],
                    "check_only": True,
                    "checked": checked_packages,
                    "skipped": skipped_packages}, sort_keys=True))
            else:
                print("Checked " + str(len(checked_packages)) + " package(s); " +
                      "skipped " + str(len(skipped_packages)) + " unchanged package(s)")
            return 0
        environment = package_environment(root, ordered, args.release)
        if args.command == "build":
            if args.moss_json:
                print(json.dumps({"protocol_version": 1,
                    "schema_version": "moss-agent-1", "command": "build",
                    "ok": True, "result": artifacts[-1]}, sort_keys=True))
                return 0
            if args.json:
                print(json.dumps({"schema_version": "margo-1", "ok": True,
                    "root_package": root.data["name"], "build_order": [p.data["name"] for p in ordered],
                    "packages": [{"name": p.data["name"], "source": p.source} for p in ordered],
                    "checked": checked_packages,
                    "skipped": skipped_packages,
                    "artifacts": artifacts[-1],
                    "native_checked": native_checked,
                    "native_skipped": native_skipped}, sort_keys=True))
            return 0
        if args.command == "run":
            executable = artifacts[-1]["artifacts"]["executable"]
            return subprocess.run([executable], cwd=root.root, env=environment).returncode
        command = [str(MOSS), args.command]
        if args.command == "test" and args.filter: command.append(args.filter)
        if args.command == "bench" and args.filter: command.append(args.filter)
        if args.command == "test" and args.release: command.append("--release")
        if args.json: command.append("--json")
        return subprocess.run(command, cwd=root.root, env=environment).returncode
    except MargoError as error:
        if 'args' in locals() and args.moss_json:
            detail = str(error)
            embedded = re.search(r"(\{\s*\"protocol_version\"\s*:.*\})\s*$",
                                 detail, re.DOTALL)
            if embedded:
                try:
                    print(json.dumps(json.loads(embedded.group(1)), sort_keys=True))
                    return 1
                except json.JSONDecodeError:
                    pass
            print(json.dumps({"protocol_version": 1,
                "schema_version": "moss-agent-1", "command": "build",
                "ok": False, "error": {"code": "MARGO_PACKAGE_BUILD_ERROR",
                    "severity": "error", "message": detail}}, sort_keys=True))
            return 1
        if 'args' in locals() and args.json:
            print(json.dumps({"schema_version": "margo-1", "ok": False, "error": str(error)}))
        else:
            print(f"margo: error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
