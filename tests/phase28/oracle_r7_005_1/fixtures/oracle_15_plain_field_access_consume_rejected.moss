# Spec: Proposal §10 row "b = state.frontier; archive(b) | Reject if archive consumes | Plain field access cannot implicitly empty field"
type State:
  frontier: Vector[Int]

fn archive(items: Vector[Int]):
  return items

fn main():
  s = State(frontier = [1, 2, 3])
  b = s.frontier
  kept = archive(b)
