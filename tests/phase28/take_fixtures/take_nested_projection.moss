# Nested field projections (v[i].pending, m[k].items), verifying single evaluation of projection indices.
type Task:
  id: Int
  pending: option[String]

type Group:
  tasks: Vector[Task]

type Registry:
  groups: Vector[Group]

type Counter:
  eval_count: Int

fn next_group_index(c: Counter) -> Int:
  c.eval_count = c.eval_count + 1
  return 0

fn run_nested_projection(r: Registry, c: Counter) -> Int:
  # r.groups[next_group_index(c)].tasks[0].pending must evaluate next_group_index(c) exactly once!
  let moved = take(r.groups[next_group_index(c)].tasks[0].pending)
  var score = 0
  match moved:
    case Some(s):
      score = score + 100
    case None:
      score = score + 0
  score = score + r.groups[0].tasks[0].id
  match r.groups[0].tasks[0].pending:
    case Some(s):
      score = score + 50
    case None:
      score = score + 5
  if c.eval_count == 1:
    score = score + 10
  return score

fn main():
  var g = Group(tasks: [Task(id: 7, pending: Some("deploy"))])
  var r = Registry(groups: [g])
  var c = Counter(eval_count: 0)
  let res = run_nested_projection(r, c)
  echo res
