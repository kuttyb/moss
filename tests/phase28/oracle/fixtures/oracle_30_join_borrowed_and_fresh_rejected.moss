# Spec: Proposal §10 row "if c: b = left[0] else: b = Fresh(); echo b | Reject | Borrowed element cannot promote to owned live join"
type Packet:
  val: Int

fn Fresh() -> Packet:
  return Packet(val = 99)

fn test(c: Bool, left: Vector[Packet]):
  if c:
    b = left[0]
  else:
    b = Fresh()
  echo b.val

fn main():
  pass
