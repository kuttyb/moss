type Box:
  value: Int

fn inspect(value: Box) -> Int:
  return value.value

fn forward(value: Box) -> Int:
  alias = value
  observed = inspect(alias)
  echo value.value
  return observed

fn forward_return(value: Box) -> Int:
  alias = value
  return inspect(alias)

fn main():
  echo forward(Box(value = 4))
  echo forward_return(Box(value = 5))
