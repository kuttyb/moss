# Static-DAG migration: dependencies are routes, never runtime payloads.
domain Worker
  on Ping()
    echo "ping"

domain Sink
  domainroutes(worker: Worker)
  on Accept()
    message worker.Ping()

domain Relay
  domainroutes(worker: Worker, sink: Sink)
  on Run()
    message sink.Accept()
    message worker.Ping()

proc main()
  let worker = Worker()
  let relay = Relay(worker: worker, sink: sink)
  let sink = Sink(worker: worker)
  message relay.Run()
