domain Worker
  on Ping()
    echo "ping"

domain Sink
  on Accept(worker: Worker)
    message worker.Ping()

domain Relay
  on Run(worker: Worker, sink: Sink)
    message sink.Accept(worker)
    message worker.Ping()

proc main()
  let worker = Worker()
  let relay = Relay()
  let sink = Sink()
  message relay.Run(worker, sink)
