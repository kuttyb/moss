type Alpha:
  name: String

  fn get_name() -> String:
    return copy(name)

type Beta:
  name: String

  fn get_name() -> String:
    return copy(name)

fn concrete_name(item: Alpha) -> String:
  return copy(item.name)

fn generic_name(item):
  return item.get_name()

fn main():
  echo concrete_name(Alpha(name: "A"))
  echo generic_name(Alpha(name: "A"))
  echo generic_name(Beta(name: "B"))
