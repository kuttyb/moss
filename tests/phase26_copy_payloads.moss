# Static-DAG migration: dependencies are routes, never runtime payloads.
domain Sink:
  fn Process(x: Int):
    echo "forwarded:", x

domain Router:
  domainroutes(sink: Sink)
  fn Route(x: Int):
    message sink.Process(x)

domain Calculator:
  fn PlusOne(x: Int) -> Int:
    reply x + 1

  fn LocalUpdate(x: Int) -> Int:
    y = x
    y = y + 1
    reply y

fn main():
  sink = Sink()
  router = Router(sink: sink)
  calculator = Calculator()
  message router.Route(10)
  plus_one = message calculator.PlusOne(10)
  local = message calculator.LocalUpdate(7)
  echo plus_one, local
