domain Catalog:
  title: string = "draft"

  fn Read() -> string:
    reply title

  fn Publish(next: string) -> string:
    title = "stable"
    reply title

fn main():
  catalog = spawn Catalog()
  before = message catalog.Read()
  published = message catalog.Publish("stable")
  after = message catalog.Read()
  echo before, published, after
