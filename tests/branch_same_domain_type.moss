domain Worker:
  fn Ping() -> int:
    reply 7

domain Router:
  fn Route(first: Worker, second: Worker, flag: bool) -> int:
    if flag:
      target = first
    else:
      target = second

    value = message target.Ping()
    reply value

fn main():
  first = Worker()
  second = Worker()
  router = Router()
  flag = true
  value = message router.Route(first, second, flag)
  echo value
