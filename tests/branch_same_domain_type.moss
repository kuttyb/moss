domain Worker:
  fn Ping() -> int:
    reply 7

domain Router:
  domainroutes(first: Worker, second: Worker)

  # Select a message, never alias a routing capability.
  fn Route(flag: bool) -> int:
    if flag:
      reply message first.Ping()
    else:
      reply message second.Ping()

fn main():
  first = Worker()
  second = Worker()
  router = Router(first: first, second: second)
  flag = true
  value = message router.Route(flag)
  echo value
