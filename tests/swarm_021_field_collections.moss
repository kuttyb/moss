type Box:
  items: Vector[Int]
  pending: Queue[Int]
  counts: Map[String, Int]

  fn add(value: Int) -> Int:
    items.push(value)
    items[0] = items[0]
    pending.push(value)
    counts["x"] = value
    found = counts.get("x", 0)
    names = counts.keys()
    values = counts.values()
    if names[0] == "x":
      return items.pop() + pending.pop() + counts["x"] + found + values[0] + 1
    return 0

fn main():
  holder = Box(items: [], pending: Queue(), counts: Map())
  echo holder.add(3)
