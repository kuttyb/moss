trait Measured:
  fn measure() -> Int

type First:
  value: Int
  fn measure() -> Int:
    return value

type Second:
  value: Int
  fn measure() -> Int:
    return value * 2

fn inner(item: Measured) -> Int:
  return item.measure()

fn outer(item: Measured) -> Int:
  if item.measure() < 0:
    selected = item
  else:
    selected = item
  return inner(selected)

fn outer_reversed(item: Measured) -> Int:
  if item.measure() < 0:
    selected = item
  else:
    selected = item
  return inner(selected)

fn main():
  first = First(value: 3)
  second = Second(value: 4)
  echo outer(first)
  echo outer(second)
  echo outer_reversed(Second(value: 4))
  echo outer_reversed(First(value: 3))
