fn is_positive(x: Int) -> Bool:
  return x > 0

fn filter_ints(items: Vector[Int], pred) -> Vector[Int]:
  var out = Vector[Int]()
  var i = 0
  while i < (items |> count):
    if pred(items[i]):
      out.push(items[i])
    i = i + 1
  return out

fn invoke(is_positive, value: Int) -> Bool:
  return is_positive(value)

fn main():
  nums = [1, -2, 3]
  filtered = filter_ints(nums, is_positive)
  echo filtered[0]
  echo filtered[1]
  echo invoke(is_positive, 1)
