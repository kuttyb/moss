domain Worker:
  seen = 0

  fn Record():
    seen = seen + 1

  fn Seen() -> Int:
    reply seen

fn notify(worker: Worker) -> Int:
  message worker.Record()
  return 1

proc main():
  first = Worker()
  second = Worker()
  workers = [first, second]
  pipeline_total = workers |> map(notify) |> sum
  first_seen = message first.Seen()
  second_seen = message second.Seen()
  echo pipeline_total, first_seen, second_seen
