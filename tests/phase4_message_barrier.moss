domain Worker:
  seen = 0

  fn Record(delta: Int) -> Int:
    seen = seen + 1
    reply 1

  fn Seen() -> Int:
    reply seen

domain Batch:
  domainroutes(first: Worker, second: Worker)

  fn Run():
    values = [1]
    first_total = values |> map(message first.Record(_)) |> count
    second_total = values |> map(message second.Record(_)) |> count
    first_seen = message first.Seen()
    second_seen = message second.Seen()
    echo first_total + second_total, first_seen, second_seen

proc main():
  first = Worker()
  second = Worker()
  batch = Batch(first: first, second: second)
  message batch.Run()
