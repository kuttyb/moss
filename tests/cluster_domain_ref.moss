domain Worker
  on Ping()
    echo "cluster ref: ping"

domain Registry
  on Get(worker: Worker) -> Worker
    reply worker

domain Driver
  on Run(registry: Registry, worker: Worker)
    let selected = await registry.Get(worker)
    let alias = selected
    message alias.Ping()
    message selected.Ping()

proc main()
  let worker = spawn Worker()
  let registry = spawn Registry()
  let driver = spawn Driver()
  message driver.Run(registry, worker)
