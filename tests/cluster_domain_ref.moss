domain Worker
  on Ping()
    echo "cluster ref: ping"

domain Registry
  domainroutes(worker: Worker)
  on Get()
    message worker.Ping()

domain Driver
  domainroutes(registry: Registry, worker: Worker)
  # Static-DAG migration: no returned/aliased domain capability.
  on Run()
    message registry.Get()
    message worker.Ping()

proc main()
  let worker = Worker()
  let registry = Registry(worker: worker)
  let driver = Driver(registry: registry, worker: worker)
  message driver.Run()
