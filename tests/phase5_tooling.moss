type Meter:
  value: Int

  fn doubled() -> Int:
    return value * 2

fn normalize(value: Int) -> Int:
  adjusted = value + 1
  return adjusted

fn summarize(values: Vector) -> Int:
  return values
    |> map(normalize)
    |> filter(_ > 2)
    |> sum

domain Counter:
  total = 0

  fn Add(amount: Int) -> Int:
    total = total + amount
    reply total

fn step_probe(value: Int) -> Int:
  first = value + 1
  second = first + 1
  return second

fn main():
  meter = Meter(value = 3)
  enabled = true
  label = "ready"
  values = [1, 2, 3]

  if not enabled:
    echo label

  echo meter.doubled()
  step_probe(1)
  echo summarize(values)

  counter = spawn Counter()
  result = await counter.Add(5)
  echo result
