# Static-DAG migration: dependencies are routes, never runtime payloads.
domain Target
  var total: int = 0

  on Add(amount: int) -> int
    total = total + amount
    echo "target:", total
    reply total

domain Caller
  domainroutes(target: Target)
  on Run()
    message target.Add(1)
    let value = message target.Add(2)
    echo "result:", value

proc main()
  let target = Target()
  let caller = Caller(target: target)
  message caller.Run()
