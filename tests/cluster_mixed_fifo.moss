domain Target
  var total: int = 0

  on Add(amount: int) -> int
    total = total + amount
    echo "target:", total
    reply total

domain Caller
  on Run(target: Target)
    message target.Add(1)
    let value = message target.Add(2)
    echo "result:", value

proc main()
  let target = Target()
  let caller = Caller()
  message caller.Run(target)
