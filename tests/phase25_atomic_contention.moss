domain Counter:
  value = 0

  fn Add(delta: int) -> int:
    value = value + delta
    reply value

  fn Read() -> int:
    reply value

domain Producer:
  fn Fill(counter: Counter, count: int):
    sent = 0
    while sent < count:
      observed = message counter.Add(1)
      sent = sent + 1

  fn Barrier() -> bool:
    reply true

fn main():
  counter = Counter()
  left = Producer()
  right = Producer()
  message left.Fill(counter, 1000)
  message right.Fill(counter, 1000)
  left_done = message left.Barrier()
  right_done = message right.Barrier()
  total = message counter.Read()
  echo total, left_done, right_done
