# Static-DAG migration: dependencies are routes, never runtime payloads.
domain Dependency
  on Finish() -> bool
    reply true

domain Waiting
  domainroutes(dependency: Dependency)
  on First()
    echo "start"
    let finished = message dependency.Finish()
    if finished:
      echo "finish"

  on Second()
    echo "second"

proc main()
  let dependency = Dependency()
  let waiting = Waiting(dependency: dependency)
  message waiting.First()
  message waiting.Second()
