domain Worker:
  payload

  fn Set(x):
    payload = x

  fn Run() -> int:
    reply 1

domain Coordinator:
  domainroutes(left: Worker, right: Worker)
  fn Init(x):
    ignored = x

  fn Ping():
    ignored = message left.Run()
    ignored_again = message right.Run()

fn main():
  c = Coordinator(left: w1, right: w2)
  w1 = Worker()
  w2 = Worker()
  message c.Init(1)
  message w1.Set(10)
  message w2.Set(3.5)
  message c.Ping()
  message c.Ping()
