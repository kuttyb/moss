domain A:
  value

  fn Set(x):
    value = x

  fn Run() -> int:
    reply 1

domain A__helper:
  fn Ping():
    echo 3

domain Receiver:
  domainroutes(worker: A)
  fn Send():
    ignored = message worker.Run()

type Holder:
  fn Send(value: Int):
    echo 2

fn take(value: Int):
  echo 1

fn main():
  helper = A()
  a2 = A()
  a3 = A()
  other = A__helper()
  receiver = Receiver(worker: helper)
  holder = Holder()
  message helper.Set(10)
  message a2.Set(20)
  message a3.Set(30)
  message receiver.Send()
  take(message a2.Run())
  holder.Send(message a3.Run())
