domain Worker
  on Ping()
    echo "external ref: ping"

domain Relay
  on Pass(worker: Worker)
    message worker.Ping()

domain Driver
  on Run(relay: Relay, worker: Worker)
    message relay.Pass(worker)

proc main()
  let worker = Worker()
  let relay = Relay()
  let driver = Driver()
  message driver.Run(relay, worker)
