# Static-DAG migration: dependencies are routes, never runtime payloads.
domain Worker
  on Ping()
    echo "external ref: ping"

domain Relay
  domainroutes(worker: Worker)
  on Pass()
    message worker.Ping()

domain Driver
  domainroutes(relay: Relay, worker: Worker)
  on Run()
    message relay.Pass()

proc main()
  let worker = Worker()
  let relay = Relay(worker: worker)
  let driver = Driver(relay: relay, worker: worker)
  message driver.Run()
