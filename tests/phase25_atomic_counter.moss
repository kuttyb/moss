domain Counter:
  value = 0

  fn Increment():
    value = value + 1

  fn Add(delta: int) -> int:
    value = value + delta
    reply value

  fn Subtract(delta: int) -> int:
    value = value - delta
    reply value

  fn Next() -> int:
    reply value + 1

  fn Read() -> int:
    reply value

fn main():
  counter = Counter()
  message counter.Increment()
  after_add = message counter.Add(2)
  after_subtract = message counter.Subtract(1)
  predicted = message counter.Next()
  observed = message counter.Read()
  echo after_add, after_subtract, predicted, observed
