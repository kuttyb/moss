domain Worker
  on First() -> int
    reply 1

  on Second(value: int) -> bool
    reply value == 1

domain Client
  on Run(worker: Worker)
    let first = message worker.First()
    let second = message worker.Second(first)
    echo "sequential:", second

proc main()
  let worker = Worker()
  let client = Client()
  message client.Run(worker)
