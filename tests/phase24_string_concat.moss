fn suffix(tag: String) -> String:
  return "[" + tag + "]"

fn append_part(target: String, part: String):
  target.append(part)

fn main():
  left = "moss"
  right = "🙂"
  combined = left + "-" + right
  assertEqual(combined, "moss-🙂")
  assertEqual(left, "moss")
  assertEqual(right, "🙂")

  var reused = "seed"
  reused = reused + "-" + suffix("é")
  assertEqual(reused, "seed-[é]")

  var aliased = "ab"
  aliased = aliased + aliased
  assertEqual(aliased, "abab")

  var builder = ""
  builder.reserve(64)
  append_part(builder, "Moss")
  builder.append("🙂")
  builder.reserve(-1)
  assertEqual(builder, "Moss🙂")
  echo "string concat ok"
