type Canvas:
  scale: Int

trait Drawable:
  fn area() -> Int
  fn draw(canvas: Canvas) -> Int

type Circle:
  radius: Int

  fn area():
    return radius * radius

  fn draw(canvas: Canvas):
    return radius * radius * canvas.scale

type Rectangle:
  width: Int
  height: Int

  fn area():
    return width * height

  fn draw(canvas: Canvas):
    return width * height * canvas.scale

fn render(value: Drawable, canvas):
  value.draw(canvas)

fn main():
  echo render(Circle(radius = 3), Canvas(scale = 2))
  echo render(Rectangle(width = 4, height = 5), Canvas(scale = 3))
