# Static-DAG migration: dependencies are routes, never runtime payloads.
domain Catalog:
  title: string = "stable"

  fn Read() -> string:
    reply title

domain Reader:
  domainroutes(catalog: Catalog)
  fn Run():
    count = 0
    while count < 1000:
      observed = message catalog.Read()
      count = count + 1
    echo "consistent"

fn main():
  catalog = Catalog()
  left = Reader(catalog: catalog)
  right = Reader(catalog: catalog)
  message left.Run()
  message right.Run()
