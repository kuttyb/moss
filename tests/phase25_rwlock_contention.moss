domain Catalog:
  title: string = "stable"

  fn Read() -> string:
    reply title

domain Reader:
  fn Run(catalog: Catalog):
    count = 0
    while count < 1000:
      observed = message catalog.Read()
      count = count + 1
    echo "consistent"

fn main():
  catalog = Catalog()
  left = Reader()
  right = Reader()
  message left.Run(catalog)
  message right.Run(catalog)
