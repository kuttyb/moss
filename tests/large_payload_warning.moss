# Static-DAG migration: dependencies are routes, never runtime payloads.
type Word = object
  a: int
  b: int
  c: int
  d: int
  e: int
  f: int
  g: int
  h: int

type Large = object
  a: Word
  b: Word
  c: Word
  d: Word
  e: Word
  f: Word
  g: Word
  h: Word
  i: Word
  j: Word
  k: Word
  l: Word
  m: Word
  n: Word
  o: Word
  p: Word
  q: Word

export domain Worker
  on Store(payload: Large)
    echo payload.a.a

domain Sender
  domainroutes(worker: Worker)
  var payload: Large

  on Start()
    message worker.Store(payload)

proc main()
  let worker = Worker()
  let sender = Sender(worker: worker)
  message sender.Start()
