# S1.5 unpinned empty Map: annotated domain state initialized with Map().
domain Store:
  table: Map[String, Int] = Map()

  fn Put(k: String, v: Int):
    table[k] = v

  fn Get(k: String) -> Int:
    reply table.get(k, -1)

fn main():
  s = Store()
  message s.Put("a", 1)
  echo message s.Get("a")
  echo message s.Get("b")
