# Static-DAG migration: dependencies are routes, never runtime payloads.
type Payload:
  value: Int

domain Sink:
  fn Process(payload: Payload):
    echo payload.value

domain Router:
  domainroutes(sink: Sink)
  fn Route(payload: Payload):
    message sink.Process(payload)

fn main():
  sink = Sink()
  router = Router(sink: sink)
  data = Payload(value = 11)
  message router.Route(data)
