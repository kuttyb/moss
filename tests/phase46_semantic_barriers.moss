fn observed_map(value: Int) -> Int:
  echo "map", value
  return value

fn observed_filter(value: Int) -> Bool:
  echo "filter", value
  return value > 0

fn spin(value: Int) -> Int:
  while value < 0:
    let observed = value
  return value

fn named_identity(value: Int) -> Int:
  return value

proc main():
  values = [1, 2, 3]

  effect_count = values |> map(observed_map) |> count
  divergent_count = values |> map(spin) |> count
  effect_filter_count = values |> filter(observed_filter) |> filter(_ < 3) |> count

  nonidentity_push = values |> map(_ + 1) |> filter(_ > 2) |> count
  unproven_named_push = values |> map(named_identity) |> filter(_ > 1) |> count
  effectful_push = values |> map(observed_map) |> filter(_ > 1) |> count
  effect_maps = values |> map(observed_map) |> map(named_identity) |> sum
  divergent_composed = values |> map(spin) |> map(_ + 1) |> sum

  effect_any = values |> map(observed_map) |> any(_ == 1)
  divergent_any = values |> map(spin) |> any(_ == 1)
  divergent_all = values |> map(spin) |> all(_ < 4)

  echo "results", effect_count, divergent_count, effect_filter_count, nonidentity_push, unproven_named_push, effectful_push, effect_maps, divergent_composed, effect_any, divergent_any, divergent_all
