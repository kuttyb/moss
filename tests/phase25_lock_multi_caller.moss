domain Register:
  value: string = "ready"

  fn Read() -> string:
    reply value

domain Reader:
  fn Run(register: Register):
    first = message register.Read()
    second = message register.Read()
    echo first, second

fn main():
  register = Register()
  left = Reader()
  right = Reader()
  message left.Run(register)
  message right.Run(register)
