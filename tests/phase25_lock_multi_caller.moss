# Static-DAG migration: dependencies are routes, never runtime payloads.
domain Register:
  value: string = "ready"

  fn Read() -> string:
    reply value

domain Reader:
  domainroutes(register: Register)
  fn Run():
    first = message register.Read()
    second = message register.Read()
    echo first, second

fn main():
  register = Register()
  left = Reader(register: register)
  right = Reader(register: register)
  message left.Run()
  message right.Run()
