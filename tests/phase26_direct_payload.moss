type Payload:
  value: Int

fn read_value(payload: Payload) -> Int:
  return payload.value

domain Worker:
  fn Process(payload: Payload) -> Int:
    reply read_value(payload)

fn main():
  worker = spawn Worker()
  data = Payload(value = 7)
  result = message worker.Process(data)
  data.value = 8
  echo result, data.value
