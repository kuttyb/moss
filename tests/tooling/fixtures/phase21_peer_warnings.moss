enum WorkError:
  Down

fn fail():
  raise WorkError.Down

domain Cache:
  value = 10

  fn Inflated():
    try:
      echo value
      fail()
    recover WorkError.Down:
      value = 0

  fn NoopRecover():
    try:
      value = 1
      fail()
    recover:
      pass

  fn NoopOnFail():
    value = 2
    fail()

  on_fail:
    pass

fn main():
  cache = Cache()
  message cache.Inflated()
  message cache.NoopRecover()
  message cache.NoopOnFail()
