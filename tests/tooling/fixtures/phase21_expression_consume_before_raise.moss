enum Failure:
  Bad

fn fail() -> Int:
  raise Failure.Bad

fn consume_before(data: String, number: Int) -> String:
  return data

domain Worker:
  fn Run() -> Int:
    var data = "abc"
    try:
      result = consume_before(data, fail())
    recover Failure.Bad:
      reply data.length()
    reply 0

fn main():
  worker = Worker()
  echo message worker.Run()
