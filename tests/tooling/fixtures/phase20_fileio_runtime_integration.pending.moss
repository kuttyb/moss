# Pending A+B native FileIO smoke fixture.
# Native validation must compile and execute this source against the real
# Agent B FileIO ABI, including dynamic offsets, String writes, reads, batch
# indexing, and explicit close. This fixture does not prove executor
# compensation; deterministic A+B+C compensation coverage is separate.

fn exercise(file: FileIO, offset: Int):
  file.write(offset, "data")
  data = file.read(offset, 4)
  batch = file.read([(offset, 4), (offset + 4, 4)])
  first = batch[0]
  echo data.length(), first.length()

fn main():
  file = FileIO.open("phase20-fileio-integration.tmp", create)
  exercise(file, 0)
  file.sync()
  file.close()
