enum Failure:
  Bad

fn consume_str(item: String) -> String:
  return item

domain Worker:
  fn Run(reinitialize: Bool) -> Int:
    var value = "old"
    discarded = consume_str(value)
    try:
      if reinitialize:
        value = "new"
      raise Failure.Bad
    recover Failure.Bad:
      reply value.length()
    reply 0

fn main():
  worker = Worker()
  echo message worker.Run(true)
