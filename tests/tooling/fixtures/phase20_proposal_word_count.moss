enum FileError:
  NotFound
  PermissionDenied
  NotRegularFile
  InUse
  Full
  IO

fn summarize(chunk):
  if chunk[0] == 97:
    return 1
  return 0

fn merge(a, b):
  a + b

fn measure(file: FileIO) -> Int:
  return file.chunks(2) |> map(summarize) |> reduce(0, merge)

domain Store:
  file: FileIO

  fn Open():
    file.open("tmp/phase20-proposal-domain.data", create)
    file.write(0, "a a ")

  fn Measure() -> Int:
    reply measure(file)

  fn Close():
    file.close()

fn main():
  store = Store()
  try:
    file = FileIO.open("tmp/phase20-proposal-root.data", create)
    file.write(0, "a a ")
    direct_without_executor = file.chunks(2) |> map(summarize) |> reduce(0, merge)
    executor = Executor().threads(2).start()
    direct_with_executor = file.chunks(2) |> map(summarize) |> reduce(0, merge)
    helper_outside_root = measure(file)
    message store.Open()
    helper_inside_root = message store.Measure()
    message store.Close()
    file.close()
    executor.join()
    echo direct_without_executor, direct_with_executor, helper_outside_root, helper_inside_root
  recover:
    echo "unexpected FileIO error"
    return
