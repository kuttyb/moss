enum Failure:
  Bad

type Counter:
  current: Int

  fn next() -> option[Int]:
    if current <= 0:
      return None
    value = current
    current = current - 1
    Some(value)

type Source:
  fail: Bool

  fn iter() -> Counter:
    if fail:
      raise Failure.Bad
    return Counter(current = 1)

domain Worker:
  fn Run() -> Int:
    source = Source(fail = true)
    var total = 0
    for value in source:
      total = total + value
    reply total
  on_fail Failure.Bad:
    reply 7

fn main():
  worker = Worker()
  echo message worker.Run()
