enum FileError:
  NotFound
  PermissionDenied
  NotRegularFile
  InUse
  Full
  IO

fn main():
  try:
    file = FileIO.open("tmp/phase20-range-iteration.data", create)
    file.write(0, "abc")
    data = file.read(0, 3)
    total = 0
    for byte in data:
      total = total + byte
    echo total
    file.close()
  recover:
    echo "unexpected FileIO error"
