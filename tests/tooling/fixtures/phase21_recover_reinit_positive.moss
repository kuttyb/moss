enum Failure:
  Bad

fn take(item: String) -> String:
  return item

domain Worker:
  fn Run() -> Int:
    var value = "old"
    discarded = take(value)
    try:
      value = "new"
      raise Failure.Bad
    recover Failure.Bad:
      reply value.length()
    reply 0

fn main():
  worker = Worker()
  echo message worker.Run()
