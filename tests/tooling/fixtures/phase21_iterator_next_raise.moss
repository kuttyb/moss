enum Failure:
  Bad

type Counter:
  current: Int

  fn next() -> option[Int]:
    if current == 1:
      raise Failure.Bad
    if current <= 0:
      return None
    value = current
    current = current - 1
    Some(value)

domain Worker:
  fn Run() -> Int:
    counter = Counter(current = 2)
    var total = 0
    for value in counter:
      total = total + value
    reply total
  on_fail Failure.Bad:
    reply 7

fn main():
  worker = Worker()
  echo message worker.Run()
