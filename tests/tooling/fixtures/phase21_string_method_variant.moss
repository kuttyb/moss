enum Failure:
  Bad
  Other

fn consume_string(data: String) -> String:
  return data

fn main():
  var item = "seven"
  try:
    if true:
      let discarded = consume_string(item)
      raise Failure.Bad
    else:
      raise Failure.Other
  recover Failure.Bad:
    pass
  recover Failure.Other:
    echo item.length()
