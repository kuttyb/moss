# Every call within a compound RHS must participate in the shared pre-pass.
type Request:
  offset: Int
  size: Int

fn first() -> Int:
  return 0

fn grow(reqs: Vector[Request], n: Int) -> Int:
  reqs.push(Request(offset: 0, size: n))
  return 1

fn exercise(n: Int):
  src = FileIO.open("tmp/phase20-review/input.txt", ro)
  reqs = [Request(offset: 0, size: 4)]
  for i in range(0, 2):
    batch = src.read(reqs)
    k = first() + grow(reqs, n)
  src.close()

fn main():
  exercise(40)
