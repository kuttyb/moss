enum FileError:
  NotFound
  PermissionDenied
  NotRegularFile
  InUse
  Full
  IO

# Untyped map callable whose body only indexes the chunk (the shape the
# corrective pass fixed). Sum of the first byte of each 4-byte chunk.
fn summarize(chunk):
  return chunk[0]

fn add(a: Int, b: Int) -> Int:
  return a + b

fn phase20_probe():
  file = FileIO.open("tmp/phase20-review/input.txt", ro)
  total = file.chunks(4) |> map(summarize) |> reduce(0, add)
  file.close()
  echo total

fn main():
  try:
    phase20_probe()
  recover:
    pass
