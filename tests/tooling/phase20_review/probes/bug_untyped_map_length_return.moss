enum FileError:
  NotFound
  PermissionDenied
  NotRegularFile
  InUse
  Full
  IO

# Same with an explicit return. Today: same assertion.
fn summarize(chunk):
  return chunk.length()

fn add(a: Int, b: Int) -> Int:
  return a + b

fn phase20_probe():
  file = FileIO.open("tmp/phase20-review/input.txt", ro)
  total = file.chunks(4) |> map(summarize) |> reduce(0, add)
  file.close()
  echo total

fn main():
  try:
    phase20_probe()
  recover:
    pass
