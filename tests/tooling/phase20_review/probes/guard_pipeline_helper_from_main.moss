# §13: an eligible pipeline in a helper called from main.
fn chunk_length(chunk: Range) -> Int:
  return chunk.length()

fn add(a: Int, b: Int) -> Int:
  return a + b

fn count(path: String) -> Int:
  file = FileIO.open(path, ro)
  total = file.chunks(4) |> map(chunk_length) |> reduce(0, add)
  file.close()
  return total

fn main():
  echo count("tmp/phase20-review/input.txt")
