# Typed map callable with an indexed for-range byte loop (loop is the subject).
# Today: checker assertion at moss.cpp:7867 (root cause is pre-existing; see
# pre_map_for_range_vector).
fn spaces(chunk: Range) -> Int:
  n = 0
  for i in range(0, chunk.length()):
    if chunk[i] == 32:
      n = n + 1
  return n

fn add(a: Int, b: Int) -> Int:
  return a + b

fn main():
  file = FileIO.open("tmp/phase20-review/input.txt", ro)
  total = file.chunks(4096) |> map(spaces) |> reduce(0, add)
  file.close()
  echo total
