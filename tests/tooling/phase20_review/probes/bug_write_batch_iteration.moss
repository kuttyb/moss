# Every RangeBatch iteration element inherits the maximum request size.
fn main():
  src = FileIO.open("tmp/phase20-review/input.txt", ro)
  dst = FileIO.open("tmp/phase20-review/out/batch-iteration.txt", create)
  batch = src.read([(0, 4), (4, 8)])
  off = 0
  for r in batch:
    dst.write(off, r)
    off = off + r.length()
  dst.close()
  src.close()
