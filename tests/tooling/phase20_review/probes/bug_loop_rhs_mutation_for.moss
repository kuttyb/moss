type Request:
  offset: Int
  size: Int

fn grow(reqs: Vector[Request], n: Int) -> Int:
  reqs.push(Request(offset: 0, size: n))
  return 1

fn exercise(n: Int):
  src = FileIO.open("tmp/phase20-review/input.txt", ro)
  reqs = [Request(offset: 0, size: 4)]
  k = 0
  for i in range(0, 2):
    batch = src.read(reqs)
    k = grow(reqs, n)
  src.close()

fn phase20_probe():
  exercise(40)

fn main():
  try:
    phase20_probe()
  recover:
    pass
