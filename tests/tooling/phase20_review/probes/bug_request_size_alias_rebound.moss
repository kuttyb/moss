# A request record captures its size before the local size name is rebound.
fn run(size: Int):
  src = FileIO.open("tmp/phase20-review/input.txt", ro)
  requests = [Request(offset: 0, size: size)]
  size = 4
  batch = src.read(requests)
  src.close()

type Request:
  offset: Int
  size: Int

fn phase20_probe():
  run(8)

fn main():
  try:
    phase20_probe()
  recover:
    pass
