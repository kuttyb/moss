enum FileError:
  NotFound
  PermissionDenied
  NotRegularFile
  InUse
  Full
  IO

# Write a Range that came straight from a read (byte-exact copy).
fn phase20_probe():
  src = FileIO.open("tmp/phase20-review/input.txt", ro)
  dst = FileIO.open("tmp/phase20-review/out/copy.txt", create)
  data = src.read(0, 4096)
  dst.write(0, data)
  dst.sync()
  dst.close()
  src.close()

fn main():
  try:
    phase20_probe()
  recover:
    pass
