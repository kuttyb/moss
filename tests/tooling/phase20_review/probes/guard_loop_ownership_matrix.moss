enum FileError:
  NotFound
  PermissionDenied
  NotRegularFile
  InUse
  Full
  IO

# Read traversal is READ for typed and specialized Range/Vector helpers.
fn typed_range(chunk: Range) -> Int:
  n = 0
  for byte in chunk:
    n = n + 1
  return n

fn untyped_range(chunk):
  n = 0
  for byte in chunk:
    n = n + 1
  return n

fn typed_vector(values: Vector[Int]) -> Int:
  n = 0
  for value in values:
    n = n + 1
  return n

fn untyped_vector(values):
  n = 0
  for value in values:
    n = n + 1
  return n

fn add(left: Int, right: Int) -> Int:
  return left + right

fn phase20_probe():
  nested = [[1, 2], [3]]
  a = nested |> map(typed_vector) |> sum
  b = nested |> map(untyped_vector) |> sum
  file = FileIO.open("tmp/phase20-review/input.txt", ro)
  c = file.chunks(4096) |> map(typed_range) |> reduce(0, add)
  d = file.chunks(4096) |> map(untyped_range) |> reduce(0, add)
  file.close()
  echo a + b + c + d

fn main():
  try:
    phase20_probe()
  recover:
    pass
