# Out-of-bounds RangeBatch index now fails closed (fixed), but aborts with no
# diagnostic. Range::get has the same silent abort.
fn main():
  file = FileIO.open("tmp/phase20-review/input.txt", ro)
  batch = file.read([(0, 4), (4, 4)])
  i = 5
  missing = batch[i]
  echo missing.length()
  file.close()
