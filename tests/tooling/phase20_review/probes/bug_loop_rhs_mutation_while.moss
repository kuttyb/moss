# The read precedes the write, so only loop-carried invalidation catches it.
type Request:
  offset: Int
  size: Int

fn grow(reqs: Vector[Request], n: Int) -> Int:
  reqs.push(Request(offset: 0, size: n))
  return 1

fn exercise(n: Int):
  src = FileIO.open("tmp/phase20-review/input.txt", ro)
  reqs = [Request(offset: 0, size: 4)]
  k = 0
  while k < 2:
    batch = src.read(reqs)
    k = grow(reqs, n)
  src.close()

fn main():
  exercise(40)
