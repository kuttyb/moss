# Reviewer completeness variant: a later loop shadows a bounded chunk name.
fn phase20_probe():
  src = FileIO.open("tmp/phase20-review/input.txt", ro)
  dst = FileIO.open("tmp/phase20-review/out/stale-vector.txt", create)
  for item in src.chunks(8):
    pass
  texts = ["this payload is not bounded by the chunk size"]
  for item in texts:
    dst.write(0, item)
  dst.close()
  src.close()

fn main():
  try:
    phase20_probe()
  recover:
    pass
