fn normalize(value: Int) -> Int:
  return value * 2

fn valid(value: Int) -> Bool:
  return value > 0

fn score(value: Int) -> Int:
  return value + 10

proc main():
  values = [-2, 1, 3]
  normalized = values |> map(normalize)
  result = normalized |> filter(valid) |> map(score) |> sum
  echo result
