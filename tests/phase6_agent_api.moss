type Sample:
  value: Int

  fn read() -> Int:
    return value

  fn replace(next: Int):
    value = next

fn inspect(sample: Sample) -> Int:
  return sample.read()

fn transfer(sample: Sample) -> Int:
  moved = sample
  return moved.value

fn noisy(value: Int) -> Int:
  echo "seen", value
  return value

fn wait_for(value: Int) -> Int:
  # A helper receives a result, not a runtime route.
  return value

domain Worker:
  total = 0

  fn Add(delta: Int) -> Int:
    total = total + delta
    reply total

domain Router:
  domainroutes(worker: Worker)
  fn Route() -> Int:
    value = message worker.Add(2)
    reply value

proc main():
  worker = Worker()
  router = Router(worker: worker)
  values = [1, 2, 3]
  observed_count = values |> map(noisy) |> count
  sample = Sample(value: 7)
  observed = inspect(sample)
  direct = wait_for(message worker.Add(1))
  routed = message router.Route()
  echo observed_count, observed, direct, routed

fn locally_pure_statement(value: Int) -> Int:
  local = value + 1
  echo local
  return local
