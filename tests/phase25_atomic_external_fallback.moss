domain Helper:
  value = 1

  fn Read() -> int:
    reply value

domain Audit:
  fn Note(value: int):
    echo "audit:", value

domain Counter:
  domainroutes(helper: Helper, audit: Audit)
  value = 0

  fn Work() -> int:
    amount = message helper.Read()
    value = value + amount
    message audit.Note(value)
    echo "counter:", value
    reply value

fn main():
  helper = Helper()
  audit = Audit()
  counter = Counter(helper: helper, audit: audit)
  result = message counter.Work()
  echo "result:", result
