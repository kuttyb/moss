domain Counter
  var value: int = 0

  on Add(amount: int) -> bool
    value = value + amount
    reply true

  on Value() -> int
    reply value

domain Producer
  on Fill(counter: Counter, count: int)
    var sent = 0
    while sent < count:
      let accepted = message counter.Add(1)
      if not accepted:
        return
      sent = sent + 1

  on Barrier() -> bool
    reply true

proc main()
  let counter = Counter()
  let left = Producer()
  let right = Producer()
  message left.Fill(counter, 1000)
  message right.Fill(counter, 1000)
  let left_done = message left.Barrier()
  let right_done = message right.Barrier()
  let total = message counter.Value()
  echo "shared total:", total, left_done, right_done
