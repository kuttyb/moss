type Payload = object
  value: int

type Envelope = object
  payload: Payload

domain Worker
  on Process(payload: Payload)
    echo payload.value

domain Sender
  domainroutes(worker: Worker)
  on Start(envelope: Envelope)
    message worker.Process(envelope.payload)

proc main()
  let worker = Worker()
  let sender = Sender(worker: worker)
  message sender.Start(Envelope(payload: Payload(value: 7)))
