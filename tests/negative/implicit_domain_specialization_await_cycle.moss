fn normalize(x):
  return x

domain Worker:
  payload

  fn Set(x):
    payload = normalize(x)

  fn Ping(other: Worker):
    ignored = await other.Pong()

  fn Pong() -> int:
    reply 1

fn main():
  intWorker = Worker()
  floatWorker = Worker()
  message intWorker.Set(10)
  message floatWorker.Set(3.5)
  message intWorker.Ping(floatWorker)
  message floatWorker.Ping(intWorker)
