fn wait_for_right(right: Right, left: Left):
  let result = await right.Ping(left)
  return result

domain Left
  on Start(right: Right) -> int
    let result = wait_for_right(right, self)
    reply result

  on Pong() -> int
    reply 1

domain Right
  on Ping(left: Left) -> int
    let result = await left.Pong()
    reply result

fn main():
  let left = Left()
  let right = Right()
  message left.Start(right)
