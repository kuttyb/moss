# Integration regression: a FileIO capability cannot cross into an
# independent Root as an executor.invoke argument.
domain Sink:
  fn Take(file):
    echo 1

fn main():
  sink = Sink()
  executor = Executor().start()
  try:
    file = FileIO.open("input", ro)
    executor.invoke(sink.Take(file))
    file.close()
  recover:
    pass
  executor.join()
