type Dataset = object
  size: int

domain Worker
  on Process(dataset: Dataset) -> int
    reply dataset.size

domain Store
  domainroutes(worker: Worker)
  var dataset: Dataset = Dataset(size: 3)

  on Send() -> int
    let observed = message worker.Process(dataset)
    dataset.size = 4
    reply observed * 10 + dataset.size

proc main()
  let worker = Worker()
  let store = Store(worker: worker)
  let result = message store.Send()
  echo result
