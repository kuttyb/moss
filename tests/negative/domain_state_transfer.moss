type Dataset = object
  size: int

domain Worker
  on Process(dataset: Dataset) -> int
    reply dataset.size

domain Store
  var dataset: Dataset = Dataset(size: 3)

  on Send(worker: Worker) -> int
    let observed = message worker.Process(dataset)
    dataset.size = 4
    reply observed * 10 + dataset.size

proc main()
  let worker = Worker()
  let store = Store()
  let result = message store.Send(worker)
  echo result
