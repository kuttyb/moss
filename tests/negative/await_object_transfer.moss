type Payload = object
  value: int

domain Worker
  on Inspect(payload: Payload) -> int
    reply payload.value

domain Sender
  domainroutes(worker: Worker)
  on Start()
    let payload = Payload(value: 7)
    let result = message worker.Inspect(payload)
    echo result

proc main()
  let worker = Worker()
  let sender = Sender(worker: worker)
  message sender.Start()
