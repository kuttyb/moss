# Historical positive deliberately reversed: static-DAG routes cannot be payloads/values.
domain A:
  value

  fn Set(x):
    value = x

  fn Run() -> int:
    reply 1

domain A__helper:
  fn Ping():
    echo 3

domain Receiver:
  fn Send(worker: A):
    ignored = message worker.Run()

type Holder:
  fn Send(worker: A):
    echo 2

fn take(worker: A):
  echo 1

fn main():
  helper = A()
  a2 = A()
  a3 = A()
  other = A__helper()
  receiver = Receiver()
  holder = Holder()
  message helper.Set(10)
  message a2.Set(20)
  message a3.Set(30)
  message receiver.Send(helper)
  take(a2)
  holder.Send(a3)
