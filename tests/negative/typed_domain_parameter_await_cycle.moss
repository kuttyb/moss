domain Worker:
  fn Run() -> int:
    reply 1

  fn Back(coordinator: Coordinator):
    ignored = await coordinator.Done()

domain Coordinator:
  fn Done() -> int:
    reply 1

  fn Ping(worker: Worker):
    ignored = await worker.Run()

fn main():
  c = Coordinator()
  w1 = Worker()
  w2 = Worker()
  message c.Ping(w1)
  message c.Ping(w2)
  message w2.Back(c)
