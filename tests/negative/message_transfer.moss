type Payload = object
  text: string

domain Worker
  on Process(payload: Payload)
    echo payload.text

domain Sender
  on Start(worker: Worker)
    var payload = Payload(text: "detached")
    message worker.Process(payload)
    echo payload.text

proc main()
  let worker = spawn Worker()
  let sender = spawn Sender()
  message sender.Start(worker)
