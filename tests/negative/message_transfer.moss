type Payload = object
  text: string

domain Worker
  on Process(payload: Payload)
    echo payload.text

domain Sender
  domainroutes(worker: Worker)
  on Start()
    var payload = Payload(text: "detached")
    message worker.Process(payload)
    echo payload.text

proc main()
  let worker = Worker()
  let sender = Sender(worker: worker)
  message sender.Start()
