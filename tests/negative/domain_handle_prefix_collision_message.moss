domain A:
  value

  fn Set(x):
    value = x

  fn Run() -> int:
    reply 1

domain A__helper:
  fn Run() -> int:
    reply 1

domain Receiver:
  fn Send(worker: A):
    ignored = await worker.Run()

fn main():
  helper = spawn A()
  message helper.Set(10)
  receiver = spawn Receiver()
  other = spawn A__helper()
  message receiver.Send(other)
