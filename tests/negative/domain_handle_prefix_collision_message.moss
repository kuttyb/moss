domain A:
  value

  fn Set(x):
    value = x

  fn Run() -> int:
    reply 1

domain A__helper:
  fn Run() -> int:
    reply 1

domain Receiver:
  fn Send(worker: A):
    ignored = message worker.Run()

fn main():
  helper = A()
  message helper.Set(10)
  receiver = Receiver()
  other = A__helper()
  message receiver.Send(other)
