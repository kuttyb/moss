domain Source:
  fn Value(unused: Int) -> Int:
    reply 3

domain Batch:
  domainroutes(source: Source)

  fn Run() -> Int:
    values = [0, 0]
    total = values |> map(message source.Value(_)) |> sum
    reply total

proc main():
  first = Source()
  batch = Batch(source: first)
  total = message batch.Run()
  echo total
